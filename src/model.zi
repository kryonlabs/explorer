#scope_module
Files :: #import "std/file_tree_linux";
Operations :: #import "operation_history";
WholeFiles :: #import "std/file";
DateTime :: #import "std/date_time_linux";
Calendar :: #import "std/calendar";
Env :: #import "std/environment_linux";
using Format :: #import "std/format";
Number :: #import "std/number_text";
Strings :: #import "std/c_string";
Display :: #import "file_display";
using DesktopLocations :: #import "desktop_locations";
using Bytes :: #import "std/byte_text_linux";
using TextBuffer :: #import "std/text_buffer";
using Options :: #import "std/option";

libc :: #system_library "c";
SymbolicLinkRaw :: (target: *u8, path: *u8) -> s32 #foreign libc "symlink";
MatchPattern :: (pattern: *u8, name: *u8, flags: s32) -> s32 #foreign libc "fnmatch";

#scope_export
MAX_ENTRIES :: 4096;
MAX_SELECTION :: 256;
MAX_HISTORY :: 64;
PATH_MAX :: 4096;
History :: struct {
    paths: [MAX_HISTORY][PATH_MAX]u8
    count: s32
}

// Inactive tabs own their listing and selection. History is heap-backed to
// avoid multiplying the host's stack size by the number of tabs.
TabState :: struct {
    key: u64
    history: Vec(History)
    entry_text: Vec(Text)
    entries: Vec(Entry)
    selected: Vec(bool)
    cursor: s32
    anchor: s32
    scroll: s32
    show_hidden: bool
    sort_mode: SortMode
    sort_reverse: bool
    view_mode: ViewMode
    reveal_focus: bool
    search_active: bool
    search_root_text: Text
    search_query_text: Text
}

SortMode :: enum {
    SortName :: 0
    SortSize :: 1
    SortModified :: 2
    SortType :: 3
}

ViewMode :: enum {
    ViewIcon :: 0
    ViewList :: 1
    ViewCompact :: 2
}

ClipboardMode :: enum {
    ClipboardNone :: 0
    ClipboardCopy :: 1
    ClipboardCut :: 2
}

PromptKind :: enum {
    PromptNone :: 0
    PromptRename :: 1
    PromptFolder :: 2
    PromptFile :: 3
    PromptLocation :: 4
    PromptSearch :: 5
    PromptBookmarkRename :: 6
    PromptDelete :: 7
    PromptSelectPattern :: 8
}

#scope_export
Entry :: struct {
    key: u64
    name: string
    path: string
    info: Files.PathInfo
    caption: string
    icon_serialized: string
    content_type: string
    uri: string
}

PathKey :: (path: string) -> u64 {
    key: u64 = 14695981039346656037
    for byte: path { key = (key ^ cast(u64)byte) * cast(u64)1099511628211 }
    return ifx key == cast(u64)0 then cast(u64)1 else key
}

Clipboard :: struct {
    paths: Vec(string)
    text: Vec(Text)
    mode: ClipboardMode
}

#scope_export
Manager :: struct {
    // Public strings borrow these owned bytes until the next model mutation.
    cwd_text: Text
    search_root_text: Text
    search_query_text: Text
    error_text: Text
    entry_text: Vec(Text)
    tab_text: Vec(Text)
    tab_states: Vec(TabState)
    tab_slots: Vec(s32)
    next_tab_key: u64
    operation_text: Vec(Text)
    operations: Operations.Journal
    cwd: string
    entries: Vec(Entry)
    selected: Vec(bool)
    cursor: s32
    anchor: s32
    scroll: s32
    show_hidden: bool
    search_active: bool
    search_root: string
    search_query: string
    sort_mode: SortMode
    sort_reverse: bool
    view_mode: ViewMode
    reveal_focus: bool
    tabs: Vec(string)
    active_tab: s32
    back: History
    forward: History
    clipboard: Clipboard
    prompt: PromptKind
    error: string
}

Environment :: (name: string) -> string {
    return Env.EnvironmentText(name)
}

HomePath :: () -> string {
    return Environment("HOME")
}

IsUri :: (path: string) -> bool {
    if path.count<4 || path[0]==#char "/" { return false }
    if !((path[0]>=#char "a" && path[0]<=#char "z") || (path[0]>=#char "A" && path[0]<=#char "Z")) { return false }
    for i: cast(s64)1..path.count-3 {
        if path[i:i+3]=="://" { return true }
        c:=path[i]
        if !((c>=#char "a" && c<=#char "z") || (c>=#char "A" && c<=#char "Z") || (c>=#char "0" && c<=#char "9") || c==#char "+" || c==#char "-" || c==#char ".") { return false }
    }
    return false
}
PathParent :: (path: string) -> string {
    return Files.PathParent(path)
}
NavigateUp :: (manager: *Manager) -> bool {
    if IsUri(manager.cwd) {
        parent: Text=DesktopLocations.ParentUri(manager.cwd)
        if parent.bytes.count==0 { return false }
        return OpenPathTracked(manager,TextView(parent))
    }
    return OpenPathTracked(manager,PathParent(manager.cwd))
}

DataHome :: () -> Text {
    value := Environment("XDG_DATA_HOME")
    if value != "" { return TextCopy(value) }
    home := HomePath()
    if home == "" { return .{} }
    return OperationPath(home, ".local/share")
}

TrashDirectory :: (info: bool) -> Text {
    root: Text = DataHome()
    if root.bytes.count == 0 { return .{} }
    return OperationPath(root, ifx info then "Trash/info" else "Trash/files")
}

SameText :: (left: string, right: string) -> bool {
    return left == right
}

ContainsFold :: (value: string, needle: string) -> bool {
    if needle.count == 0 { return true }
    at: s64 = 0
    while at + needle.count <= value.count {
        same := true
        index: s64 = 0
        while index < needle.count && same {
            same = LowerASCII(value[at + index]) == LowerASCII(needle[index])
            index += 1
        }
        if same { return true }
        at += 1
    }
    return false
}

TextBeforeFold :: (left: string, right: string) -> bool {
    index: s64 = 0
    while index < left.count && index < right.count {
        first := LowerASCII(left[index])
        second := LowerASCII(right[index])
        if first != second { return first < second }
        index += 1
    }
    return left.count < right.count
}

JoinText :: (first: string, second: string) -> Text {
    bytes: Vec(u8)
    Append(*bytes, first)
    Append(*bytes, second)
    return BuilderFinish(bytes)
}

LowerASCII :: (value: u8) -> u8 {
    if value >= cast(u8)65 && value <= cast(u8)90 { return value + cast(u8)32 }
    return value
}

PathReadable :: (path: string) -> bool {
    info := Files.PathStatus(path, false)
    return info.kind != .Missing
}

RenamePath :: (source: string, target: string) -> bool {
    return WholeFiles.RenameNoReplace(source, target)
}

SetError :: (manager: *Manager, message: string) {
    SetStoredText(*manager.error_text, message)
    manager.error = TextView(manager.error_text)
    if manager.error_text.bytes.count != message.count { manager.error = "Operation failed; cannot allocate error text" }
}

SetStoredText :: (owner: *Text, value: string) {
    copy: Text = TextCopy(value)
    VecSwap(owner.bytes, copy.bytes)
}

FreeNames :: (names: *Vec(string)) {
    Files.FreeDirectoryNames(names)
}

EntryBefore :: (manager: *Manager, left: *Entry, right: *Entry) -> bool {
    // Folders stay together first in either direction. Reverse the strict
    // comparison, never its boolean result (equal entries must compare false).
    if left.info.kind == .Directory && right.info.kind != .Directory { return true }
    if left.info.kind != .Directory && right.info.kind == .Directory { return false }
    if manager.sort_reverse { return EntryCompare(manager.sort_mode, right, left) < 0 }
    return EntryCompare(manager.sort_mode, left, right) < 0
}

TextCompare :: (left: string, right: string) -> s32 {
    for index: cast(s64)0..left.count - 1 {
        if index >= right.count { return 1 }
        if left[index] < right[index] { return -1 }
        if left[index] > right[index] { return 1 }
    }
    if left.count < right.count { return -1 }
    return 0
}

EntryCompare :: (mode: SortMode, left: *Entry, right: *Entry) -> s32 {
    if mode == .SortSize && left.info.size != right.info.size {
        return ifx left.info.size < right.info.size then -1 else 1
    }
    if mode == .SortModified && left.info.modified != right.info.modified {
        return ifx left.info.modified < right.info.modified then -1 else 1
    }
    if mode == .SortModified && left.info.modified_nanoseconds != right.info.modified_nanoseconds {
        return ifx left.info.modified_nanoseconds < right.info.modified_nanoseconds then -1 else 1
    }
    if mode == .SortType {
        order := TextCompare(EntryType(left), EntryType(right))
        if order != 0 { return order }
    }
    if TextBeforeFold(left.name, right.name) { return -1 }
    if TextBeforeFold(right.name, left.name) { return 1 }
    order := TextCompare(left.name, right.name)
    if order != 0 { return order }
    return TextCompare(left.path, right.path)
}

EntryType :: (entry: *Entry) -> string {
    if entry.info.kind == .Directory { return "Folder" }
    if entry.info.kind == .File { return "File" }
    if entry.info.kind == .Link { return "Symbolic link" }
    return "Other"
}

SortEntries :: (manager: *Manager) {
    if manager.entries.count < 2 { return }
    cursor_path := EntryPath(manager, manager.cursor)
    anchor_path := EntryPath(manager, manager.anchor)
    // Directory enumeration is unordered. Keep opening large directories
    // bounded by O(n log n), carrying each entry's selection with it.
    start := manager.entries.count / 2
    while start > 0 { start -= 1; SortSiftDown(manager, start, manager.entries.count) }
    end := manager.entries.count
    while end > 1 {
        end -= 1
        SwapEntries(manager, 0, end)
        SortSiftDown(manager, 0, end)
    }
    manager.cursor = -1
    manager.anchor = -1
    for index: cast(s32)0..cast(s32)manager.entries.count - 1 {
        if manager.entries[index].path == cursor_path { manager.cursor = index }
        if manager.entries[index].path == anchor_path { manager.anchor = index }
    }
    manager.reveal_focus = true
}

SwapEntries :: (manager: *Manager, first: s64, second: s64) {
    entry := manager.entries[first]; selected := manager.selected[first]
    manager.entries[first] = manager.entries[second]; manager.selected[first] = manager.selected[second]
    manager.entries[second] = entry; manager.selected[second] = selected
}
SortSiftDown :: (manager: *Manager, root: s64, end: s64) {
    parent := root
    while parent * 2 + 1 < end {
        child := parent * 2 + 1
        if child + 1 < end && EntryBefore(manager, *manager.entries[child], *manager.entries[child+1]) { child += 1 }
        if !EntryBefore(manager, *manager.entries[parent], *manager.entries[child]) { return }
        SwapEntries(manager, parent, child)
        parent = child
    }
}

SetSort :: (manager: *Manager, mode: SortMode, reverse: bool) {
    manager.sort_mode = mode
    manager.sort_reverse = reverse
    SortEntries(manager)
    manager.reveal_focus = true
}

SetView :: (manager: *Manager, mode: ViewMode) {
    if manager.view_mode == mode { return }
    manager.view_mode = mode
    manager.scroll = 0
    manager.reveal_focus = true
}

ClearEntries :: (manager: *Manager) {
    VecFree(manager.entries)
    VecFree(manager.entry_text)
    VecFree(manager.selected)
    manager.cursor = -1
    manager.anchor = -1
    manager.scroll = 0
    manager.reveal_focus = true
}

AppendEntry :: (manager: *Manager, name: string, path: string,
    info: Files.PathInfo) -> bool {
    entry: Entry
    owned_name: Text = TextCopy(name)
    owned_path: Text = TextCopy(path)
    owned_caption: Text = Display.Caption(name)
    if owned_name.bytes.count != name.count || owned_path.bytes.count != path.count ||
        (name != "" && owned_caption.bytes.count == 0) { return false }
    if !VecPush(manager.entry_text, owned_name) || !VecPush(manager.entry_text, owned_path) ||
        !VecPush(manager.entry_text, owned_caption) { return false }
    entry.name = TextView(manager.entry_text[manager.entry_text.count - 3])
    entry.path = TextView(manager.entry_text[manager.entry_text.count - 2])
    entry.caption = TextView(manager.entry_text[manager.entry_text.count - 1])
    entry.key = PathKey(entry.path)
    entry.info = info
    if !VecPush(manager.entries, entry) { return false }
    return VecPush(manager.selected, false)
}

SyncSelectionSize :: (manager: *Manager) -> bool {
    if manager.selected.count != manager.entries.count {
        if !VecResize(manager.selected, manager.entries.count) { return false }
    }
    return true
}

SelectFirst :: (manager: *Manager) {
    if !SyncSelectionSize(manager) { return }
    if manager.entries.count > 0 {
        manager.selected[0] = true
        manager.cursor = 0
        manager.anchor = 0
    }
}

RememberTab :: (manager: *Manager) {
    if manager.active_tab >= 0 && manager.active_tab < manager.tabs.count {
        slot := manager.tab_slots[manager.active_tab]
        SetStoredText(*manager.tab_text[slot], manager.cwd)
        manager.tabs[manager.active_tab] = TextView(manager.tab_text[slot])
    }
}

OpenPath :: (manager: *Manager, path: string) -> bool {
    return OpenPathChecked(manager, path)
}

AppendDesktopEntry :: (pending: *Manager, item: DesktopLocationEntry) -> bool {
    target:=ifx item.target_uri!="" then item.target_uri else item.uri
    route:=ifx item.local_path!="" then item.local_path else target
    info:=Files.PathInfo.{.kind=ifx item.is_navigable then .Directory else .File,.size=item.size,.modified=item.modified}
    if !AppendEntry(pending,item.name,route,info) { return false }
    index:=pending.entries.count-1
    icon: Text=TextCopy(item.icon_serialized); content: Text=TextCopy(item.content_type); identity: Text=TextCopy(item.uri)
    caption: Text=Display.Caption(item.caption)
    if icon.bytes.count!=item.icon_serialized.count || content.bytes.count!=item.content_type.count || identity.bytes.count!=item.uri.count || (item.caption!="" && caption.bytes.count==0) { return false }
    if !VecPush(pending.entry_text,icon) || !VecPush(pending.entry_text,content) || !VecPush(pending.entry_text,identity) || !VecPush(pending.entry_text,caption) { return false }
    pending.entries[index].key=item.key
    pending.entries[index].icon_serialized=TextView(pending.entry_text[pending.entry_text.count-4])
    pending.entries[index].content_type=TextView(pending.entry_text[pending.entry_text.count-3])
    pending.entries[index].uri=TextView(pending.entry_text[pending.entry_text.count-2])
    pending.entries[index].caption=TextView(pending.entry_text[pending.entry_text.count-1])
    return true
}

OpenDesktopPath :: (manager: *Manager, uri: string) -> bool {
    native: DesktopLocations.State
    DesktopLocations.Init(*native)
    defer DesktopLocations.Release(*native)
    if !DesktopLocations.OpenUri(*native,uri) { SetError(manager,native.error.message); return false }
    pending: Manager
    pending.cursor=-1;pending.anchor=-1;pending.show_hidden=manager.show_hidden
    pending.sort_mode=manager.sort_mode;pending.sort_reverse=manager.sort_reverse
    at: s64
    while at<native.entries.count {
        item:=native.entries[at];at+=1
        if item.is_hidden && !manager.show_hidden { continue }
        if !AppendDesktopEntry(*pending,item) { SetError(manager,"Cannot retain complete native listing");return false }
    }
    next: Text=TextCopy(native.current_uri)
    next_tab: Text=TextCopy(native.current_uri)
    if next.bytes.count!=native.current_uri.count || next_tab.bytes.count!=native.current_uri.count { SetError(manager,"Cannot retain native location"); return false }
    SortEntries(*pending)
    VecSwap(manager.cwd_text.bytes,next.bytes);manager.cwd=TextView(manager.cwd_text)
    VecSwap(manager.entry_text,pending.entry_text);VecSwap(manager.entries,pending.entries);VecSwap(manager.selected,pending.selected)
    manager.cursor=-1;manager.anchor=-1;manager.scroll=0;manager.reveal_focus=true;manager.search_active=false
    SetStoredText(*manager.search_query_text,"");manager.search_query=""
    SetStoredText(*manager.search_root_text,"");manager.search_root=""
    SelectFirst(manager);SetError(manager,"")
    if manager.active_tab>=0 && manager.active_tab<manager.tabs.count {
        slot:=manager.tab_slots[manager.active_tab]
        VecSwap(manager.tab_text[slot].bytes,next_tab.bytes);manager.tabs[manager.active_tab]=TextView(manager.tab_text[slot])
    }
    return true
}

OpenPathChecked :: (manager: *Manager, path: string, select_name: string = "",
    expected: Files.PathInfo = .{}, include_hidden: bool = false) -> bool {
    if path == "" { SetError(manager, "Enter a folder path or URI"); return false }
    if IsUri(path) {
        local: Text=DesktopLocations.PathForUri(path)
        if local.bytes.count>0 { return OpenPathChecked(manager,TextView(local),select_name,expected,include_hidden) }
        return OpenDesktopPath(manager,path)
    }
    resolved: Text = Files.ResolvePath(path)
    before := Files.PathQuery(resolved)
    if resolved.bytes.count == 0 || !before.valid || before.info.kind != .Directory || !before.info.identity_valid {
        SetError(manager, path)
        return false
    }
    cursor := Files.OpenDirectory(resolved)
    if !cursor.valid {
        SetError(manager, resolved)
        return false
    }
    open := true
    defer { if open { unused Files.CloseDirectory(*cursor) } }
    // Build a complete new listing before changing route, selection or history.
    pending: Manager
    pending.cursor = -1; pending.anchor = -1
    pending.show_hidden = manager.show_hidden || include_hidden
    pending.sort_mode = manager.sort_mode; pending.sort_reverse = manager.sort_reverse
    while true {
        item := Files.NextDirectoryEntry(*cursor)
        if !item.valid { break }
        name := TextView(item.name[:item.name_count])
        if name == "." || name == ".." || (!pending.show_hidden && name[0] == #char ".") { continue }
        full: Text = Files.JoinPath(resolved, name)
        if full.bytes.count == 0 || full.bytes.count >= PATH_MAX {
            SetError(manager, "Folder entry path cannot be represented; current location retained"); return false
        }
        query := Files.PathQuery(full)
        info := query.info
        if !query.valid {
            link := Files.PathQuery(full, false)
            if !query.missing || !link.valid || link.info.kind != .Link {
                SetError(manager, "Folder entry disappeared or is inaccessible; current location retained"); return false
            }
            info = link.info; info.kind = .Other
        }
        if !AppendEntry(*pending, name, full, info) {
            SetError(manager, "Cannot allocate complete folder listing; current location retained"); return false
        }
    }
    failed := cursor.failed
    closed := Files.CloseDirectory(*cursor); open = false
    after := Files.PathQuery(resolved)
    if failed || !closed || !after.valid || !SameDirectorySnapshot(before.info, after.info) {
        SetError(manager, "Folder changed or could not be read completely; current location retained"); return false
    }
    next_cwd: Text = TextCopy(resolved)
    if next_cwd.bytes.count != resolved.bytes.count { SetError(manager, "Cannot store location; current location retained"); return false }
    next_tab: Text
    has_tab := manager.active_tab >= 0 && manager.active_tab < manager.tabs.count
    if has_tab {
        copy: Text = TextCopy(resolved)
        if copy.bytes.count != resolved.bytes.count { SetError(manager, "Cannot store active tab; current location retained"); return false }
        VecSwap(next_tab.bytes, copy.bytes)
    }
    SortEntries(*pending)
    chosen: s32 = -1
    if select_name != "" {
        for index: cast(s32)0..cast(s32)pending.entries.count - 1 {
            if pending.entries[index].name == select_name && SamePathIdentity(pending.entries[index].info, expected) { chosen = index; break }
        }
        if chosen < 0 { SetError(manager, "Location file disappeared or changed; current location retained"); return false }
    }
    VecSwap(manager.cwd_text.bytes, next_cwd.bytes)
    manager.cwd = TextView(manager.cwd_text)
    VecSwap(manager.entry_text, pending.entry_text)
    VecSwap(manager.entries, pending.entries)
    VecSwap(manager.selected, pending.selected)
    manager.cursor = pending.cursor; manager.anchor = pending.anchor; manager.scroll = 0
    manager.show_hidden = pending.show_hidden; manager.reveal_focus = true
    manager.search_active = false
    SetStoredText(*manager.search_query_text, "")
    manager.search_query = ""
    SetStoredText(*manager.search_root_text, "")
    manager.search_root = ""
    SetError(manager, "")
    if chosen >= 0 { SelectOne(manager, chosen) }
    else { SelectFirst(manager) }
    if has_tab {
        slot := manager.tab_slots[manager.active_tab]
        VecSwap(manager.tab_text[slot].bytes, next_tab.bytes)
        manager.tabs[manager.active_tab] = TextView(manager.tab_text[slot])
    }
    return true
}

SamePathIdentity :: (left: Files.PathInfo, right: Files.PathInfo) -> bool {
    return left.identity_valid && right.identity_valid && left.kind == right.kind &&
        left.inode == right.inode && left.device_major == right.device_major && left.device_minor == right.device_minor
}

// A typed file location selects the file in its parent; it never executes it.
OpenLocationTracked :: (manager: *Manager, path: string) -> bool {
    if IsUri(path) {
        local: Text=DesktopLocations.PathForUri(path)
        if local.bytes.count>0 { return OpenLocationTracked(manager,TextView(local)) }
        return OpenPathTracked(manager,path)
    }
    query := Files.PathQuery(path)
    if !query.valid { SetError(manager, ifx query.missing then "Location does not exist" else "Location is inaccessible or cannot be represented"); return false }
    if query.info.kind == .Directory { return OpenPathTracked(manager, path) }
    if query.info.kind != .File || !query.info.identity_valid { SetError(manager, "This location is not a supported local file or folder"); return false }
    name: Text = TextCopy(Files.PathName(path))
    parent: Text = TextCopy(Files.PathParent(path))
    old: Text = TextCopy(manager.cwd)
    if name.bytes.count == 0 || parent.bytes.count == 0 || old.bytes.count != manager.cwd.count {
        SetError(manager, "Cannot prepare location navigation"); return false
    }
    if !OpenPathChecked(manager, TextView(parent), TextView(name), query.info, TextView(name)[0] == #char ".") { return false }
    if TextView(old) != manager.cwd { PushHistory(*manager.back, TextView(old)); manager.forward.count = 0 }
    return true
}

SameDirectorySnapshot :: (left: Files.PathInfo, right: Files.PathInfo) -> bool {
    return left.identity_valid && right.identity_valid && left.kind == .Directory && right.kind == .Directory &&
        left.inode == right.inode && left.device_major == right.device_major && left.device_minor == right.device_minor &&
        left.modified == right.modified && left.modified_nanoseconds == right.modified_nanoseconds &&
        left.changed == right.changed && left.changed_nanoseconds == right.changed_nanoseconds
}

PushHistory :: (history: *History, path: string) {
    if history.count >= MAX_HISTORY {
        index: s32 = 1
        while index < MAX_HISTORY {
            history.paths[index - 1] = history.paths[index]
            index += 1
        }
        history.count = MAX_HISTORY - 1
    }
    if !Strings.CopyCString(path, history.paths[history.count][:]) { return }
    history.count += 1
}

PopHistory :: (history: *History, output: []u8) -> bool {
    if history.count <= 0 { return false }
    source := history.paths[history.count - 1]
    length: s64 = 0
    while length < source.count && length < output.count && source[length] != 0 {
        output[length] = source[length]
        length += 1
    }
    if length >= output.count { return false }
    output[length] = 0
    history.count -= 1
    return true
}

OpenPathTracked :: (manager: *Manager, path: string) -> bool {
    old_buffer: [PATH_MAX]u8
    old := ""
    if Strings.CopyCString(manager.cwd, old_buffer[:]) { old = TextUntilNul(old_buffer[:]) }
    if !OpenPath(manager, path) { return false }
    if old != "" && old != manager.cwd {
        PushHistory(*manager.back, old)
        manager.forward.count = 0
    }
    return true
}

NavigateBack :: (manager: *Manager) -> bool {
    path_buffer: [PATH_MAX]u8
    if !PopHistory(*manager.back, path_buffer[:]) { return false }
    path := TextUntilNul(path_buffer[:])
    current_buffer: [PATH_MAX]u8
    current := ""
    if Strings.CopyCString(manager.cwd, current_buffer[:]) { current = TextUntilNul(current_buffer[:]) }
    if !OpenPath(manager, path) { manager.back.count += 1; return false }
    PushHistory(*manager.forward, current)
    return true
}

NavigateForward :: (manager: *Manager) -> bool {
    path_buffer: [PATH_MAX]u8
    if !PopHistory(*manager.forward, path_buffer[:]) { return false }
    path := TextUntilNul(path_buffer[:])
    current_buffer: [PATH_MAX]u8
    current := ""
    if Strings.CopyCString(manager.cwd, current_buffer[:]) { current = TextUntilNul(current_buffer[:]) }
    if !OpenPath(manager, path) { manager.forward.count += 1; return false }
    PushHistory(*manager.back, current)
    return true
}

SearchDirectory :: (manager: *Manager, directory: string, query: string,
    depth: s32) {
    if depth > 32 || manager.entries.count >= MAX_ENTRIES { return }
    names: Vec(string)
    if !Files.ListDirectory(directory, *names) { return }
    for name: names {
        if manager.entries.count >= MAX_ENTRIES { break }
        if !manager.show_hidden && name != "" && name[0] == #char "." { continue }
        path: Text = Files.JoinPath(directory, name)
        info := Files.PathStatus(path, true)
        if ContainsFold(name, query) {
            if !AppendEntry(manager, name, path, info) { break }
        }
        if info.kind == .Directory && Files.PathStatus(path, false).kind != .Link {
            SearchDirectory(manager, path, query, depth + 1)
        }
    }
    FreeNames(*names)
}

Search :: (manager: *Manager, query: string) -> bool {
    if !LocalDestination(manager) { return false }
    if query == "" { return false }
    root := ifx manager.search_active && manager.search_root != "" then manager.search_root else manager.cwd
    ClearEntries(manager)
    SearchDirectory(manager, root, query, 0)
    manager.search_active = true
    SetStoredText(*manager.search_root_text, root)
    manager.search_root = TextView(manager.search_root_text)
    SetStoredText(*manager.search_query_text, query)
    manager.search_query = TextView(manager.search_query_text)
    SetError(manager, "")
    SortEntries(manager)
    SelectFirst(manager)
    return true
}

Refresh :: (manager: *Manager) -> bool {
    if manager.search_active && manager.search_query != "" {
        return Search(manager, manager.search_query)
    }
    return OpenPath(manager, manager.cwd)
}

Init :: (manager: *Manager, start_path: string = "") {
    if manager == null { return }
    Dispose(manager)
    manager.sort_mode = .SortName
    path := ifx start_path != "" then start_path else HomePath()
    if !OpenPath(manager, path) { unused OpenPath(manager, "/") }
    unused FirstTab(manager)
}

// Exact initialization for a staged pane; unlike Init, it never falls back to /.
InitChecked :: (manager: *Manager, path: string, hidden: bool = false,
    sort: SortMode = .SortName, reverse: bool = false, view: ViewMode = .ViewIcon) -> bool {
    if manager == null || manager.tabs.count != 0 || manager.cwd != "" { return false }
    manager.show_hidden = hidden; manager.sort_mode = sort
    manager.sort_reverse = reverse; manager.view_mode = view
    if !OpenPath(manager, path) { return false }
    return FirstTab(manager)
}

FirstTab :: (manager: *Manager) -> bool {
    first_path: Text = TextCopy(manager.cwd)
    if manager.cwd == "" || first_path.bytes.count != manager.cwd.count ||
        !EnsureTabSlot(manager, 0) || !VecReserve(manager.tab_slots, 1) || !VecReserve(manager.tabs, 1) {
        SetError(manager, "Cannot allocate first tab"); return false
    }
    unused VecPush(manager.tab_slots, 0); unused VecPush(manager.tabs, "")
    VecSwap(manager.tab_text[0].bytes, first_path.bytes)
    manager.tabs[0] = TextView(manager.tab_text[0])
    manager.tab_states[0].key = cast(u64)10000
    manager.next_tab_key = cast(u64)10001
    manager.active_tab = 0
    return true
}

Dispose :: (manager: *Manager) {
    if manager == null { return }
    Operations.Close(*manager.operations)
    ClearEntries(manager)
    VecFree(manager.cwd_text.bytes)
    VecFree(manager.search_root_text.bytes)
    VecFree(manager.search_query_text.bytes)
    VecFree(manager.error_text.bytes)
    for index: cast(s32)0..cast(s32)manager.tab_states.count - 1 {
        VecFree(manager.tab_text[index].bytes)
        ReleaseTab(*manager.tab_states[index])
    }
    VecFree(manager.tab_text); VecFree(manager.tab_states); VecFree(manager.tab_slots)
    VecFree(manager.operation_text)
    manager.cwd = ""
    manager.search_root = ""
    manager.search_query = ""
    manager.error = ""
    VecFree(manager.tabs)
    VecFree(manager.clipboard.paths)
    VecFree(manager.clipboard.text)
    manager.clipboard.mode = .ClipboardNone
    manager.back.count = 0
    manager.forward.count = 0
    manager.active_tab = 0
    manager.next_tab_key = cast(u64)0
    manager.search_active = false
    manager.show_hidden = false
    manager.sort_mode = .SortName
    manager.sort_reverse = false
    manager.view_mode = .ViewList
    manager.prompt = .PromptNone
}

EnsureTabSlot :: (manager: *Manager, slot: s32) -> bool {
    if slot >= manager.tab_states.count {
        if !VecReserve(manager.tab_states, cast(s64)slot + 1) ||
            !VecReserve(manager.tab_text, cast(s64)slot + 1) { return false }
        unused VecResize(manager.tab_states, cast(s64)slot + 1)
        unused VecResize(manager.tab_text, cast(s64)slot + 1)
    }
    return VecResize(manager.tab_states[slot].history, 2)
}

ReleaseTab :: (tab: *TabState) {
    VecFree(tab.history); VecFree(tab.entry_text); VecFree(tab.entries); VecFree(tab.selected)
    VecFree(tab.search_root_text.bytes); VecFree(tab.search_query_text.bytes)
    tab.key = cast(u64)0
}

TabKey :: (manager: *Manager, index: s32) -> u64 {
    if index < 0 || index >= manager.tabs.count { return cast(u64)0 }
    return manager.tab_states[manager.tab_slots[index]].key
}

TabIndex :: (manager: *Manager, key: u64) -> s32 {
    for index: cast(s32)0..cast(s32)manager.tabs.count - 1 {
        if TabKey(manager, index) == key { return index }
    }
    return -1
}

StoreTab :: (manager: *Manager) {
    tab := *manager.tab_states[manager.tab_slots[manager.active_tab]]
    VecSwap(tab.entry_text, manager.entry_text); VecSwap(tab.entries, manager.entries)
    VecSwap(tab.selected, manager.selected)
    VecSwap(tab.search_root_text.bytes, manager.search_root_text.bytes)
    VecSwap(tab.search_query_text.bytes, manager.search_query_text.bytes)
    tab.history[0] = manager.back; tab.history[1] = manager.forward
    tab.cursor = manager.cursor; tab.anchor = manager.anchor; tab.scroll = manager.scroll
    tab.show_hidden = manager.show_hidden; tab.sort_mode = manager.sort_mode
    tab.sort_reverse = manager.sort_reverse; tab.view_mode = manager.view_mode
    tab.reveal_focus = manager.reveal_focus; tab.search_active = manager.search_active
}

CommitTab :: (manager: *Manager, pending: *Manager) {
    VecSwap(manager.cwd_text.bytes, pending.cwd_text.bytes)
    VecSwap(manager.entry_text, pending.entry_text); VecSwap(manager.entries, pending.entries)
    VecSwap(manager.selected, pending.selected)
    VecSwap(manager.search_root_text.bytes, pending.search_root_text.bytes)
    VecSwap(manager.search_query_text.bytes, pending.search_query_text.bytes)
    manager.cwd = TextView(manager.cwd_text)
    manager.search_root = TextView(manager.search_root_text)
    manager.search_query = TextView(manager.search_query_text)
    manager.back = pending.back; manager.forward = pending.forward
    manager.cursor = pending.cursor; manager.anchor = pending.anchor; manager.scroll = pending.scroll
    manager.show_hidden = pending.show_hidden; manager.sort_mode = pending.sort_mode
    manager.sort_reverse = pending.sort_reverse; manager.view_mode = pending.view_mode
    manager.reveal_focus = pending.reveal_focus; manager.search_active = pending.search_active
    SetError(manager, "")
}

RestoreTab :: (pending: *Manager, tab: *TabState) {
    if tab.search_active {
        // A search is a cached result until explicit refresh, just as before a
        // switch. The containing folder was checked completely before this.
        VecSwap(pending.entry_text, tab.entry_text); VecSwap(pending.entries, tab.entries)
        VecSwap(pending.selected, tab.selected)
        VecSwap(pending.search_root_text.bytes, tab.search_root_text.bytes)
        VecSwap(pending.search_query_text.bytes, tab.search_query_text.bytes)
        pending.cursor = tab.cursor; pending.anchor = tab.anchor
    } else {
        for index: cast(s32)0..cast(s32)pending.selected.count - 1 { pending.selected[index] = false }
        pending.cursor = -1; pending.anchor = -1
        for old: cast(s32)0..cast(s32)tab.entries.count - 1 {
            if !tab.selected[old] && old != tab.cursor && old != tab.anchor { continue }
            for index: cast(s32)0..cast(s32)pending.entries.count - 1 {
                if tab.entries[old].path == pending.entries[index].path &&
                    ((tab.entries[old].uri!="" && tab.entries[old].uri==pending.entries[index].uri) ||
                    SamePathIdentity(tab.entries[old].info, pending.entries[index].info)) {
                    pending.selected[index] = tab.selected[old]
                    if old == tab.cursor { pending.cursor = index }
                    if old == tab.anchor { pending.anchor = index }
                    break
                }
            }
        }
        if pending.cursor < 0 && pending.entries.count > 0 {
            pending.cursor = tab.cursor
            if pending.cursor < 0 { pending.cursor = 0 }
            if pending.cursor >= pending.entries.count { pending.cursor = cast(s32)pending.entries.count - 1 }
        }
        if pending.anchor < 0 { pending.anchor = pending.cursor }
    }
    pending.back = tab.history[0]; pending.forward = tab.history[1]
    pending.scroll = tab.scroll; pending.reveal_focus = tab.reveal_focus
    pending.view_mode = tab.view_mode; pending.search_active = tab.search_active
    VecFree(tab.entry_text); VecFree(tab.entries); VecFree(tab.selected)
    VecFree(tab.search_root_text.bytes); VecFree(tab.search_query_text.bytes)
}

TabReadError :: (manager: *Manager, error: string, target: string) {
    if error == target || (error.count > 0 && error[0] == #char "/") {
        SetError(manager, "Cannot read tab folder; current tab retained")
    } else { SetError(manager, error) }
}

NewTab :: (manager: *Manager, path: string = "") -> bool {
    pending: Manager
    pending.show_hidden = manager.show_hidden; pending.sort_mode = manager.sort_mode
    pending.sort_reverse = manager.sort_reverse; pending.view_mode = manager.view_mode
    target := ifx path != "" then path else manager.cwd
    if !OpenPath(*pending, target) { TabReadError(manager, pending.error, target); return false }
    next_path: Text = TextCopy(pending.cwd)
    if next_path.bytes.count != pending.cwd.count || !VecReserve(manager.tabs, manager.tabs.count + 1) ||
        !VecReserve(manager.tab_slots, manager.tabs.count + 1) {
        SetError(manager, "Cannot allocate new tab; current tab retained"); return false
    }
    slot: s32 = 0
    while slot < manager.tab_states.count && manager.tab_states[slot].key != cast(u64)0 { slot += 1 }
    if manager.next_tab_key == cast(u64)0 || !EnsureTabSlot(manager, slot) {
        SetError(manager, "Cannot allocate tab history; current tab retained"); return false
    }
    if manager.tabs.count > 0 { StoreTab(manager) }
    CommitTab(manager, *pending)
    manager.active_tab = cast(s32)manager.tabs.count
    VecSwap(manager.tab_text[slot].bytes, next_path.bytes)
    unused VecPush(manager.tab_slots, slot)
    manager.tab_states[slot].key = manager.next_tab_key; manager.next_tab_key += cast(u64)1
    unused VecPush(manager.tabs, TextView(manager.tab_text[slot]))
    return true
}

SwitchTab :: (manager: *Manager, index: s32) -> bool {
    if index < 0 || index >= manager.tabs.count { return false }
    if index == manager.active_tab { return true }
    tab := *manager.tab_states[manager.tab_slots[index]]
    pending: Manager
    pending.show_hidden = tab.show_hidden; pending.sort_mode = tab.sort_mode
    pending.sort_reverse = tab.sort_reverse; pending.view_mode = tab.view_mode
    if !OpenPath(*pending, manager.tabs[index]) { TabReadError(manager, pending.error, manager.tabs[index]); return false }
    next_path: Text = TextCopy(pending.cwd)
    if next_path.bytes.count != pending.cwd.count {
        SetError(manager, "Cannot store switched tab; current tab retained"); return false
    }
    RestoreTab(*pending, tab)
    StoreTab(manager)
    CommitTab(manager, *pending)
    slot := manager.tab_slots[index]
    VecSwap(manager.tab_text[slot].bytes, next_path.bytes)
    manager.tabs[index] = TextView(manager.tab_text[slot])
    manager.active_tab = index
    return true
}

// Refresh a pane after external/file-operation changes while restoring selection
// by raw identity. No live listing is moved until a complete read succeeds.
ReloadPreserving :: (manager: *Manager) -> bool {
    if manager.tabs.count == 0 { return false }
    pending: Manager
    pending.show_hidden = manager.show_hidden; pending.sort_mode = manager.sort_mode
    pending.sort_reverse = manager.sort_reverse; pending.view_mode = manager.view_mode
    if !OpenPath(*pending, manager.cwd) { TabReadError(manager, pending.error, manager.cwd); return false }
    StoreTab(manager)
    RestoreTab(*pending, *manager.tab_states[manager.tab_slots[manager.active_tab]])
    CommitTab(manager, *pending)
    return true
}

SyncTabViews :: (manager: *Manager) {
    for target: cast(s64)0..manager.tabs.count - 1 {
        manager.tabs[target] = TextView(manager.tab_text[manager.tab_slots[target]])
    }
}

CloseTab :: (manager: *Manager, index: s32) -> bool {
    if manager.tabs.count <= 1 || index < 0 || index >= manager.tabs.count { return false }
    if index == manager.active_tab {
        next := ifx index + 1 < manager.tabs.count then index + 1 else index - 1
        if !SwitchTab(manager, next) { return false }
    }
    active := TabKey(manager, manager.active_tab)
    slot := manager.tab_slots[index]
    ReleaseTab(*manager.tab_states[slot]); VecFree(manager.tab_text[slot].bytes)
    for source: cast(s32)index + 1..cast(s32)manager.tabs.count - 1 {
        manager.tab_slots[source - 1] = manager.tab_slots[source]
    }
    unused VecPop(manager.tabs)
    unused VecPop(manager.tab_slots)
    SyncTabViews(manager)
    manager.active_tab = TabIndex(manager, active)
    return true
}

ReorderTab :: (manager: *Manager, from: s32, to: s32) -> bool {
    if from < 0 || to < 0 || from >= manager.tabs.count || to >= manager.tabs.count { return false }
    active := TabKey(manager, manager.active_tab)
    slot := manager.tab_slots[from]
    cursor := from
    while cursor < to { manager.tab_slots[cursor] = manager.tab_slots[cursor + 1]; cursor += 1 }
    while cursor > to { manager.tab_slots[cursor] = manager.tab_slots[cursor - 1]; cursor -= 1 }
    manager.tab_slots[to] = slot
    SyncTabViews(manager); manager.active_tab = TabIndex(manager, active)
    return true
}

NextTab :: (manager: *Manager) {
    if manager.tabs.count > 1 {
        unused SwitchTab(manager, cast(s32)((manager.active_tab + 1) % manager.tabs.count))
    }
}

SelectedCount :: (manager: *Manager) -> s32 {
    count: s32
    for value: manager.selected {
        if value { count += 1 }
    }
    return count
}

FirstSelected :: (manager: *Manager) -> s32 {
    for index: cast(s32)0..manager.entries.count - 1 {
        if manager.selected[index] { return cast(s32)index }
    }
    return manager.cursor
}

EntryCount :: (manager: *Manager) -> s64 {
    return manager.entries.count
}

EntryIsDirectory :: (manager: *Manager, index: s32) -> bool {
    return index >= 0 && index < manager.entries.count &&
        manager.entries[index].info.kind == .Directory
}

EntryName :: (manager: *Manager, index: s32) -> string {
    if index < 0 || index >= manager.entries.count { return "" }
    return manager.entries[index].name
}

EntryCaption :: (manager: *Manager, index: s32) -> string {
    if index < 0 || index >= manager.entries.count { return "" }
    return manager.entries[index].caption
}

EntryPath :: (manager: *Manager, index: s32) -> string {
    if index < 0 || index >= manager.entries.count { return "" }
    return manager.entries[index].path
}

ClearSelection :: (manager: *Manager) {
    for * value: manager.selected { value.* = false }
}

SelectOne :: (manager: *Manager, index: s32) {
    ClearSelection(manager)
    if index >= 0 && index < manager.entries.count {
        manager.selected[index] = true
        manager.cursor = index
        manager.anchor = index
    }
}

SelectAll :: (manager: *Manager) {
    for * value: manager.selected { value.* = true }
    if manager.entries.count > 0 {
        manager.cursor = 0
        manager.anchor = 0
    }
}

PathPresent :: (path: string) -> bool {
    return Files.PathStatus(path, false).kind != .Missing
}

PathAvailable :: (path: string, trash_info: bool) -> bool {
    if path == "" || !Files.PathQuery(path, false).missing { return false }
    return !trash_info || Files.PathQuery(TrashInfoPath(path), false).missing
}
UniquePath :: (directory: string, name: string, trash_info: bool = false) -> Text {
    candidate: Text = OperationPath(directory, name)
    if candidate.bytes.count == 0 { return .{} }
    if PathAvailable(candidate, trash_info) { return candidate }
    stem := Files.PathStem(name)
    suffix := Files.PathSuffix(name)
    number: s32 = 2
    while number <= 100000 {
        digits: [16]u8
        builder: Vec(u8)
        if !VecReserve(builder, directory.count + name.count + 32) { return .{} }
        Append(*builder, directory); Append(*builder, "/"); Append(*builder, stem)
        BuilderPrint(*builder, " (%)", Number.FormatInteger(number, digits[:]))
        Append(*builder, suffix)
        candidate = BuilderFinish(builder)
        if candidate.bytes.count > 4095 { return .{} }
        if PathAvailable(candidate, trash_info) { return candidate }
        number += 1
    }
    return .{}
}

SelectPattern :: (manager: *Manager, pattern: string) -> bool {
    native_pattern: [4096]u8
    native_name: [4096]u8
    if !Strings.CopyCString(pattern,native_pattern[:]) { return false }
    for i: cast(s32)0..cast(s32)manager.entries.count-1 {
        manager.selected[i]=Strings.CopyCString(manager.entries[i].name,native_name[:]) && MatchPattern(*native_pattern[0],*native_name[0],0)==0
    }
    return true
}

SelectedPaths :: (manager: *Manager) -> Vec(string) {
    VecFree(manager.operation_text)
    paths: Vec(string)
    count := cast(s64)SelectedCount(manager)
    if !VecReserve(paths, count) || !VecReserve(manager.operation_text, count) {
        SetError(manager, "Cannot retain complete operation selection"); return paths
    }
    for index: cast(s32)0..manager.entries.count - 1 {
        if manager.selected[index] {
            owned: Text = TextCopy(manager.entries[index].path)
            if owned.bytes.count != manager.entries[index].path.count {
                VecFree(paths); SetError(manager, "Cannot retain complete operation selection"); return .{}
            }
            unused VecPush(manager.operation_text, owned)
            unused VecPush(paths, TextView(manager.operation_text[manager.operation_text.count - 1]))
        }
    }
    return paths
}

ValidName :: (name: string) -> bool {
    if name == "" || name == "." || name == ".." { return false }
    for byte: name { if byte == #char "/" || byte == 0 { return false } }
    return true
}

RefreshError :: (manager: *Manager, message: string) -> bool {
    saved: Text = TextCopy(message)
    unused Refresh(manager)
    SetError(manager, ifx saved.bytes.count == message.count && message.count > 0 then TextView(saved) else "Filesystem operation failed; cannot retain details")
    return false
}

LocalDestination :: (manager: *Manager) -> bool {
    if !IsUri(manager.cwd) { return true }
    SetError(manager,"This location has no local destination for file operations");return false
}
LocalSelection :: (manager: *Manager) -> bool {
    for i: cast(s32)0..manager.entries.count-1 {
        if manager.selected[i] && IsUri(manager.entries[i].path) { SetError(manager,"This item has no local path for file operations");return false }
    }
    return true
}

OperationPath :: (directory: string, name: string) -> Text {
    result: Vec(u8)
    count := directory.count + name.count + 1
    if directory == "" || directory[0] != #char "/" || name == "" || count > 4095 || !VecReserve(result, count) { return .{} }
    Append(*result, directory)
    if directory.count > 0 && directory[directory.count - 1] != #char "/" { Append(*result, "/") }
    Append(*result, name)
    return BuilderFinish(result)
}

// One user action owns one batch, even if a later item fails.
BeginOperation :: (manager: *Manager, batch: *Operations.Batch, count: s64) -> bool {
    if Operations.Begin(*manager.operations, batch, count) { return true }
    SetError(manager, "Cannot allocate filesystem operation history"); return false
}
FinishOperation :: (manager: *Manager, batch: *Operations.Batch, ok: bool, path: string = "") -> bool {
    Operations.Finish(*manager.operations, batch)
    if !ok { return RefreshError(manager, ifx path != "" then path else "Filesystem operation failed; completed items remain in history") }
    return Refresh(manager)
}
// action: move, copy, link, directory, file.
PerformOperation :: (batch: *Operations.Batch, source: string, target: string, action: s32) -> bool {
    if !Files.PathQuery(target, false).missing { return false }
    if !Operations.Prepare(batch, ifx action == 0 then source else "", target) { return false }
    ok: bool
    if action == 0 { ok = RenamePath(source, target) }
    else if action == 1 { ok = CopyPath(source, target) }
    else if action == 2 { ok = CreateSymbolicLink(source, target) }
    else if action == 3 { ok = Files.CreateDirectory(target) }
    else {
        file := WholeFiles.OpenNew(target)
        if file.valid {
            Operations.Commit(batch)
            return WholeFiles.CloseFile(file)
        }
    }
    if ok { Operations.Commit(batch) } else { Operations.Cancel(batch) }
    if !ok && action == 0 {
        origin := Files.PathQuery(source, false)
        parent := Files.PathQuery(Files.PathParent(target))
        if origin.valid && parent.valid && (origin.info.device_major != parent.info.device_major ||
            origin.info.device_minor != parent.info.device_minor) {
            // Cross-device moves retain the original on its filesystem. No
            // destructive tree removal can discard concurrent source changes.
            if batch.steps.count + 2 > Operations.MAX_STEPS || !Operations.Reserve(batch, batch.steps.count + 2) { return false }
            if !PerformOperation(batch, source, target, 1) { return false }
            return ParkOperation(batch, source)
        }
    }
    return ok
}
ParkOperation :: (batch: *Operations.Batch, path: string) -> bool {
    recovery: Text = Operations.Recovery(path)
    if recovery.bytes.count == 0 { return false }
    parked: Text = OperationPath(recovery, "payload")
    if !PerformOperation(batch, path, parked, 0) { return false }
    Operations.AdoptRecovery(batch, *recovery)
    return true
}
Undo :: (manager: *Manager) -> bool {
    ok := Operations.Undo(*manager.operations)
    if !ok { return RefreshError(manager, "Cannot undo: no action, changed identity, occupied path or inaccessible recovery payload") }
    return Refresh(manager)
}
Redo :: (manager: *Manager) -> bool {
    ok := Operations.Redo(*manager.operations)
    if !ok { return RefreshError(manager, "Cannot redo: no action, changed identity, occupied path or inaccessible recovery payload") }
    return Refresh(manager)
}

CreateFolder :: (manager: *Manager, name: string, changed: *bool = null) -> bool {
    return CreateEntry(manager, name, true, changed)
}
CreateFile :: (manager: *Manager, name: string, changed: *bool = null) -> bool {
    return CreateEntry(manager, name, false, changed)
}
CreateEntry :: (manager: *Manager, name: string, directory: bool, changed: *bool) -> bool {
    if !LocalDestination(manager) { return false }
    if !ValidName(name) { SetError(manager, "Enter a file name without slashes"); return false }
    batch: Operations.Batch
    if !BeginOperation(manager, *batch, 1) { return false }
    path: Text = OperationPath(manager.cwd, name)
    ok := PerformOperation(*batch, "", path, ifx directory then 3 else 4)
    if changed != null && batch.steps.count > 0 { changed[0] = true }
    return FinishOperation(manager, *batch, ok, path)
}
RenameSelection :: (manager: *Manager, name: string, changed: *bool = null) -> bool {
    if !LocalSelection(manager) { return false }
    if !ValidName(name) || SelectedCount(manager) != 1 { return false }
    index := FirstSelected(manager)
    if index < 0 { return false }
    // Accept an unchanged byte name without touching the filesystem or history.
    if EntryName(manager,index)==name { SetError(manager,""); return true }
    batch: Operations.Batch
    if !BeginOperation(manager, *batch, 1) { return false }
    target: Text = OperationPath(Files.PathParent(manager.entries[index].path), name)
    ok := PerformOperation(*batch, manager.entries[index].path, target, 0)
    if changed != null && ok { changed[0] = true }
    return FinishOperation(manager, *batch, ok, target)
}

EscapeTrashPath :: (path: string) -> Text {
    builder: Vec(u8)
    if !VecReserve(builder, path.count * 3) { return .{} }
    index: s64 = 0
    while index < path.count {
        byte := path[index]
        if byte <= #char " " || byte >= cast(u8)127 || byte == #char "%" ||
            byte == #char "?" || byte == #char "#" || byte == #char "[" || byte == #char "]" {
            digits := "0123456789ABCDEF"
            unused VecPush(builder, #char "%")
            unused VecPush(builder, digits[cast(s32)byte / 16])
            unused VecPush(builder, digits[cast(s32)byte % 16])
        } else {
            Append(*builder, path[index:index + 1])
        }
        index += 1
    }
    return BuilderFinish(builder)
}

UnescapeTrashPath :: (path: string) -> Text {
    builder: Vec(u8)
    index: s64 = 0
    while index < path.count {
        if path[index] != #char "%" {
            if !VecPush(builder, path[index]) { break }
            index += 1
            continue
        }
        if index + 2 >= path.count { VecFree(builder); return .{} }
        high := HexValue(path[index + 1])
        low := HexValue(path[index + 2])
        if high < 0 || low < 0 { VecFree(builder); return .{} }
        if !VecPush(builder, cast(u8)(high * 16 + low)) { break }
        index += 3
    }
    return BuilderFinish(builder)
}

HexValue :: (value: u8) -> s32 {
    if value >= #char "0" && value <= #char "9" { return cast(s32)value - cast(s32)#char "0" }
    if value >= #char "a" && value <= #char "f" { return cast(s32)value - cast(s32)#char "a" + 10 }
    if value >= #char "A" && value <= #char "F" { return cast(s32)value - cast(s32)#char "A" + 10 }
    return -1
}

TrashInfoPath :: (trashed_path: string) -> Text {
    if trashed_path == "" { return .{} }
    name: Text = JoinText(Files.PathName(trashed_path), ".trashinfo")
    if name.bytes.count != Files.PathName(trashed_path).count + 10 { return .{} }
    return OperationPath(TrashDirectory(true), name)
}

TrashOriginalPath :: (info_path: string) -> Text {
    status := Files.PathQuery(info_path, false)
    if !status.valid || status.info.kind != .File || status.info.size <= 0 || status.info.size > 16384 { return .{} }
    bytes: Vec(u8)
    if !WholeFiles.ReadFileInto(info_path, *bytes) { return .{} }
    text := TextView(bytes[:bytes.count])
    start: s64 = 0
    while start <= text.count {
        end := start
        while end < text.count && text[end] != #char "\n" { end += 1 }
        line := text[start:end]
        if line.count > 5 && line[0:5] == "Path=" {
            result: Text = UnescapeTrashPath(line[5:])
            VecFree(bytes)
            return result
        }
        if end >= text.count { break }
        start = end + 1
    }
    VecFree(bytes)
    return .{}
}

TrashOne :: (path: string) -> bool {
    batch: Operations.Batch
    if !Operations.Reserve(*batch, 2) { return false }
    ok := TrashRecorded(*batch, path)
    Operations.Discard(*batch)
    return ok
}

// Metadata is created exclusively and journaled independently. A later failure
// retains every successful step, including payloads and Trash metadata.
TrashRecorded :: (batch: *Operations.Batch, path: string) -> bool {
    files: Text = TrashDirectory(false)
    info: Text = TrashDirectory(true)
    if files.bytes.count == 0 || info.bytes.count == 0 ||
        !Files.CreateDirectories(files) || !Files.CreateDirectories(info) { return false }
    trashed: Text = UniquePath(files, Files.PathName(path), true)
    if trashed.bytes.count == 0 { return false }
    info_path: Text = TrashInfoPath(trashed)
    if info_path.bytes.count == 0 { return false }
    stamp_buffer: [32]u8
    stamp := Calendar.FormatDateTime(DateTime.LocalNow(), "%Y-%m-%dT%H:%M:%S", stamp_buffer[:])
    if stamp == "" || !Operations.Prepare(batch, "", info_path) { return false }
    body: Vec(u8)
    escaped: Text = EscapeTrashPath(path)
    if escaped.bytes.count == 0 || !VecReserve(body, escaped.bytes.count + stamp.count + 64) { Operations.Cancel(batch); return false }
    BuilderPrint(*body, "[Trash Info]\nPath=%\nDeletionDate=%\n", TextView(escaped), stamp)
    file := WholeFiles.OpenNew(info_path)
    if !file.valid { Operations.Cancel(batch); return false }
    written := WholeFiles.Write(file, body[:body.count]) == body.count
    closed := WholeFiles.CloseFile(file)
    Operations.Commit(batch)
    if !written || !closed { return false }
    return PerformOperation(batch, path, trashed, 0)
}
DeleteSelection :: (manager: *Manager, use_trash: bool) -> bool {
    if !LocalSelection(manager) { return false }
    paths := SelectedPaths(manager)
    if paths.count == 0 { return false }
    batch: Operations.Batch
    if use_trash && !BeginOperation(manager, *batch, paths.count * 2) { return false }
    // An irreversible delete is a history barrier. In particular a previous
    // cross-device move must not resurrect its retained source on partial undo.
    if !use_trash { Operations.Close(*manager.operations) }
    for path: paths {
        ok := ifx use_trash then TrashRecorded(*batch, path) else Files.RemoveTree(path)
        if !ok { return FinishOperation(manager, *batch, false, path) }
    }
    // Permanent deletion has no fabricated inverse.
    return FinishOperation(manager, *batch, true)
}
RestoreSelection :: (manager: *Manager) -> bool {
    if !LocalSelection(manager) { return false }
    paths := SelectedPaths(manager)
    if paths.count == 0 { return false }
    batch: Operations.Batch
    if !BeginOperation(manager, *batch, paths.count * 2) { return false }
    for path: paths {
        info_path: Text = TrashInfoPath(path)
        original: Text = TrashOriginalPath(info_path)
        parent := Files.PathParent(original)
        trash: Text = TrashDirectory(false)
        if original.bytes.count == 0 || TextView(original)[0] != #char "/" ||
            Files.PathParent(path) != TextView(trash) || parent == "" || !Files.CreateDirectories(parent) {
            return FinishOperation(manager, *batch, false, path)
        }
        target: Text = UniquePath(parent, Files.PathName(original))
        if !PerformOperation(*batch, path, target, 0) { return FinishOperation(manager, *batch, false, path) }
        // Retain metadata rather than deleting it, so restore itself can undo.
        if !ParkOperation(*batch, info_path) { return FinishOperation(manager, *batch, false, info_path) }
    }
    return FinishOperation(manager, *batch, true)
}

SnapshotSelection :: (manager: *Manager, cut: bool, clipboard: *Clipboard) -> bool {
    if !LocalSelection(manager) { return false }
    // Clipboard snapshots include the whole selection. The bounded operation
    // helper is for other actions; never publish a silently truncated list.
    pending: Clipboard
    for index: cast(s32)0..manager.entries.count - 1 {
        if !manager.selected[index] { continue }
        path := manager.entries[index].path
        owned: Text = TextCopy(path)
        if owned.bytes.count != path.count {
            SetError(manager, "Cannot retain the complete file selection"); return false
        }
        if !VecPush(pending.text, owned) {
            SetError(manager, "Cannot retain the complete file selection"); return false
        }
        view := TextView(pending.text[pending.text.count - 1])
        if !VecPush(pending.paths, view) {
            SetError(manager, "Cannot retain the complete file selection"); return false
        }
    }
    if pending.paths.count == 0 { return false }
    VecSwap(clipboard.paths, pending.paths)
    VecSwap(clipboard.text, pending.text)
    clipboard.mode = ifx cut then .ClipboardCut else .ClipboardCopy
    return true
}

CopySelection :: (manager: *Manager, cut: bool) -> bool {
    return SnapshotSelection(manager, cut, *manager.clipboard)
}

IsWithin :: (directory: string, ancestor: string) -> bool {
    if directory == ancestor { return true }
    if ancestor == "/" { return true }
    return directory.count > ancestor.count && directory[0:ancestor.count] == ancestor &&
        directory[ancestor.count] == #char "/"
}

CopyPath :: (source: string, target: string) -> bool {
    kind := Files.PathStatus(source, false).kind
    if kind == .Link { return Files.CopySymbolicLink(source, target) }
    if kind == .Directory {
        parent: Text = Files.ResolvePath(Files.PathParent(target))
        origin: Text = Files.ResolvePath(source)
        if parent.bytes.count == 0 || origin.bytes.count == 0 || IsWithin(parent, origin) { return false }
        return Files.CopyTreeNew(source, target)
    }
    if kind != .File { return false }
    return Files.CopyFileNew(source, target)
}

Paste :: (manager: *Manager) -> bool {
    return PasteClipboard(manager, *manager.clipboard)
}

PasteClipboard :: (manager: *Manager, clipboard: *Clipboard, changed: *u64 = null) -> bool {
    if !LocalDestination(manager) || clipboard.paths.count == 0 { return false }
    batch: Operations.Batch
    if !BeginOperation(manager, *batch, clipboard.paths.count) { return false }
    ok := true
    completed: s64 = 0
    failed_path := ""
    for path: clipboard.paths {
        target: Text = UniquePath(manager.cwd, Files.PathName(path))
        if !PerformOperation(*batch, path, target, ifx clipboard.mode == .ClipboardCut then 0 else 1) {
            failed_path = path; ok = false; break
        }
        completed += 1
        if changed != null { changed[0] += cast(u64)1 }
    }
    if clipboard.mode == .ClipboardCut {
        for index: completed..clipboard.paths.count - 1 { clipboard.paths[index - completed] = clipboard.paths[index] }
        unused VecResize(clipboard.paths, clipboard.paths.count - completed)
        if clipboard.paths.count == 0 { clipboard.mode = .ClipboardNone }
    }
    return FinishOperation(manager, *batch, ok, failed_path)
}
DuplicateSelection :: (manager: *Manager) -> bool { return CopyOrLinkSelection(manager, false) }
MakeLinkSelection :: (manager: *Manager) -> bool { return CopyOrLinkSelection(manager, true) }
CopyOrLinkSelection :: (manager: *Manager, link: bool) -> bool {
    if !LocalSelection(manager) { return false }
    paths := SelectedPaths(manager)
    if paths.count == 0 { return false }
    batch: Operations.Batch
    if !BeginOperation(manager, *batch, paths.count) { return false }
    for path: paths {
        name: Text = JoinText(Files.PathName(path), ifx link then " link" else "")
        if name.bytes.count != Files.PathName(path).count + (ifx link then 5 else 0) { return FinishOperation(manager, *batch, false, path) }
        target: Text = UniquePath(Files.PathParent(path), name)
        if !PerformOperation(*batch, path, target, ifx link then 2 else 1) {
            return FinishOperation(manager, *batch, false, path)
        }
    }
    return FinishOperation(manager, *batch, true)
}

CreateSymbolicLink :: (target: string, path: string) -> bool {
    target_bytes: [4096]u8
    path_bytes: [4096]u8
    if !Strings.CopyCString(target, target_bytes[:]) ||
        !Strings.CopyCString(path, path_bytes[:]) { return false }
    return SymbolicLinkRaw(*target_bytes[0], *path_bytes[0]) == 0
}
