#scope_module
Model :: #import "model";
Files :: #import "file_clipboard";
Native :: #import "kryon/MimeClipboardLinux";

#scope_export
State :: struct {
    clipboard: Model.Clipboard
    changed: u64
    owned: u64
    cut_owner: u64
    cut_payload: Text
    cut_mime: string
}

ForgetCut :: (state: *State) {
    state.cut_owner = 0
    state.cut_mime = ""
    VecFree(state.cut_payload.bytes)
}

Close :: (state: *State) {
    if state.owned != 0 { unused Native.MimeClipboardRelease(state.owned) }
    state.owned = 0
    VecFree(state.clipboard.paths); VecFree(state.clipboard.text)
    state.clipboard.mode = .ClipboardNone
    ForgetCut(state)
}

Poll :: () { unused Native.MimeClipboardPump(32) }

Copy :: (state: *State, manager: *Model.Manager, cut: bool) -> bool {
    pending: Model.Clipboard
    if !Model.SnapshotSelection(manager, cut, *pending) { return false }
    return Publish(state, manager, *pending)
}

// Copy or cut explicit locations, such as a side-pane folder.
CopyPaths :: (state: *State, manager: *Model.Manager, paths: []string, cut: bool) -> bool {
    pending: Model.Clipboard
    for path: paths {
        if Model.IsUri(path) { Model.SetError(manager, "This item has no local path for file operations"); return false }
        owned: Text = TextCopy(path)
        complete := owned.bytes.count == path.count
        if !complete || !VecPush(pending.text, owned) {
            Model.SetError(manager, "Cannot retain the complete file selection"); return false
        }
        if !VecPush(pending.paths, TextView(pending.text[pending.text.count - 1])) {
            Model.SetError(manager, "Cannot retain the complete file selection"); return false
        }
    }
    if pending.paths.count == 0 { return false }
    pending.mode = ifx cut then Model.ClipboardMode.ClipboardCut else Model.ClipboardMode.ClipboardCopy
    return Publish(state, manager, *pending)
}

// Thunar enables Paste when the clipboard owner offers GNOME file targets.
CanPaste :: (state: *State) -> bool {
    if !Native.MimeClipboardOpen() { return state.clipboard.mode != .ClipboardNone && state.clipboard.paths.count > 0 }
    buffer: [512]u8
    result := Native.MimeClipboardRead(Files.GNOME_FILES, buffer[:], 300)
    return result.status == .Ok || result.status == .TooLarge
}

Publish :: (state: *State, manager: *Model.Manager, pending: *Model.Clipboard) -> bool {
    available := Native.MimeClipboardOpen()
    if available {
        uris: Text = Files.Encode(pending, Files.URI_LIST)
        gnome: Text = Files.Encode(pending, Files.GNOME_FILES)
        if uris.bytes.count == 0 || gnome.bytes.count == 0 {
            Model.SetError(manager, "File selection cannot be represented on the desktop clipboard")
            return false
        }
        payloads := Native.MimeClipboardPayload.[
            .{.mime = Files.URI_LIST, .bytes = uris.bytes[:uris.bytes.count]},
            .{.mime = Files.GNOME_FILES, .bytes = gnome.bytes[:gnome.bytes.count]}]
        result := Native.MimeClipboardPublish(payloads[:])
        if result.status != .Ok {
            Model.SetError(manager, "Desktop clipboard publication failed; internal selection retained")
            return false
        }
        state.owned = result.owner
    }
    VecSwap(state.clipboard.paths, pending.paths)
    VecSwap(state.clipboard.text, pending.text)
    state.clipboard.mode = pending.mode
    ForgetCut(state)
    return true
}

Paste :: (state: *State, manager: *Model.Manager, directory: string = "") -> bool {
    if !Native.MimeClipboardOpen() { return Model.PasteClipboard(manager, *state.clipboard, *state.changed, directory) }
    buffer: Vec(u8)
    if !VecResize(buffer, Files.MAX_PAYLOAD) {
        Model.SetError(manager, "Cannot allocate desktop file clipboard buffer"); return false
    }
    mime := Files.GNOME_FILES
    result := Native.MimeClipboardRead(mime, buffer[:buffer.count], 1000)
    if result.status == .Absent {
        mime = Files.URI_LIST
        result = Native.MimeClipboardRead(mime, buffer[:buffer.count], 1000)
    }
    if result.status == .Absent {
        Model.SetError(manager, "Desktop clipboard contains no files"); return false
    }
    if result.status != .Ok || result.owner == 0 || result.owner != Native.MimeClipboardOwner() {
        Model.SetError(manager, "Desktop file clipboard could not be read completely"); return false
    }
    payload := TextView(result.bytes)
    repeated_cut := state.cut_owner == result.owner && state.cut_mime == mime &&
        TextView(state.cut_payload) == payload
    if !repeated_cut {
        if !Files.Parse(*state.clipboard, mime, payload) {
            Model.SetError(manager, "Desktop file clipboard is empty, invalid or contains unsupported URIs")
            return false
        }
        ForgetCut(state)
        if state.clipboard.mode == .ClipboardCut {
            remembered: Text = TextCopy(payload)
            if remembered.bytes.count != payload.count {
                Model.SetError(manager, "Cannot retain desktop cut selection"); return false
            }
            VecSwap(state.cut_payload.bytes, remembered.bytes)
            state.cut_owner = result.owner
            state.cut_mime = mime
        }
    }
    if repeated_cut && state.clipboard.paths.count == 0 {
        Model.SetError(manager, "This cut selection has already been pasted"); return false
    }
    cut := state.clipboard.mode == .ClipboardCut
    ok := Model.PasteClipboard(manager, *state.clipboard, *state.changed, directory)
    if cut && state.clipboard.paths.count == 0 && state.owned == result.owner {
        unused Native.MimeClipboardRelease(state.owned)
        state.owned = 0
    }
    return ok
}
