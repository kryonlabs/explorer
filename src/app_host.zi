}

PaneManager :: (host: *Host, index: s32 = -1) -> *Model.Manager {
    if index < 0 { index = host.active_pane }
    if index == 1 && host.secondary.count == 1 { return *host.secondary[0].manager }
    return *host.manager
}

ActiveManager :: (host: *Host) -> *Model.Manager { return PaneManager(host) }

PaneViewAt :: (host: *Host, index: s32 = -1) -> *PaneView {
    if index < 0 { index = host.active_pane }
    if index == 1 && host.secondary.count == 1 { return *host.secondary[0].view }
    return *host.view
}

ActiveView :: (host: *Host) -> *PaneView { return PaneViewAt(host) }

InitPaneView :: (view: *PaneView) {
    view.zoom=s32.[3,3,3]
    view.column_widths = s32.[50, 50, 50, 50]
    view.columns_resized=false
    view.columns_signature=0; view.columns_generation=0
    view.name_minimum=50
    view.tab_drag_from = -1
}

ReleasePaneView :: (view: *PaneView) {
    if view.native_scroll!=0 { unused NativeScroll.GtkScrollRelease(view.native_scroll); view.native_scroll=0 }
    for index: cast(s32)0..cast(s32)view.tab_labels.count - 1 {
        VecFree(view.tab_labels[index].bytes); VecFree(view.tab_paths[index].bytes)
    }
    VecFree(view.tab_labels); VecFree(view.tab_paths); VecFree(view.tab_keys); VecFree(view.tab_items)
    LocalTree.Release(*view.directory_tree)
    VecFree(view.tree_items); VecFree(view.tree_rows); VecFree(view.tree_attempt.bytes)
    VecFree(view.last_click_path.bytes); VecFree(view.details_cells)
    VecFree(view.column_values)
    VecFree(view.details_rows); VecFree(view.grid_items)
    view.tree_mode = false; view.tree_initialized = false; view.tree_focused = false
    view.tree_reveal = false; view.tree_scroll = 0; view.tree_press = 0
    view.tree_horizontal = 0; view.tree_horizontal_max = 0
    view.tab_scroll = 0; view.tab_dragging = false; view.tab_drag_from = -1; view.tab_active_key = 0
    view.last_click_ms = 0
}

CaptureModalOwner :: (host: *Host, prompt: Model.PromptKind = .PromptNone) -> bool {
    manager := ActiveManager(host)
    route: Text = TextCopy(manager.cwd)
    target: Text
    identity: TabPaths.PathInfo
    if route.bytes.count != manager.cwd.count {
        Model.SetError(manager, "Cannot retain editor owner"); return false
    }
    if prompt == .PromptRename && Model.SelectedCount(manager) == 1 {
        index := Model.FirstSelected(manager)
        path := Model.EntryPath(manager, index)
        next_target: Text = TextCopy(path)
        VecSwap(target.bytes, next_target.bytes)
        if target.bytes.count != path.count { Model.SetError(manager, "Cannot retain rename owner"); return false }
        identity = manager.entries[index].info
    }
    VecSwap(host.modal_path.bytes, route.bytes); VecSwap(host.modal_target.bytes, target.bytes)
    host.modal_identity = identity
    host.modal_pane = host.active_pane; host.modal_tab = Model.TabKey(manager, manager.active_tab)
    return true
}

ModalOwnerValid :: (host: *Host) -> bool {
    manager := ActiveManager(host)
    if host.modal_pane != host.active_pane || host.modal_tab != Model.TabKey(manager, manager.active_tab) ||
        TextView(host.modal_path) != manager.cwd { return false }
    if manager.prompt == .PromptRename && host.rename_path.bytes.count > 0 { return TabPaths.PathQuery(TextView(host.rename_path), false).valid }
    if manager.prompt == .PromptRename {
        if Model.SelectedCount(manager) != 1 { return false }
        index := Model.FirstSelected(manager)
        if Model.EntryPath(manager, index) != TextView(host.modal_target) { return false }
        actual := TabPaths.PathQuery(TextView(host.modal_target))
        if !actual.valid || !Model.SamePathIdentity(host.modal_identity, actual.info) { return false }
    }
    return true
}

CancelStaleModal :: (host: *Host) {
    if host.modal_pane == 0 || (host.modal_pane == 1 && host.secondary.count == 1) {
        PaneManager(host, host.modal_pane).prompt = .PromptNone
    }
    ActiveManager(host).prompt = .PromptNone
    host.field.length = 0; host.field.focused = false; host.escaped_editor = false
    Location.Release(*host.location); host.completion_scroll = 0
    Preview.Close(*host.preview)
    Model.SetError(ActiveManager(host), "Editor or preview owner changed; action canceled")
}

CapturePopupOwner :: (host: *Host) {
    manager := ActiveManager(host)
    path: Text = TextCopy(manager.cwd)
    host.popup_tab = 0
    if path.bytes.count != manager.cwd.count {
        Model.SetError(manager, "Cannot retain menu owner"); return
    }
    VecSwap(host.popup_path.bytes, path.bytes)
    host.popup_pane = host.active_pane; host.popup_tab = Model.TabKey(manager, manager.active_tab)
}

PopupOwnerValid :: (host: *Host) -> bool {
    manager := ActiveManager(host)
    return host.popup_pane == host.active_pane && host.popup_tab != 0 &&
        host.popup_tab == Model.TabKey(manager, manager.active_tab) && TextView(host.popup_path) == manager.cwd
}

PaneLocked :: (host: *Host) -> bool {
    return ActiveManager(host).prompt != .PromptNone || host.preview.opened || host.info_open ||
        host.breadcrumb_open || host.actions_open || host.context_view.open || host.chooser_open
}

ActivatePane :: (host: *Host, index: s32) -> bool {
    if !host.started || index < 0 || index > 1 || (index == 1 && host.secondary.count != 1) { return false }
    if index == host.active_pane { return true }
    if !host.split || PaneLocked(host) { return false }
    host.active_pane = index
    host.field.bytes = host.field_next[:]
    host.field.focused = false
    host.field.length = 0; host.field.cursor = 0; host.field.anchor = 0; host.field.scroll_x = 0
    ActiveView(host).last_click_ms = 0
    return true
}

RequestPane :: (host: *Host, target: s32) {
    if !host.split || PaneLocked(host) { return }
    manager := ActiveManager(host)
    host.next_pane = target; host.command_pane = host.active_pane
    host.command_tab = Model.TabKey(manager, manager.active_tab)
}

ApplyPaneRequest :: (host: *Host) {
    target := host.next_pane; host.next_pane = -1
    if target < 0 || host.command_pane != host.active_pane { return }
    manager := ActiveManager(host)
    if Model.TabKey(manager, manager.active_tab) == host.command_tab { unused ActivatePane(host, target) }
}

EnableSplit :: (host: *Host) -> bool {
    if host == null || !host.started || PaneLocked(host) { return false }
    if host.split { return true }
    manager := ActiveManager(host)
    if host.secondary.count == 0 {
        // Allocate the stable owner first, then initialize it in place. Never
        // publish a split or copy an owning Manager while fallible work remains.
        if !VecResize(host.secondary, 1) {
            Model.SetError(manager, "Cannot allocate split pane; current pane retained"); return false
        }
        next := *host.secondary[0]
        if !Model.InitChecked(*next.manager, manager.cwd, manager.show_hidden,
            manager.sort_mode, manager.sort_reverse, manager.view_mode) {
            Model.SetError(manager, "Cannot read split folder or allocate pane; current pane retained")
            Model.Dispose(*next.manager); VecFree(host.secondary); return false
        }
        InitPaneView(*next.view)
    } else {
        other := PaneManager(host, 1 - host.active_pane)
        if !Model.ReloadPreserving(other) {
            Model.SetError(manager, "Cannot refresh retained split pane; current pane retained"); return false
        }
    }
    host.split = true
    return true
}

ToggleSplit :: (host: *Host) -> bool {
    if !host.started || PaneLocked(host) { return false }
    if !host.split { return EnableSplit(host) }
    host.split = false
    ActiveView(host).tab_dragging = false
    return true
}

// Resolve physical pane scope from the previous committed tree, before taking
// application input. Host scope is checked so another embedded Host cannot win.
FocusInCurrentScope :: (session: Session, index: s32) -> bool {
    parent := TreeCurrentParent(session)
    if parent < 0 { return false }
    generation := TreeSubmittedNodeAt(session, parent).identity_generation
    while index >= 0 {
        node := TreeNodeAt(session, index)
        if node.identity_generation == generation { return true }
        index = node.parent
    }
    return false
}

NodePane :: (session: Session, index: s32, root: s32) -> s32 {
    pane: s32 = -1
    while index >= 0 {
        node := TreeNodeAt(session, index)
        if node.key == cast(u64)550 { pane = 0 }
        if node.key == cast(u64)551 { pane = 1 }
        if index == root { return pane }
        index = node.parent
    }
    return -1
}

ResolvePaneInput :: (host: *Host, session: Session, viewport: Rectangle, focused: bool) {
    if !focused || !host.split || PaneLocked(host) { return }
    // The native retained focus route already processed a pointer press or Tab
    // before Draw. Restrict it to our last committed root and physical scopes.
    parent := TreeCurrentParent(session)
    previous := TreePrevious(session, parent, cast(u64)500, cast(s32)WidgetKindBox)
    root := TreePreviousCommitted(session, previous, cast(u64)550, cast(s32)WidgetKindBox)
    // Look up this Host root by parent generation rather than scanning other hosts.
    if root >= 0 { root = TreeNodeAt(session, root).parent }
    if root >= 0 {
        for i: cast(s32)0..TreeCount(session) - 1 {
            if Input.TreeFocusedAt(session, i) {
                pane := NodePane(session, i, root)
                if pane >= 0 { unused ActivatePane(host, pane) }
            }
        }
    }
    press := Input.TreeLastPress(session)
    if press.serial != host.pane_press {
        host.pane_press = press.serial
        chrome: float32=Native.ChromeHeight()-ifx host.menubar_hidden then Native.MenuHeight() else 0.0
        left: float32=ifx host.sidebar_hidden then 0.0 else 170.0+Native.PaneSeparatorWidth()
        body := Rectangle.{viewport.x + left, viewport.y + chrome, viewport.width - left, viewport.height - chrome - 28.0}
        if press.x >= body.x && press.x < body.x + body.width && press.y >= body.y && press.y < viewport.y + viewport.height - 32.0 {
            cut := body.x + cast(float32)host.divider
            if press.x < cut - 4.0 { unused ActivatePane(host, 0) }
            else if press.x >= cut + 4.0 { unused ActivatePane(host, 1) }
        }
    }
}

PasteFiles :: (host: *Host) -> bool {
    before := host.file_clipboard.changed
    ok := FileClipboard.Paste(*host.file_clipboard, ActiveManager(host))
    if host.file_clipboard.changed != before { RefreshOtherPane(host) }
    return ok
}

RefreshOtherPane :: (host: *Host) {
    if host.secondary.count == 0 { return }
    other := PaneManager(host, 1 - host.active_pane)
    // File operations have already completed. A refresh failure belongs to
    // this pane and cannot roll back completed filesystem work.
    unused Model.ReloadPreserving(other)
}

// Explorer owns tab routes and identity. Kryon owns the strip, clipping, focus,
// wheel overflow, close hit targets and pointer reorder interaction.
DrawTabs :: (host: *Host, session: Session, bounds: Rectangle, focused: bool,
    key: s32, modifiers: s32, pane_index: s32 = -1) -> bool {
    physical := ifx pane_index < 0 then host.active_pane else pane_index
    if physical == 1 {
        return DrawTabsInPane(host, *host.secondary[0].view, session, bounds, focused, key, modifiers, pane_index)
    }
    return DrawTabsInPane(host, *host.view, session, bounds, focused, key, modifiers, pane_index)
}

DrawTabsInPane :: (host: *Host, view: *PaneView, session: Session, bounds: Rectangle, focused: bool,
    key: s32, modifiers: s32, pane_index: s32 = -1) -> bool {
    manager := PaneManager(host, pane_index)

    count := manager.tabs.count
    if !VecReserve(view.tab_labels, count) || !VecReserve(view.tab_paths, count) ||
        !VecReserve(view.tab_keys, count) || !VecReserve(view.tab_items, count) {
        Model.SetError(manager, "Cannot allocate tab strip; routes retained"); return false
    }
    for index: count..view.tab_labels.count - 1 {
        VecFree(view.tab_labels[index].bytes); VecFree(view.tab_paths[index].bytes)
    }
    unused VecResize(view.tab_labels, count); unused VecResize(view.tab_paths, count)
    unused VecResize(view.tab_keys, count); unused VecResize(view.tab_items, count)
    reordered := false
    for index: cast(s32)0..cast(s32)manager.tabs.count - 1 {
        identity := Model.TabKey(manager, index)
        if view.tab_keys[index] != identity { reordered = true }
        if TextView(view.tab_paths[index]) != manager.tabs[index] || view.tab_keys[index] != identity {
            name := ifx manager.tabs[index] == "/" then "/" else TabPaths.PathName(manager.tabs[index])
            label: Text = FileDisplay.Caption(name)
            path: Text = TextCopy(manager.tabs[index])
            if label.bytes.count == 0 || path.bytes.count != manager.tabs[index].count {
                Model.SetError(manager, "Cannot allocate tab label; routes retained"); return false
            }
            VecSwap(view.tab_labels[index].bytes, label.bytes)
            VecSwap(view.tab_paths[index].bytes, path.bytes)
        }
        view.tab_keys[index] = identity
        view.tab_items[index] = .{.key = identity, .label = TextView(view.tab_labels[index]),
            .closeable = manager.tabs.count > 1}
    }
    active := Model.TabKey(manager, manager.active_tab)
    reveal := view.tab_active_key != active || reordered
    if reveal { view.tab_dragging = false; view.tab_drag_from = -1 }
    enabled := focused && !PaneLocked(host)
    bar_focused := false
    if enabled {
        for index: cast(s32)0..TreeCount(session) - 1 {
            if Input.TreeFocusedAt(session, index) && TreeNodeAt(session, index).focus_id == 238 &&
                FocusInCurrentScope(session, index) {
                bar_focused = true; break
            }
        }
    }
    props := TabBar.Props.{.key = cast(u64)238, .id = 238, .bounds = bounds,
        .selected_index = manager.active_tab, .min_tab_width = 100, .max_tab_width = 210,
        .content_sized = true, .scroll_offset = view.tab_scroll, .focus_selected = reveal,
        .dragging = view.tab_dragging, .drag_from = view.tab_drag_from,
        .reorder_enabled = true, .disabled = !enabled}
    props.input.focused = bar_focused && modifiers == 0
    props.input.left = key == KeyLeft; props.input.right = key == KeyRight
    props.input.home = key == KeyHome; props.input.end = key == KeyEnd
    props.input.close = key == KeyDelete || key == KeyBackspace
    result := TabBar.Draw(session, props, view.tab_items[:])
    view.tab_scroll = result.scroll_offset; view.tab_dragging = result.dragging
    view.tab_drag_from = result.drag_from; view.tab_active_key = active
    if enabled {
        if result.reordered_from >= 0 { unused Model.ReorderTab(manager, result.reordered_from, result.reordered_to) }
        else if result.closed_index >= 0 { unused Model.CloseTab(manager, result.closed_index) }
        else if result.activated_index >= 0 { unused Model.SwitchTab(manager, result.activated_index) }
    }
    return props.input.focused && (key == KeyLeft || key == KeyRight ||
        key == KeyHome || key == KeyEnd || key == KeyDelete || key == KeyBackspace)
}

CopyInto :: (target: []u8, value: string) -> s32 {
    count := cast(s32)value.count
    if count > cast(s32)target.count { count = cast(s32)target.count }
    for index: cast(s32)0..count - 1 { target[index] = value[index] }
    return count
}

Prepare :: (host: *Host, start_path: string = "") -> bool {
    if host == null || host.started { return false }
    host.active_pane = 0; host.split = false; host.divider = 0; host.divider_set = false
    host.pane_press = 0; host.modal_pane = -1; host.modal_tab = 0; host.next_pane = -1
    host.field.bytes = host.field_next[:]
    host.field.length = 0; host.field.cursor = 0; host.field.anchor = 0
    host.field.scroll_x = 0; host.field.focused = false; host.escaped_editor = false
    InitPaneView(*host.view)
    host.palette_loaded = false
    Model.Init(*host.manager, start_path)
    if host.manager.tabs.count == 0 { Model.Dispose(*host.manager); return false }
    host.bookmark_selected = -1; host.bookmark_scroll = 0
    host.places_key=0; host.places_route=0; host.location_without_slash=false
    host.sidebar_hidden=false; host.quit_requested=false; host.quit_all_requested=false; host.window_requested=false
    host.menubar_hidden=false; host.info_open=false
    host.bookmarks_ms = DateTime.UnixMilliseconds()
    if !Bookmarks.Init(*host.bookmarks) { Model.SetError(*host.manager, TextView(host.bookmarks.error)) }
    DesktopLocations.Init(*host.mounts)
    unused DesktopLocations.OpenMounts(*host.mounts)
    host.mounts_ms=DateTime.UnixMilliseconds()
    initial_trash_icon: Text=DesktopLocations.IconForUri("trash:///")
    VecSwap(host.trash_icon.bytes,initial_trash_icon.bytes)
    VecFree(initial_trash_icon.bytes)
    host.started = true
    return true
}

Close :: (host: *Host) {
    if host == null { return }
    GtkPainterRelease(*host.paint)
    DesktopLocations.Release(*host.mounts)
    VecFree(host.trash_icon.bytes)
    ReleasePaneView(*host.view)
    if host.started { Model.Dispose(*host.manager) }
    if host.secondary.count > 0 {
        Model.Dispose(*host.secondary[0].manager)
        ReleasePaneView(*host.secondary[0].view)
    }
    VecFree(host.secondary)
    Location.Release(*host.location); Location.ReleaseAncestors(*host.ancestors)
    VecFree(host.completion_items); VecFree(host.completion_flags); VecFree(host.breadcrumb_items)
    host.breadcrumb_open = false; host.actions_open = false; host.completion_scroll = 0
    VecFree(host.modal_path.bytes); VecFree(host.modal_target.bytes); VecFree(host.popup_path.bytes)
    VecFree(host.delete_keys); VecFree(host.delete_identities)
    VecFree(host.window_path.bytes)
    VecFree(host.info_body)
    CloseContextMenu(host); CloseChooser(host)
    VecFree(host.request.path.bytes); VecFree(host.context_current.bytes)
    VecFree(host.prompt_folder.bytes); VecFree(host.prompt_template.bytes); VecFree(host.rename_path.bytes)
    if host.drag.active { FileDrag.Finish(*host.drag) }
    VecFree(host.drop_rows); VecFree(host.window_queue); VecFree(host.external_drops)
    host.modal_tab = 0; host.popup_tab = 0
    FileClipboard.Close(*host.file_clipboard)
    Bookmarks.Release(*host.bookmarks); VecFree(host.bookmark_items); VecFree(host.bookmark_flags)
    Preview.Close(*host.preview)
    host.palette_loaded = false; host.started = false; host.active_pane = 0; host.split = false
    host.field.bytes = host.field_next[:]
    host.field.length = 0; host.field.cursor = 0; host.field.anchor = 0
    host.field.scroll_x = 0; host.field.focused = false
}

PromptTitle :: (host: *Host) -> string {
    manager := ActiveManager(host)

    if manager.prompt == .PromptBookmarkRename {
        return ifx host.escaped_editor then "Bookmark label (\\xNN bytes; \\\\ backslash)" else "Bookmark label"
    }
    if manager.prompt == .PromptRename {
        return ifx host.escaped_editor then "New name (\\xNN bytes; \\\\ backslash)" else "New name"
    }
    if manager.prompt == .PromptDelete { return "Permanently delete the selected files? This cannot be undone." }
    if manager.prompt == .PromptEmptyTrash { return "Remove all files and folders from the Trash?" }
    if manager.prompt == .PromptFolder { return "Folder name" }
    if manager.prompt == .PromptFile { return "File name" }
    if manager.prompt == .PromptLocation {
        return ifx host.escaped_editor then "Location (\\xNN bytes; \\\\ backslash)" else "Location"
    }
    if manager.prompt == .PromptSearch { return "Search" }
    if manager.prompt == .PromptSelectPattern { return "Select by pattern (* and ?)" }
    return ""
}

OpenPrompt :: (host: *Host, prompt: Model.PromptKind) {
    manager := ActiveManager(host)

    if !CaptureModalOwner(host, prompt) { return }
    host.breadcrumb_open = false; host.actions_open = false
    manager.prompt = prompt
    host.field.length = 0
    host.field.cursor = 0
    host.field.anchor = 0
    host.field.scroll_x = 0
    host.field.focused = true
    initial := ""
    if prompt == .PromptLocation { initial = manager.cwd }
    if prompt == .PromptRename && manager.cursor >= 0 {
        initial = Model.EntryName(manager, manager.cursor)
    }
    if prompt == .PromptRename && host.rename_path.bytes.count > 0 { initial = TabPaths.PathName(TextView(host.rename_path)) }
    // Thunar's create dialogs start with these names (or the template's).
    if prompt == .PromptFolder && host.prompt_folder.bytes.count > 0 { initial = "New Folder" }
    if prompt == .PromptFile && host.prompt_folder.bytes.count > 0 {
        initial = ifx host.prompt_template.bytes.count > 0 then TabPaths.PathName(TextView(host.prompt_template)) else "New Empty File"
    }
    if prompt == .PromptBookmarkRename && host.bookmark_selected >= 0 &&
        host.bookmark_selected < host.bookmarks.document.rows.count {
        initial = host.bookmarks.document.rows[host.bookmark_selected].label
    }
    host.escaped_editor = FileDisplay.NeedsEscapes(initial)
    caption: Text = FileDisplay.EditorText(initial, host.escaped_editor)
    if (initial != "" && caption.bytes.count == 0) || caption.bytes.count > host.field.bytes.count {
        Model.SetError(manager, ifx caption.bytes.count > host.field.bytes.count then
            "Escaped name or path is too long to edit safely" else "Cannot prepare name or path for editing")
        manager.prompt = .PromptNone
        host.field.focused = false
        return
    }
    host.field.length = CopyInto(host.field.bytes, TextView(caption))
    unused CopyInto(host.field_value[:], TextView(host.field.bytes[:host.field.length]))
    if prompt == .PromptRename || prompt == .PromptBookmarkRename || ((prompt == .PromptFolder || prompt == .PromptFile) && host.prompt_folder.bytes.count > 0) {
        host.field.cursor=host.field.length
        if (prompt==.PromptRename && host.rename_path.bytes.count==0 && !Model.EntryIsDirectory(manager,manager.cursor)) || prompt==.PromptFile {
            // Select the editable stem, preserving the final extension.
            i:=host.field.length
            while i>0 {
                i-=1
                if host.field.bytes[i]==46 { if i>0 { host.field.cursor=i }; break }
            }
        }
        host.field.anchor=0
    }
    if prompt == .PromptLocation {
        if !Location.Begin(*host.location, manager.cwd, Model.HomePath()) {
            Model.SetError(manager, "Cannot prepare location editor")
            CancelLocation(host); return
        }
        host.completion_scroll = 0
        host.field.cursor = host.field.length; host.field.anchor = 0
    }
}

FinishPrompt :: (host: *Host) {
    if host.active_pane == 1 {
        FinishPromptInPane(host, *host.secondary[0].view)
        return
    }
    FinishPromptInPane(host, *host.view)
}

FinishPromptInPane :: (host: *Host, view: *PaneView) {
    if !ModalOwnerValid(host) { CancelStaleModal(host); return }
    manager := ActiveManager(host)

    prompt_buffer: [4096]u8
    value_length := CopyInto(prompt_buffer[:], TextView(host.field.bytes[:host.field.length]))
    value := TextView(prompt_buffer[:value_length])
    prompt := manager.prompt
    if prompt == .PromptLocation {
        if host.location.selected >= 0 && host.location.preview.bytes.count > 0 &&
            value == TextView(host.location.preview) && host.escaped_editor == host.location.preview_escaped &&
            !Location.Validate(*host.location, host.location.order[host.location.selected]) {
            LocationError(host); return
        }
        if Location.Submit(*host.location, manager, value, host.escaped_editor) { host.location_without_slash=false; CancelLocation(host) }
        return
    }
    decoded: FileDisplay.EditorValue = FileDisplay.ParseEditor(
        ifx host.escaped_editor then value else "")
    if !decoded.valid {
        Model.SetError(manager, "Invalid byte escape; use \\xNN or \\\\ for a backslash")
        return
    }
    if host.escaped_editor { value = TextView(decoded.value) }
    if prompt == .PromptBookmarkRename && !Bookmarks.Edit(*host.bookmarks, host.bookmark_selected, 0, value) {
        Model.SetError(manager, TextView(host.bookmarks.error))
        return
    }
    manager.prompt = .PromptNone
    changed: bool
    if prompt == .PromptRename && host.rename_path.bytes.count > 0 { unused Model.RenamePathTo(manager, TextView(host.rename_path), value, *changed) }
    else if prompt == .PromptRename { unused Model.RenameSelection(manager, value, *changed) }
    else if (prompt == .PromptFolder || prompt == .PromptFile) && host.prompt_folder.bytes.count > 0 {
        unused Model.CreateIn(manager, TextView(host.prompt_folder), value, prompt == .PromptFolder, TextView(host.prompt_template), *changed)
        if changed { unused Model.ReloadPreserving(manager) }
    }
    else if prompt == .PromptFolder { unused Model.CreateFolder(manager, value, *changed) }
    else if prompt == .PromptFile { unused Model.CreateFile(manager, value, *changed) }
    else if prompt == .PromptSearch { unused Model.Search(manager, value) }
    else if prompt == .PromptSelectPattern { unused Model.SelectPattern(manager,value) }
    VecClear(host.rename_path.bytes); VecClear(host.prompt_folder.bytes); VecClear(host.prompt_template.bytes)
    // The filesystem step may succeed even when the active listing refresh
    // fails. Sync the peer after that step, without touching this pane's error.
    if changed { RefreshOtherPane(host) }
    host.field.length = 0
    host.field.focused = false
    host.escaped_editor = false
}

#scope_file
CancelLocation :: (host: *Host) {
    manager := ActiveManager(host)

    manager.prompt = .PromptNone
    host.field.length = 0; host.field.focused = false; host.escaped_editor = false
    Location.Release(*host.location); host.completion_scroll = 0
}
LocationError :: (host: *Host) {
    manager := ActiveManager(host)

    Model.SetError(manager, ifx host.location.error.bytes.count > 0 then
        TextView(host.location.error) else ifx host.location.valid then "No matching local entries" else "Completion unavailable; input retained")
}
ApplyLocation :: (host: *Host, value: *Location.Value) {
    manager := ActiveManager(host)

    if !value.valid { LocationError(host); return }
    // Encode checks capacity; this copy must never truncate a raw path.
    if value.text.bytes.count > host.field.bytes.count { Model.SetError(manager, "Completed location is too long"); return }
    host.field.length = CopyInto(host.field.bytes, TextView(value.text))
    host.field.cursor = host.field.length; host.field.anchor = host.field.length
    host.escaped_editor = value.escaped; host.field.focused = true
    if host.location.selected >= 0 {
        top := host.location.selected * 30
        if top < host.completion_scroll { host.completion_scroll = top }
        if top + 30 > host.completion_scroll + 240 { host.completion_scroll = top + 30 - 240 }
    }
}
LocationKey :: (host: *Host, key: s32, modifiers: s32) -> bool {

    if (modifiers & KeyModifierControl) != 0 || (key != KeyTab && key != KeyUp && key != KeyDown) { return false }
    if key == KeyTab && host.field.cursor != host.field.length {
        host.field.cursor = host.field.length; host.field.anchor = host.field.length; return true
    }
    value: Text = TextCopy(TextView(host.field.bytes[:host.field.length]))
    if key == KeyTab && TextView(value) == "~" {
        home: Location.Value = Location.Encode("~/", host.escaped_editor)
        ApplyLocation(host, *home)
        next: Text = TextCopy(TextView(host.field.bytes[:host.field.length]))
        VecSwap(value.bytes, next.bytes)
    }
    if key == KeyTab || !Location.Cached(*host.location, TextView(value), host.escaped_editor) {
        if !Location.Query(*host.location, TextView(value), host.escaped_editor) { LocationError(host); return true }
    }
    if key == KeyTab {
        completion: Location.Value = Location.Common(*host.location)
        ApplyLocation(host, *completion)
    } else {
        completion: Location.Value = Location.Cycle(*host.location, ifx key == KeyUp then -1 else 1)
        ApplyLocation(host, *completion)
    }
    return true
}
CompletionWidget :: (host: *Host, session: Session, bounds: Rectangle, focused: bool) -> s32 {
    manager := ActiveManager(host)

    if !host.location.valid || host.location.order.count == 0 { return -1 }
    if !VecResize(host.completion_items, host.location.order.count) ||
        !VecResize(host.completion_flags, host.location.order.count) { Model.SetError(manager, "Cannot display completions"); return -1 }
    for index: cast(s32)0..cast(s32)host.location.order.count - 1 {
        item := *host.location.candidates[host.location.order[index]]
        host.completion_items[index] = ListBox.ListBoxItem.{Model.PathKey(TextView(item.path)), TextView(item.caption)}
        host.completion_flags[index] = index == host.location.selected
    }
    props := ListBox.ListBoxMultiProps.{.key = cast(u64)224, .bounds = bounds, .row_height = 30,
        .anchor = host.location.selected, .scroll_offset = host.completion_scroll,
        .focused = false, .disabled = !focused}
    if focused { props.scroll_delta = cast(s32)(-Input.PointerWheelTake(session, bounds) * 60.0) }
    result := ListBox.ListBoxMulti(session, props, host.completion_items[:], host.completion_flags[:])
    host.completion_scroll = result.scroll_offset
    unused VecResize(host.completion_items, 0)
    return result.clicked_index
}
LocationBreadcrumbWidget :: (host: *Host, session: Session, bounds: Rectangle,
    focused: bool, key: s32) -> s32 {
    manager := ActiveManager(host)

    if !Location.BuildAncestors(*host.ancestors, manager.cwd) {
        Model.SetError(manager, ifx host.ancestors.error.bytes.count > 0 then TextView(host.ancestors.error) else "Cannot prepare breadcrumbs"); return -1
    }
    if !VecResize(host.breadcrumb_items, host.ancestors.rows.count) {
        Model.SetError(manager, "Cannot display breadcrumb ancestors"); return -1
    }
    for index: cast(s32)0..cast(s32)host.ancestors.rows.count - 1 {
        row := *host.ancestors.rows[index]
        host.breadcrumb_items[index] = BreadcrumbWidget.BreadcrumbItem.{.key = row.key, .label = TextView(row.caption)}
    }
    props := BreadcrumbWidget.Props.{.key = cast(u64)220, .bounds = bounds,
        .active_index = cast(s32)host.ancestors.rows.count - 1, .focused_index = -1,
        .focused = focused, .disabled = !focused || manager.prompt != .PromptNone,
        .overflow_label = "Ancestors"}
    if host.breadcrumb_open && focused {
        props.menu_input = .{.navigating = key == KeyUp || key == KeyDown || key == KeyHome || key == KeyEnd,
            .up = key == KeyUp, .down = key == KeyDown,
            .home = key == KeyHome, .end = key == KeyEnd, .commit = key == KeyEnter, .escape = key == KeyEscape}
    }
    was_open := host.breadcrumb_open
    stale := was_open && !PopupOwnerValid(host)
    props.close = stale
    result := BreadcrumbWidget.Draw(session, props, host.breadcrumb_items[:])
    host.breadcrumb_open = result.open
    if result.open && !was_open { CapturePopupOwner(host) }
    unused VecResize(host.breadcrumb_items, 0)
    if stale { Model.SetError(manager, "Menu owner changed; action canceled"); return -1 }
    return result.activated_index
}
DrawLocationBreadcrumb :: (host: *Host, session: Session, bounds: Rectangle, focused: bool, key: s32) {
    manager := ActiveManager(host)

    first:=TreeSubmittedCount(session)
    row := LocationBreadcrumbWidget(host, session, bounds, focused, key)
    host.breadcrumb_first=first;host.breadcrumb_last=TreeSubmittedCount(session);host.breadcrumb_bounds=bounds
    Native.RetainedControls(*host.paint,first,host.breadcrumb_last,bounds,false)
    if row >= 0 && row < host.ancestors.rows.count {
        unused Model.OpenPathTracked(manager, TextView(host.ancestors.rows[row].path))
    }
}
DrawNarrowActions :: (host: *Host, session: Session, bounds: Rectangle, focused: bool, key: s32) -> bool {
    manager := ActiveManager(host)

    labels: [14]string = .["New folder", "New file", "Rename", "Copy", "Paste", "Cut", "Duplicate", "Link", "Trash", "Show hidden", "Restore", "Preview", "Split view", "Other pane"]
    options: [14]DropdownWidget.Option
    for index: cast(s32)0..13 {
        options[index] = DropdownWidget.Option.{.key = cast(u64)(300 + index), .label = labels[index],
            .disabled = (index == 10 && manager.cwd != Model.TrashDirectory(false)) || (index == 13 && !host.split)}
    }
    props := DropdownWidget.Props.{.key = cast(u64)227, .bounds = bounds,
        .placeholder = "Actions", .selected_index = -1,
        .disabled = !focused || manager.prompt != .PromptNone}
    if host.actions_open && focused {
        props.menu_input = .{.navigating = key == KeyUp || key == KeyDown || key == KeyHome || key == KeyEnd,
            .up = key == KeyUp, .down = key == KeyDown, .home = key == KeyHome, .end = key == KeyEnd,
            .commit = key == KeyEnter, .escape = key == KeyEscape}
    }
    was_open := host.actions_open
    stale := was_open && !PopupOwnerValid(host)
    props.close = stale
    result := DropdownWidget.Draw(session, props, options[:])
    host.actions_open = result.open
    if result.open && !was_open { CapturePopupOwner(host) }
    if stale { Model.SetError(manager, "Menu owner changed; action canceled"); return true }
    if !result.changed { return was_open || result.open }
    choice := result.selected_index
    if choice == 0 { OpenPrompt(host, .PromptFolder) }
    else if choice == 1 { OpenPrompt(host, .PromptFile) }
    else if choice == 2 { OpenPrompt(host, .PromptRename) }
    else if choice == 3 { unused FileClipboard.Copy(*host.file_clipboard, manager, false) }
    else if choice == 4 { unused PasteFiles(host) }
    else if choice == 5 { unused FileClipboard.Copy(*host.file_clipboard, manager, true) }
    else if choice == 6 { unused Model.DuplicateSelection(manager); RefreshOtherPane(host) }
    else if choice == 7 { unused Model.MakeLinkSelection(manager); RefreshOtherPane(host) }
    else if choice == 8 { unused Model.DeleteSelection(manager, true); RefreshOtherPane(host) }
    else if choice == 9 { manager.show_hidden = !manager.show_hidden; unused Model.Refresh(manager) }
    else if choice == 10 { unused Model.RestoreSelection(manager); RefreshOtherPane(host) }
    else if choice == 11 && manager.cursor >= 0 { OpenPreview(host, Model.EntryPath(manager, manager.cursor)) }
    else if choice == 12 { host.actions_open = false; unused ToggleSplit(host) }
    else if choice == 13 { host.actions_open = false; RequestPane(host, 1 - host.active_pane) }
    return true
}
DrawLocationEditor :: (host: *Host, session: Session, bounds: Rectangle,
    viewport: Rectangle, key: s32, modifiers: s32, typed_text: string, focused: bool) {
    manager := ActiveManager(host)

    consumed := focused && LocationKey(host, key, modifiers)
    unused CopyInto(host.field_value[:], TextView(host.field.bytes[:host.field.length]))
    props := TextFieldWidget.Props.{.key = cast(u64)222, .bounds = bounds,
        .value = TextView(host.field_value[:host.field.length]), .cursor = host.field.cursor,
        .anchor = host.field.anchor, .scroll_x = host.field.scroll_x,
        .focused = host.field.focused && focused, .max_bytes = 4096, .capture_tab = true}
    props.input = Keys.TextFieldInputFor(ifx consumed then 0 else key, modifiers, ifx consumed then "" else typed_text)
    props.input.focus = host.field.focused && focused
    edited := TextFieldWidget.Draw(session, props)
    if edited.clipboard_write { unused SystemClipboardSet(edited.clipboard_text) }
    if focused && ApplyFieldEdit(*host.field, edited.edit) {
        host.field.cursor = edited.cursor; host.field.anchor = edited.anchor
        host.field.scroll_x = edited.scroll_x; host.field.focused = edited.focused
        if host.field.scroll_x < 0 { host.field.scroll_x = 0 }
    }
    if edited.committed { FinishPrompt(host); return }
    if edited.escaped { CancelLocation(host); return }
    if edited.edit.changed && focused {
        host.completion_scroll = 0
        input: Text = TextCopy(TextView(host.field.bytes[:host.field.length]))
        if !Location.Query(*host.location, TextView(input), host.escaped_editor) { LocationError(host) }
        else { Model.SetError(manager, "") }
    }
    height := cast(float32)host.location.order.count * 30.0
    if height > 240.0 { height = 240.0 }
    if bounds.y + bounds.height + height + 28.0 > viewport.y + viewport.height {
        height = viewport.y + viewport.height - bounds.y - bounds.height - 28.0
    }
    if !host.location.valid { height = 0.0 }
    if height > 0.0 {
        popup := Rectangle.{bounds.x, bounds.y + bounds.height, bounds.width, height}
        BoxWidget.Draw(session, BoxWidget.Props.{.key = cast(u64)223, .bounds = popup, .fill = ColorFromPacked(host.palette.base)})
        row := CompletionWidget(host, session, popup, focused)
        if row >= 0 {
            value: Location.Value = Location.Choose(*host.location, row)
            ApplyLocation(host, *value)
        }
    }
}
DrawLocationStatus :: (host: *Host, session: Session, viewport: Rectangle) {
    manager := ActiveManager(host)

    short_width := viewport.width < 520.0
    bounds := Rectangle.{viewport.x + 166.0,
        viewport.y + viewport.height - ifx short_width then 48.0 else 26.0,
        viewport.width - 174.0, ifx short_width then 44.0 else 22.0}
    if manager.error != "" {
        error: Text = FileDisplay.Caption(manager.error)
        TextWidget.Draw(session, TextWidget.Props.{.key = cast(u64)228, .bounds = bounds, .text = TextView(error), .size = 14})
    } else {
        TextWidget.Draw(session, TextWidget.Props.{.key = cast(u64)225, .bounds = bounds,
            .text = ifx host.escaped_editor then "Byte escapes: \\xNN; \\\\ backslash" else
                "Tab completes · ↑↓ choose · Enter opens · Esc cancels", .size = 14})
    }
}
ApplyFieldEdit :: (state: *FieldState, edit: TextFieldWidget.Edit) -> bool {
    if state == null { return false }
    if !edit.changed { return true }
    if edit.start < 0 || edit.end < edit.start || edit.end > state.length { return false }
    new_length := state.length - (edit.end - edit.start) + cast(s32)edit.replacement.count
    if new_length > cast(s32)state.bytes.count { return false }
    scratch: [4096]u8
    at: s32 = 0
    for index: cast(s32)0..edit.start - 1 {
        scratch[at] = state.bytes[index]
        at += 1
    }
    for byte: edit.replacement {
        scratch[at] = byte
        at += 1
    }
    for index: edit.end..state.length - 1 {
        scratch[at] = state.bytes[index]
        at += 1
    }
    for index: cast(s32)0..new_length - 1 { state.bytes[index] = scratch[index] }
    state.length = new_length
    return true
}

Button :: (host: *Host, session: Session, key: s32, label: string, bounds: Rectangle, enabled: bool = true) -> bool {
    if host.paint_active { return Native.Control(*host.paint,cast(u64)key,bounds,label,"",enabled) }
    return ButtonWidget.Draw(session,ButtonWidget.Props.{.key=cast(u64)key,.id=key,.bounds=bounds,.label=label,.disabled= !enabled,.fit_content=true})==1
}

BookmarkResult :: (host: *Host, ok: bool) {
    manager := ActiveManager(host)

    if !ok { Model.SetError(manager, TextView(host.bookmarks.error)) }
    else { Model.SetError(manager, "") }
}

TreeMode :: (host: *Host, enabled: bool) {
    if host.active_pane == 1 {
        TreeModeInPane(host, *host.secondary[0].view, enabled)
        return
    }
    TreeModeInPane(host, *host.view, enabled)
}

TreeModeInPane :: (host: *Host, view: *PaneView, enabled: bool) {

    view.tree_mode = enabled
    view.tree_focused = enabled
    // Re-entering Tree explicitly reveals cwd; collapsing an ancestor while
    // staying in Tree is otherwise respected until the location changes.
    if enabled { LocalTree.Store(*view.tree_attempt, "") }
}

TreeResult :: (host: *Host, ok: bool) {
    if host.active_pane == 1 {
        TreeResultInPane(host, *host.secondary[0].view, ok)
        return
    }
    TreeResultInPane(host, *host.view, ok)
}

TreeResultInPane :: (host: *Host, view: *PaneView, ok: bool) {
    manager := ActiveManager(host)

    if !ok || view.directory_tree.error.bytes.count > 0 {
        Model.SetError(manager, TextView(view.directory_tree.error))
    } else { Model.SetError(manager, "") }
}

SyncTree :: (host: *Host) -> bool {
    if host.active_pane == 1 {
        return SyncTreeInPane(host, *host.secondary[0].view)
    }
    return SyncTreeInPane(host, *host.view)
}

SyncTreeInPane :: (host: *Host, view: *PaneView) -> bool {
    manager := ActiveManager(host)

    if !view.tree_initialized {
        if !LocalTree.Init(*view.directory_tree, Model.HomePath()) {
            TreeResult(host, false); return false
        }
        view.tree_initialized = true
    }
    view.directory_tree.show_hidden = manager.show_hidden
    if !Model.IsUri(manager.cwd) && TextView(view.tree_attempt) != manager.cwd {
        LocalTree.Store(*view.tree_attempt, manager.cwd)
        if !LocalTree.Reveal(*view.directory_tree, manager.cwd) { TreeResult(host, false) }
        view.tree_reveal = true
    }
    return true
}

TreeNavigation :: (key: s32) -> Trees.TreeViewNavigation {
    if key == KeyHome { return .TreeViewNavigationHome }
    if key == KeyEnd { return .TreeViewNavigationEnd }
    if key == KeyUp { return .TreeViewNavigationUp }
    if key == KeyDown { return .TreeViewNavigationDown }
    if key == KeyLeft { return .TreeViewNavigationLeft }
    if key == KeyRight { return .TreeViewNavigationRight }
    return .TreeViewNavigationNone
}

DirectoryTreeWidget :: (host: *Host, session: Session, sidebar: Rectangle,
    enabled: bool, key: s32) -> Trees.TreeViewResult {
    if host.active_pane == 1 {
        return DirectoryTreeWidgetInPane(host, *host.secondary[0].view, session, sidebar, enabled, key)
    }
    return DirectoryTreeWidgetInPane(host, *host.view, session, sidebar, enabled, key)
}

DirectoryTreeWidgetInPane :: (host: *Host, view: *PaneView, session: Session, sidebar: Rectangle,
    enabled: bool, key: s32) -> Trees.TreeViewResult {
    manager := ActiveManager(host)

    if !LocalTree.Visible(*view.directory_tree, *view.tree_rows) ||
        !VecResize(view.tree_items, view.tree_rows.count) {
        Model.SetError(manager, "Tree visible row allocation failed."); return Trees.TreeViewResult.{.node = -1}
    }
    for index: cast(s32)0..cast(s32)view.tree_rows.count - 1 {
        node := *view.directory_tree.nodes[view.tree_rows[index]]
        view.tree_items[index] = Trees.TreeItem.{.id = node.id, .label = TextView(node.caption),
            .depth = node.depth, .expanded = node.expanded, .selectable = true,
            .leaf = node.loaded && node.child_count == 0}
    }
    bounds := Rectangle.{sidebar.x, sidebar.y + 68.0, sidebar.width, sidebar.height - 68.0}
    if view.tree_horizontal_max > 0 { bounds.height -= 32.0 }
    if bounds.height < 1.0 { return Trees.TreeViewResult.{.node = -1} }
    props := Trees.TreeViewProps.{.key = cast(u64)212, .bounds = bounds, .row_height = 32,
        .selected_id = view.directory_tree.selected, .scroll_offset = view.tree_scroll,
        .horizontal_offset = view.tree_horizontal, .reveal_selected = view.tree_reveal,
        .focused = enabled && view.tree_focused, .disabled = !enabled}
    if enabled {
        delta := cast(s32)(-Input.PointerWheelTake(session, bounds) * 64.0)
        if (Input.KeyboardModifiers(session) & KeyModifierShift) != 0 { props.horizontal_delta = delta }
        else { props.scroll_delta = delta }
    }
    if props.focused { props.navigation = TreeNavigation(key) }
    had_horizontal := view.tree_horizontal_max > 0
    // Disabled embedded draws cannot consume an explicit reveal request.
    if enabled { view.tree_reveal = false }
    result := Trees.TreeView(session, props, view.tree_items[:])
    panel:=Trees.TreeViewFace(StyleKindTreeView(),0,0,cast(s32)ButtonState.ButtonStateNormal)
    item_face:=Trees.TreeViewFace(StyleKindTreeViewItem(),0,0,cast(s32)ButtonState.ButtonStateNormal)
    metrics:=Trees.TreeViewMetricsFor(1.0,panel,item_face)
    p:=*host.paint
    p.clip=bounds
    Native.Surface(p,bounds,"sidebar")
    for i: cast(s32)0..cast(s32)view.tree_items.count-1 {
        yy:=bounds.y+cast(float32)(i*32-result.scroll_offset)
        if yy+32.0 <= bounds.y || yy >= bounds.y+bounds.height { continue }
        item:=view.tree_items[i]
        row:=Rectangle.{bounds.x,yy,bounds.width,32.0}
        state: u32=ifx item.id==result.selected_id then cast(u32)Gtk.GtkStyleSelected else cast(u32)0
        Native.Surface(p,row,"sidebar",state)
        content:=row; content.x-=cast(float32)result.horizontal_offset
        content.width+=cast(float32)result.horizontal_max_scroll
        marker:=Trees.TreeViewMarkerBounds(content,item.depth,metrics)
        label:=Trees.TreeViewTextBounds(content,item.depth,metrics)
        if !item.leaf { Native.Icon(p,.{marker.x,yy+8.0,16.0,16.0},ifx item.expanded then "pan-down-symbolic" else "pan-end-symbolic",state) }
        Native.Label(p,label,item.label,"sidebar",state)
    }
    p.clip=p.bounds
    view.tree_scroll = result.scroll_offset
    view.tree_horizontal = result.horizontal_offset
    view.tree_horizontal_max = result.horizontal_max_scroll
    if had_horizontal != (view.tree_horizontal_max > 0) { view.tree_reveal = true }
    view.directory_tree.selected = result.selected_id
    // TreeItem labels borrow cached captions. End that borrow before a toggle
    // can replace a branch. The retained widget copies its semantic labels.
    unused VecResize(view.tree_items, 0)
    return result
}

DrawDirectoryTree :: (host: *Host, session: Session, sidebar: Rectangle,
    focused: bool, key: s32) -> bool {
    if host.active_pane == 1 {
        return DrawDirectoryTreeInPane(host, *host.secondary[0].view, session, sidebar, focused, key)
    }
    return DrawDirectoryTreeInPane(host, *host.view, session, sidebar, focused, key)
}

DrawDirectoryTreeInPane :: (host: *Host, view: *PaneView, session: Session, sidebar: Rectangle,
    focused: bool, key: s32) -> bool {
    manager := ActiveManager(host)

    if !SyncTree(host) { return false }
    enabled := focused && !PaneLocked(host)
    if Button(host, session, 211, "Refresh branch", .{sidebar.x, sidebar.y + 30.0, sidebar.width, 32.0}, enabled) {
        TreeResult(host, LocalTree.Expand(*view.directory_tree, view.directory_tree.selected))
        view.tree_reveal = true
    }
    if view.tree_horizontal_max > 0 {
        y := sidebar.y + sidebar.height - 30.0
        if Button(host, session, 213, "Left", .{sidebar.x, y, 74.0, 30.0}, enabled && view.tree_horizontal > 0) {
            view.tree_horizontal -= 64
            if view.tree_horizontal < 0 { view.tree_horizontal = 0 }
            view.tree_focused = false
        }
        if Button(host, session, 214, "Right", .{sidebar.x + 78.0, y, 72.0, 30.0}, enabled && view.tree_horizontal < view.tree_horizontal_max) {
            if view.tree_horizontal < view.tree_horizontal_max - 64 { view.tree_horizontal += 64 }
            else { view.tree_horizontal = view.tree_horizontal_max }
            view.tree_focused = false
        }
    }
    tree_focused := enabled && view.tree_focused
    result := DirectoryTreeWidget(host, session, sidebar, enabled, key)
    tree_bounds := Rectangle.{sidebar.x, sidebar.y + 68.0, sidebar.width, sidebar.height - 68.0}
    if view.tree_horizontal_max > 0 { tree_bounds.height -= 32.0 }
    tree_pointer := Input.PointerSample(session)
    tree_secondary := Input.SecondaryPointerSample(session)
    for row: cast(s32)0..cast(s32)view.tree_rows.count - 1 {
        yy := tree_bounds.y + cast(float32)(row * 32 - view.tree_scroll)
        if yy + 32.0 <= tree_bounds.y || yy >= tree_bounds.y + tree_bounds.height { continue }
        node_index := view.tree_rows[row]
        row_bounds := Rectangle.{tree_bounds.x, yy, tree_bounds.width, 32.0}
        path := TextView(view.directory_tree.nodes[node_index].path)
        RecordDropRow(host, row_bounds, path, host.active_pane, cast(u64)0x7ee0000000000000 + cast(u64)node_index, true)
        if enabled && tree_secondary.released && tree_pointer.x >= row_bounds.x && tree_pointer.x < row_bounds.x + row_bounds.width &&
            tree_pointer.y >= row_bounds.y && tree_pointer.y < row_bounds.y + row_bounds.height {
            view.directory_tree.selected = view.directory_tree.nodes[node_index].id
            RequestContext(host, .Tree, .Folder, host.active_pane, tree_pointer.x, tree_pointer.y, path)
        }
    }
    if result.toggled_id > 0 { TreeResult(host, LocalTree.Toggle(*view.directory_tree, result.toggled_id)) }
    activate := result.activated_id
    if tree_focused && (key == KeyEnter || key == 32) && activate == 0 && result.toggled_id == 0 {
        activate = view.directory_tree.selected
    }
    if activate > 0 {
        at := LocalTree.Index(*view.directory_tree, activate)
        if at >= 0 { unused Model.OpenPathTracked(manager, TextView(view.directory_tree.nodes[at].path)) }
    }
    return tree_focused && (TreeNavigation(key) != .TreeViewNavigationNone || key == KeyEnter || key == 32)
}

DrawBookmarks :: (host: *Host, session: Session, sidebar: Rectangle, focused: bool) {
    manager := ActiveManager(host)

    now := DateTime.UnixMilliseconds()
    // Keep an open label editor tied to its original snapshot. Save rejects
    // external changes; refreshing the rows mid-edit could rename another row.
    if manager.prompt != .PromptBookmarkRename &&
        (now < host.bookmarks_ms || now - host.bookmarks_ms >= 1000) {
        refreshed := Bookmarks.Refresh(*host.bookmarks)
        if refreshed > 0 { host.bookmark_selected = -1; host.bookmark_scroll = 0 }
        if refreshed < 0 { BookmarkResult(host, false) }
        host.bookmarks_ms = now
    }
    y := sidebar.y + 148.0
    enabled := focused && manager.prompt == .PromptNone
    TextWidget.Draw(session, TextWidget.Props.{.key = cast(u64)200, .bounds = .{sidebar.x, y, sidebar.width, 24.0},
        .text = "Bookmarks", .size = 16})
    if Button(host, session, 201, "Add current", .{sidebar.x, y + 28.0, sidebar.width, 30.0}, enabled) {
        ok := Bookmarks.Add(*host.bookmarks, manager.cwd)
        BookmarkResult(host, ok)
        if ok { host.bookmark_selected = Bookmarks.Find(*host.bookmarks, manager.cwd) }
    }
    if Button(host, session, 202, "Rename", .{sidebar.x, y + 62.0, 74.0, 30.0}, enabled) {
        if host.bookmark_selected >= 0 && host.bookmark_selected < host.bookmarks.document.rows.count {
            OpenPrompt(host, .PromptBookmarkRename)
        } else { Model.SetError(manager, "Select a local bookmark first") }
    }
    if Button(host, session, 203, "Remove", .{sidebar.x + 78.0, y + 62.0, 72.0, 30.0}, enabled) {
        ok := Bookmarks.Edit(*host.bookmarks, host.bookmark_selected, 1)
        BookmarkResult(host, ok)
        if ok { host.bookmark_selected = -1 }
    }
    for direction: cast(s32)0..1 {
        if Button(host, session, 204 + direction, ifx direction == 0 then "Up" else "Down",
            .{sidebar.x + cast(float32)(direction * 78), y + 96.0, 72.0, 30.0}, enabled) {
            previous := host.bookmark_selected
            target := previous + ifx direction == 0 then -1 else 1
            ok := Bookmarks.Edit(*host.bookmarks, previous, 2 + direction)
            BookmarkResult(host, ok)
            if ok && target >= 0 && target < host.bookmarks.document.rows.count { host.bookmark_selected = target }
        }
    }
    if !VecResize(host.bookmark_items, host.bookmarks.document.rows.count) ||
        !VecResize(host.bookmark_flags, host.bookmarks.document.rows.count) { return }
    for index: cast(s32)0..cast(s32)host.bookmark_items.count - 1 {
        row := host.bookmarks.document.rows[index]
        host.bookmark_items[index] = ListBox.ListBoxItem.{cast(u64)row.line + cast(u64)1, row.caption}
        host.bookmark_flags[index] = index == host.bookmark_selected
    }
    list_bounds := Rectangle.{sidebar.x, y + 132.0, sidebar.width, sidebar.height - 280.0}
    if list_bounds.height < 32.0 { return }
    props := ListBox.ListBoxMultiProps.{.key = cast(u64)206, .bounds = list_bounds, .row_height = 32,
        .anchor = host.bookmark_selected, .scroll_offset = host.bookmark_scroll,
        .focused = enabled, .disabled = !enabled}
    if props.focused { props.scroll_delta = cast(s32)(-Input.PointerWheelTake(session, list_bounds) * 64.0) }
    result := ListBox.ListBoxMulti(session, props, host.bookmark_items[:], host.bookmark_flags[:])
    host.bookmark_scroll = result.scroll_offset
    if result.clicked_index >= 0 && result.clicked_index < host.bookmarks.document.rows.count {
        host.bookmark_selected = result.clicked_index
        unused Model.OpenPathTracked(manager, host.bookmarks.document.rows[result.clicked_index].path)
    }
}

ActivateEntry :: (host: *Host, row: s32) {
    if host.active_pane == 1 {
        ActivateEntryInPane(host, *host.secondary[0].view, row)
        return
    }
    ActivateEntryInPane(host, *host.view, row)
}

ActivateEntryInPane :: (host: *Host, view: *PaneView, row: s32) {
    manager := ActiveManager(host)

    if row < 0 || row >= manager.entries.count { return }
    if Model.EntryIsDirectory(manager, row) {
        unused Model.OpenPathTracked(manager, Model.EntryPath(manager, row))
    } else if Model.IsUri(Model.EntryPath(manager,row)) {
        if !Opener.OpenUri(Model.EntryPath(manager,row)) { Model.SetError(manager,"The default application could not be started.") }
    } else {
        OpenPreview(host, Model.EntryPath(manager, row))
        if host.preview.kind != .Image && !Preview.ImagePath(Model.EntryPath(manager, row)) {
            Preview.Close(*host.preview)
            if !Opener.OpenUri(Model.EntryPath(manager, row)) {
                Model.SetError(manager, "The default application could not be started.")
            }
        }
    }
    view.last_click_ms = 0
}

OpenPreview :: (host: *Host, path: string) {
    if host.active_pane == 1 {
        OpenPreviewInPane(host, *host.secondary[0].view, path)
        return
    }
    OpenPreviewInPane(host, *host.view, path)
}

OpenPreviewInPane :: (host: *Host, view: *PaneView, path: string) {

    if !CaptureModalOwner(host) { return }
    Preview.Open(*host.preview, path)
    // The canonical decoder also recognizes images with missing or misleading
    // extensions. A name hint for thumbnails is never reported as a MIME type.
    if host.preview.info.kind == .File && host.preview.kind != .Error &&
        host.preview.kind != .Image {
        texture := ImageWidget.ImageTextureFor(ImageWidget.Props.{.asset_path = TextView(host.preview.path)})
        if texture.width > 0 && texture.height > 0 {
            host.preview.kind = .Image
            VecClear(host.preview.body.bytes)
        }
    }
}

EntryClick :: (host: *Host, row: s32, modifiers: s32) {
    if host.active_pane == 1 {
        EntryClickInPane(host, *host.secondary[0].view, row, modifiers)
        return
    }
    EntryClickInPane(host, *host.view, row, modifiers)
}

EntryClickInPane :: (host: *Host, view: *PaneView, row: s32, modifiers: s32) {
    manager := ActiveManager(host)

    if row < 0 || row >= manager.entries.count { return }
    now := DateTime.UnixMilliseconds()
    path := Model.EntryPath(manager, row)
    repeated := modifiers == 0 && view.last_click_ms > 0 &&
        now >= view.last_click_ms && now - view.last_click_ms <= 400 &&
        view.last_click_view == manager.view_mode && TextView(view.last_click_path) == path
    Model.SetStoredText(*view.last_click_path, path)
    view.last_click_ms = ifx modifiers == 0 then now else 0
    view.last_click_view = manager.view_mode
    if repeated { ActivateEntry(host, row) }
}

SortColumn :: (mode: Model.SortMode) -> s32 {
    if mode == .SortSize { return 1 }
    if mode == .SortType { return 2 }
    if mode == .SortModified { return 3 }
    return 0
}

SortForColumn :: (column: s32) -> Model.SortMode {
    if column == 1 { return .SortSize }
    if column == 2 { return .SortType }
    if column == 3 { return .SortModified }
    return .SortName
}

ZoomIcon :: (view: *PaneView, mode: Model.ViewMode) -> s32 {
    sizes: [12]s32=.[16,24,32,48,64,96,128,160,192,256,512,1024]
    return sizes[view.zoom[cast(s32)mode]]
}

FileGridProps :: (manager: *Model.Manager, session: Session, bounds: Rectangle, view: *PaneView) -> GridMultiWidget.Props {
    props: GridMultiWidget.Props
    // ScrollDevice ownership uses raw keys, so include this retained Host
    // scope's identity when several Hosts share one UI session.
    parent := TreeSubmittedNodeAt(session, TreeCurrentParent(session))
    props.key = TreeIdentityHash(parent.identity_generation, cast(u64)44, 2147483646)
    props.bounds = bounds
    props.layout = ifx manager.view_mode == .ViewCompact then .GridMultiCompact else .GridMultiIcon
    props.cell_width = ifx manager.view_mode == .ViewCompact then 192 else 128
    props.cell_height = ifx manager.view_mode == .ViewCompact then 32 else 104
    props.image_size = ifx manager.view_mode == .ViewCompact then 18 else 48
    if view.zoom[cast(s32)manager.view_mode]!=3 {
        props.image_size=ZoomIcon(view,manager.view_mode)
        props.cell_height=props.image_size+ifx manager.view_mode==.ViewCompact then 14 else 56
        props.cell_width=props.image_size+ifx manager.view_mode==.ViewCompact then 174 else 80
    }
    props.gap = 4
    props.padding = 6
    props.cursor = manager.cursor
    props.anchor = manager.anchor
    props.scroll_offset = manager.scroll
    return props
}

// The native scroller owns its border and bar allocations. Callers supply the
// already inset content box, so restore only the queried CSS border here.
PrepareNativeScroll :: (view: *PaneView, session: Session, bounds: Rectangle,
    width: s32, height: s32, offset_x: s32, offset_y: s32,
    horizontal: bool, vertical: bool, focused: bool, dispatch: bool=true) -> Rectangle {
    nodes:=Native.ScrollNodes()
    if view.native_scroll==0 { view.native_scroll=NativeScroll.GtkScrollCreate(nodes[:]) }
    // Native motion belongs to this pane. A retained drag keeps its outside
    // coordinates; footer or sidebar motion must let GTK conceal the bar.
    captured:=view.native_scroll_metrics.dragging
    view.native_scroll_metrics=.{}
    if view.native_scroll==0 { return bounds }
    if !focused { unused NativeScroll.GtkScrollCancel(view.native_scroll) }
    border:=Gtk.GtkStyleQuery(nodes[:],1).border
    view.native_scroll_origin=.{bounds.x-cast(float32)border.left,bounds.y-cast(float32)border.top}
    pointer:=Input.PointerSample(session)
    view.native_scroll_props=.{.width=cast(s32)bounds.width+border.left+border.right,
        .height=cast(s32)bounds.height+border.top+border.bottom,
        .content_width=width,.content_height=height,.offset_x=offset_x,.offset_y=offset_y,
        .horizontal=horizontal,.vertical=vertical,.overlay=true,
        .pointer_present=focused && (captured || (pointer.x>=view.native_scroll_origin.x &&
            pointer.y>=view.native_scroll_origin.y &&
            pointer.x<view.native_scroll_origin.x+bounds.width+cast(float32)(border.left+border.right) &&
            pointer.y<view.native_scroll_origin.y+bounds.height+cast(float32)(border.top+border.bottom))),
        .pointer_x=cast(float64)(pointer.x-view.native_scroll_origin.x),
        .pointer_y=cast(float64)(pointer.y-view.native_scroll_origin.y),.down=focused && pointer.down,
        .pressed=dispatch && focused && pointer.pressed,.released=dispatch && pointer.released}
    view.native_scroll_metrics=NativeScroll.GtkScrollUpdate(view.native_scroll,view.native_scroll_props)
    metrics:=view.native_scroll_metrics
    if !metrics.available { return bounds }
    return .{view.native_scroll_origin.x+cast(float32)metrics.viewport.x,
        view.native_scroll_origin.y+cast(float32)metrics.viewport.y,
        cast(float32)metrics.viewport.width,cast(float32)metrics.viewport.height}
}

ApplyNativeWheel :: (host: *Host, view: *PaneView, session: Session, key: u64, body: Rectangle, horizontal: bool, focused: bool) -> bool {
    if !focused || !view.native_scroll_metrics.available || view.native_scroll_metrics.dragging { return false }
    zoom:=Input.KeyboardModifiers(session)==KeyModifierControl
    bar:=ifx horizontal then view.native_scroll_metrics.horizontal else view.native_scroll_metrics.vertical
    delta:=ScrollDevice.ScrollWheelTake(session,key,body,zoom || bar.upper>bar.page_size,horizontal)
    if delta==0.0 { return false }
    ScrollDevice.ScrollDeviceStopMotion(session,key)
    if zoom { ChangeZoom(host,ifx delta>0 then 1 else -1); return true }
    view.native_scroll_metrics=NativeScroll.GtkScrollWheel(view.native_scroll,cast(float64)delta,horizontal)
    return view.native_scroll_metrics.available
}

FinishNativeScroll :: (view: *PaneView, session: Session, offset_x: s32, offset_y: s32, focused: bool) {
    if !view.native_scroll_metrics.available { return }
    // Pointer motion and edges were dispatched once in the geometry pass.
    // This pass synchronizes wheel/navigation offsets without another event.
    view.native_scroll_props.offset_x=offset_x; view.native_scroll_props.offset_y=offset_y
    view.native_scroll_props.pressed=false
    view.native_scroll_props.released=false
    view.native_scroll_metrics=NativeScroll.GtkScrollUpdate(view.native_scroll,view.native_scroll_props)
}

PaintNativeScroll :: (view: *PaneView, session: Session, p: *GtkPainter, focused: bool) {
    if !view.native_scroll_metrics.available { return }
    for axis: cast(s32)0..1 {
        horizontal:=axis==0
        bar:=ifx horizontal then view.native_scroll_metrics.horizontal else view.native_scroll_metrics.vertical
        if !bar.visible || bar.bounds.width<1 || bar.bounds.height<1 { continue }
        bounds:=Rectangle.{view.native_scroll_origin.x+cast(float32)bar.bounds.x,
            view.native_scroll_origin.y+cast(float32)bar.bounds.y,cast(float32)bar.bounds.width,cast(float32)bar.bounds.height}
        unused GtkPainterScrollOver(p,view.native_scroll,bounds,horizontal)
        node:=TreeSubmitCurrent(session,cast(u64)0xfff7000000000000+cast(u64)axis,cast(s32)WidgetKindSlider,bounds)
        TreeSetInteractive(session,node,!focused,false,0)
        TreeSetDragCapture(session,node,true)
        TreeSetCursor(session,node,1)
    }
}

// GTK_STATE_FLAG_DROP_ACTIVE: Thunar highlights the folder a drag would drop on.
DROP_ACTIVE :: 4096;

// Primary presses may start a drag; a secondary click opens Thunar's item or
// folder menu, selecting an unselected item first as GTK views do.
ViewPointer :: (host: *Host, session: Session, pane: s32, hit: s32, body: Rectangle, focused: bool) {
    TrackDrag(host,session,pane,hit,body,focused)
    pointer:=Input.PointerSample(session)
    secondary:=Input.SecondaryPointerSample(session)
    if !focused || !secondary.released { return }
    if pointer.x<body.x || pointer.x>=body.x+body.width || pointer.y<body.y || pointer.y>=body.y+body.height { return }
    manager:=PaneManager(host,pane)
    if hit>=0 && hit<manager.entries.count {
        if !manager.selected[hit] { Model.SelectOne(manager,hit) }
        manager.cursor=hit
    } else { Model.ClearSelection(manager) }
    RequestContext(host,.View,.None,pane,pointer.x,pointer.y)
}

// One Places/Devices/Network row: its menu on a secondary click and, for
// local folders, a drop destination.
PlaceRow :: (host: *Host, session: Session, bounds: Rectangle, route: string, side: MenuSide, index: s32, key: u64, focused: bool) {
    if route!="" && !Model.IsUri(route) { RecordDropRow(host,bounds,route,host.active_pane,key,true) }
    pointer:=Input.PointerSample(session)
    secondary:=Input.SecondaryPointerSample(session)
    if !focused || !secondary.released { return }
    if pointer.x<bounds.x || pointer.x>=bounds.x+bounds.width || pointer.y<bounds.y || pointer.y>=bounds.y+bounds.height { return }
    RequestContext(host,.Shortcuts,side,host.active_pane,pointer.x,pointer.y,route,index)
}

DrawFileGrid :: (host: *Host, session: Session, bounds: Rectangle,
    key: s32, modifiers: s32, focused: bool, pane_index: s32 = -1) {
    physical := ifx pane_index < 0 then host.active_pane else pane_index
    if physical == 1 {
        DrawFileGridInPane(host, *host.secondary[0].view, session, bounds, key, modifiers, focused, pane_index)
        return
    }
    DrawFileGridInPane(host, *host.view, session, bounds, key, modifiers, focused, pane_index)
}

DrawFileGridInPane :: (host: *Host, view: *PaneView, session: Session, bounds: Rectangle,
    key: s32, modifiers: s32, focused: bool, pane_index: s32 = -1) {
    manager := PaneManager(host, pane_index)

    if !VecResize(view.grid_items, manager.entries.count) { return }
    for index: cast(s32)0..cast(s32)manager.entries.count - 1 {
        view.grid_items[index].key = manager.entries[index].key
        view.grid_items[index].label = Model.EntryCaption(manager, index)

    }
    bounds=Native.DetailsFrame(*host.paint,bounds)
    props := FileGridProps(manager, session, bounds,view)
    // GTK determines the viewport and whether bars consume allocation. Repeat
    // layout for a non-overlay bar, dispatching native input only on pass zero.
    original:=bounds
    for pass: cast(s32)0..1 {
        layout:=GridLayout.GridMultiMeasure(props,cast(s32)manager.entries.count)
        width:=ifx layout.compact then layout.content_extent else cast(s32)props.bounds.width
        height:=ifx layout.compact then cast(s32)props.bounds.height else layout.content_extent
        bounds=PrepareNativeScroll(view,session,original,width,height,
            ifx layout.compact then manager.scroll else 0,ifx layout.compact then 0 else manager.scroll,
            layout.compact,!layout.compact,focused,pass==0)
        props.bounds=bounds
        if view.native_scroll_metrics.available {
            manager.scroll=cast(s32)(ifx layout.compact then view.native_scroll_metrics.horizontal.value else view.native_scroll_metrics.vertical.value)
        }
    }
    if ApplyNativeWheel(host,view,session,props.key,bounds,manager.view_mode==.ViewCompact,focused) {
        manager.scroll=cast(s32)(ifx manager.view_mode==.ViewCompact then view.native_scroll_metrics.horizontal.value else view.native_scroll_metrics.vertical.value)
    }
    props.scroll_offset=manager.scroll
    props.external_scrollbar=view.native_scroll_metrics.available
    props.preserve_scroll_on_focus=true
    props.immediate_wheel=true
    props.invisible=true
    props.focused = focused
    // Keep the grid active during native capture: toggling disabled would
    // re-reveal the selected item on release and undo the dragged offset.
    // The native bar's retained slider node owns pointer hit testing.
    props.disabled = !focused
    props.control = (modifiers & KeyModifierControl) != 0
    props.shift = (modifiers & KeyModifierShift) != 0
    if focused {
        props.navigation.home = key == KeyHome
        props.navigation.end = key == KeyEnd
        props.navigation.left = key == KeyLeft
        props.navigation.right = key == KeyRight
        props.navigation.up = key == KeyUp
        props.navigation.down = key == KeyDown
        props.navigation.space = key == 32
        props.navigation.enter = key == KeyEnter
    }
    // GridMulti reveals focus on cursor, layout and viewport changes while
    // retaining independent wheel scrolling between navigation events.
    manager.reveal_focus = false
    result := GridMultiWidget.Draw(session, props, view.grid_items[:], manager.selected[:])
    if !result.valid { return }
    manager.cursor = result.cursor
    manager.anchor = result.anchor
    manager.scroll = result.scroll_offset
    compact:=manager.view_mode==.ViewCompact
    FinishNativeScroll(view,session,ifx compact then manager.scroll else 0,ifx compact then 0 else manager.scroll,focused)
    if view.native_scroll_metrics.available {
        manager.scroll=cast(s32)(ifx compact then view.native_scroll_metrics.horizontal.value else view.native_scroll_metrics.vertical.value)
        result.scroll_offset=manager.scroll
    }
    physical:=ifx pane_index<0 then host.active_pane else pane_index
    pointer:=Input.PointerSample(session)
    hit: s32= -1
    grid_metrics:=GridLayout.GridMultiMeasure(props,cast(s32)manager.entries.count)
    host.list_bounds[physical]=bounds
    RecordDropRow(host,bounds,manager.cwd,physical,0,true)
    for i: cast(s32)0..cast(s32)manager.entries.count-1 {
        cell:=GridLayout.GridMultiCellBounds(grid_metrics,i,result.scroll_offset)
        if cell.x+cell.width<bounds.x || cell.y+cell.height<bounds.y || cell.x>bounds.x+bounds.width || cell.y>bounds.y+bounds.height { continue }
        if pointer.x>=cell.x && pointer.x<cell.x+cell.width && pointer.y>=cell.y && pointer.y<cell.y+cell.height &&
            pointer.x>=bounds.x && pointer.x<bounds.x+bounds.width && pointer.y>=bounds.y && pointer.y<bounds.y+bounds.height { hit=i }
        RecordDropRow(host,cell,Model.EntryPath(manager,i),physical,manager.entries[i].key,Model.EntryIsDirectory(manager,i))
    }
    ViewPointer(host,session,physical,hit,bounds,focused)
    DrawNativeGrid(host,manager,bounds,props,result)
    PaintNativeScroll(view,session,*host.paint,focused)
    if result.activated_index >= 0 { ActivateEntry(host, result.activated_index) }
    else if result.clicked_index >= 0 { EntryClick(host, result.clicked_index, modifiers) }
}

DrawNativeGrid :: (host: *Host, manager: *Model.Manager, bounds: Rectangle, props: GridMultiWidget.Props, result: GridMultiWidget.GridMultiResult) {
    p:=*host.paint
    nodes:=Native.Nodes("treeview")
    nodes[2].widget_type="GtkIconView"; nodes[2].element="iconview"
    GtkPainterPaint(p,nodes[:],bounds)
    metrics:=GridLayout.GridMultiMeasure(props,cast(s32)manager.entries.count)
    previous_clip:=p.clip; p.clip=RectangleIntersection(previous_clip,bounds)
    for i: cast(s32)0..cast(s32)manager.entries.count-1 {
        cell:=GridLayout.GridMultiCellBounds(metrics,i,result.scroll_offset)
        if cell.x+cell.width<bounds.x || cell.y+cell.height<bounds.y || cell.x>bounds.x+bounds.width || cell.y>bounds.y+bounds.height { continue }
        state: u32=ifx manager.selected[i] then cast(u32)Gtk.GtkStyleSelected else cast(u32)0
        if host.drop_key!=0 && host.drop_key==manager.entries[i].key { state |= cast(u32)DROP_ACTIVE }
        nodes[2].state=state
        GtkPainterPaint(p,nodes[:],cell)
        size:=cast(float32)props.image_size
        icon:=Rectangle.{cell.x+(cell.width-size)*0.5,cell.y+4.0,size,size}
        label:=Rectangle.{cell.x+4.0,cell.y+size+8.0,cell.width-8.0,cell.height-size-12.0}
        if metrics.compact { icon=.{cell.x+4.0,cell.y+(cell.height-size)*0.5,size,size}; label=.{cell.x+size+8.0,cell.y,cell.width-size-12.0,cell.height} }
        path:=Model.EntryPath(manager,i)
        entry:=manager.entries[i]
        revision:=cast(u64)entry.info.modified ^ cast(u64)entry.info.modified_nanoseconds
        if entry.icon_serialized!="" { Native.SerializedIcon(p,icon,entry.icon_serialized,revision) }
        else { Native.FileIcon(p,icon,path,false,revision) }
        if !Model.IsUri(path) {
            if !Model.EntryIsDirectory(manager,i) && Preview.ImagePath(path) { GtkPainterPaint(p,nodes[:],icon,path,4,0,revision) }
            link:=TabPaths.PathQuery(path,false).info.kind==.Link
            Native.FileEmblems(p,.{icon.x-1.0,icon.y-1.0,icon.width+2.0,icon.height+2.0},icon,link,link && !TabPaths.PathQuery(path).valid)
        }
        GtkPainterPaint(p,nodes[:],label,Model.EntryCaption(manager,i),1,ifx metrics.compact then 0 else 1)
    }
    p.clip=previous_clip
    Native.DetailsUndershoot(p,bounds,result.scroll_offset,metrics.content_extent,metrics.compact)
}

DrawDetails :: (host: *Host, session: Session, bounds: Rectangle,
    key: s32, modifiers: s32, focused: bool, pane_index: s32 = -1) {
    physical := ifx pane_index < 0 then host.active_pane else pane_index
    if physical == 1 {
        DrawDetailsInPane(host, *host.secondary[0].view, session, bounds, key, modifiers, focused, pane_index)
        return
    }
    DrawDetailsInPane(host, *host.view, session, bounds, key, modifiers, focused, pane_index)
}

DetailsData :: (manager: *Model.Manager, index: s32, data: *DetailsCells) {
    entry:=*manager.entries[index]
    data.cells[0]=entry.caption
    size_length:=Gtk.GtkFormatFileSize(cast(u64)entry.info.size,data.size[:])
    data.cells[1]=ifx size_length>0 && !Model.EntryIsDirectory(manager,index) then TextView(data.size[:size_length]) else ""
    if data.path_key!=entry.key || data.stamp!=entry.info.modified || data.stamp_ns!=entry.info.modified_nanoseconds || data.size_value!=entry.info.size {
        type_buffer: [512]u8
        length:=ifx entry.content_type!="" then Gtk.GtkContentDescription(entry.content_type,type_buffer[:]) else ifx Model.IsUri(entry.path) then 0 else Gtk.GtkFileDescription(entry.path,type_buffer[:])
        description:=ifx length>0 then TextView(type_buffer[:length]) else Model.EntryType(entry)
        target: [4096]u8
        target_length:=ifx Model.IsUri(entry.path) then -1 else Gtk.GtkFileLinkTarget(entry.path,target[:])
        data.link=target_length>=0
        data.broken=data.link && !TabPaths.PathQuery(entry.path).valid
        b: Vec(u8)
        if data.broken { description="broken link" }
        unused BuilderAppend(b,description)
        if data.link && !data.broken {
            caption: Text=FileDisplay.Caption(TextView(target[:target_length]))
            BuilderPrint(*b," (link to %)",TextView(caption))
        }
        VecSwap(data.description.bytes,b)
        VecFree(b)
        data.path_key=entry.key; data.stamp=entry.info.modified
        data.stamp_ns=entry.info.modified_nanoseconds; data.size_value=entry.info.size
    }
    data.cells[2]=TextView(data.description)
    date_length:=Gtk.GtkFormatFileDate(entry.info.modified,data.modified[:],.RelativeDate,-1,"thunar")
    data.cells[3]=ifx date_length>0 then TextView(data.modified[:date_length]) else ""
}

MeasureDetailsColumns :: (manager: *Model.Manager, view: *PaneView, bounds: Rectangle) {
    if view.columns_resized { return }
    today:=DateTime.LocalNow()
    signature:=cast(u64)manager.entries.count+1
    signature=signature ^ cast(u64)(today.year*512+today.month*32+today.day)
    for entry: manager.entries {
        signature=(signature ^ entry.key ^ cast(u64)entry.info.modified ^ cast(u64)entry.info.modified_nanoseconds ^ cast(u64)entry.info.size)*cast(u64)1099511628211
    }
    generation:=Gtk.GtkStyleGeneration()
    count:=cast(s32)manager.entries.count
    changed:=signature!=view.columns_signature || generation!=view.columns_generation
    if changed || view.columns_pending {
        // Show the destination's visible rows before measuring offscreen text.
        // The next frame finishes the exact native widths for the whole list.
        first: s32=0; end:=count
        if changed {
            icon:=ifx view.zoom[cast(s32)manager.view_mode]==3 then cast(s32)Native.DetailsIconSize() else ZoomIcon(view,.ViewList)
            row_height:=Native.DetailsRowHeight()+icon-cast(s32)Native.DetailsIconSize()
            if row_height<1 { row_height=1 }
            first=manager.scroll/row_height
            if first<0 || first>=count { first=0 }
            end=first+cast(s32)(bounds.height/ cast(float32)row_height)+2
            if end>count { end=count }
        }
        measured:=end-first
        if !VecResize(view.column_values,cast(s64)measured) { return }
        for index: first..end-1 { DetailsData(manager,index,*view.details_cells[index]) }
        headers: [4]string=.["Name","Size","Type","Date Modified"]
        tree:=Native.Nodes("treeview"); header:=Native.HeaderNodes()
        style:=Gtk.GtkStyleQuery(tree[:],1)
        for column: cast(s32)0..3 {
            header[4].sibling_count=4; header[4].sibling_index=column
            preferred:=Gtk.GtkWidgetMeasure(header[:],headers[column],true)
            if column==0 {
                if preferred.available { view.name_minimum=preferred.minimum_width }
            } else if preferred.available && preferred.minimum_width>view.column_widths[column] { view.column_widths[column]=preferred.minimum_width }
            for index: cast(s32)0..measured-1 { view.column_values[index]=view.details_cells[first+index].cells[column] }
            cell:=Gtk.GtkCellTextMeasureMany(tree[:],view.column_values[:],ifx column==0 then 60 else -1,column==0)
            if column==0 {
                icon:=ifx view.zoom[cast(s32)manager.view_mode]==3 then cast(s32)Native.DetailsIconSize() else ZoomIcon(view,.ViewList)
                width:=cell.minimum_width+icon+style.horizontal_separator+2
                if cell.available && width>view.name_minimum { view.name_minimum=width }
                if view.name_minimum<50 { view.name_minimum=50 }
                continue
            }
            width:=cell.natural_width+style.horizontal_separator
            if cell.available && width>view.column_widths[column] { view.column_widths[column]=width }
        }
        view.columns_signature=signature; view.columns_generation=generation
        view.columns_pending=first>0 || end<count
    }
    name_width:=cast(s32)bounds.width-view.column_widths[1]-view.column_widths[2]-view.column_widths[3]
    if name_width<view.name_minimum { name_width=view.name_minimum }
    view.column_widths[0]=name_width
}

DrawDetailsInPane :: (host: *Host, view: *PaneView, session: Session, bounds: Rectangle,
    key: s32, modifiers: s32, focused: bool, pane_index: s32 = -1) {
    manager := PaneManager(host, pane_index)

    p := *host.paint
    bounds=Native.DetailsFrame(p,bounds)
    columns: [4]string = .["Name","Size","Type","Date Modified"]
    count := cast(s32)manager.entries.count
    if !VecResize(view.details_cells,cast(s64)count) { return }
    MeasureDetailsColumns(manager,view,bounds)
    Native.Surface(p,bounds,"treeview")
    header_height:=Native.HeaderHeight()
    body := Rectangle.{bounds.x,bounds.y+header_height,bounds.width,bounds.height-header_height}
    icon_size: float32=ifx view.zoom[cast(s32)Model.ViewMode.ViewList]==3 then Native.DetailsIconSize() else cast(float32)ZoomIcon(view,.ViewList)
    icon_delta:=icon_size-Native.DetailsIconSize()
    row_height:=Native.DetailsRowHeight()+cast(s32)icon_delta
    content_width: s32
    for width: view.column_widths { content_width+=width }
    body=PrepareNativeScroll(view,session,body,content_width,count*row_height,
        view.details_scroll_x,manager.scroll,true,true,focused)
    if view.native_scroll_metrics.available {
        manager.scroll=cast(s32)view.native_scroll_metrics.vertical.value
        view.details_scroll_x=cast(s32)view.native_scroll_metrics.horizontal.value
    }
    if content_width<cast(s32)body.width { content_width=cast(s32)body.width }
    header := Rectangle.{body.x,bounds.y,body.width,header_height}
    Native.Surface(p,header,"toolbar")
    previous_clip:=p.clip
    p.clip=RectangleIntersection(previous_clip,header)
    x := body.x-cast(float32)view.details_scroll_x
    for column: cast(s32)0..3 {
        width := cast(float32)view.column_widths[column]
        if column == 3 { width=body.x-cast(float32)view.details_scroll_x+cast(float32)content_width-x }
        resize_key:=cast(u64)0xffff000000000000 | cast(u64)column
        previous:=TreePrevious(session,TreeCurrentParent(session),resize_key,cast(s32)WidgetKindSlider)
        drag:=Input.TreeTakeDragAt(session,previous)
        if column<3 && focused && (drag.active || drag.ended) {
            width=drag.x-drag.grab_x-x+3.0
            if width<60.0 { width=60.0 }
            view.column_widths[column]=cast(s32)width
            view.columns_resized=true
        }
        if Native.Header(p,cast(u64)(60+column),.{x,header.y,width,header_height},columns[column],SortColumn(manager.sort_mode)==column,manager.sort_reverse,focused) {
            mode := SortForColumn(column)
            Model.SetSort(manager,mode,ifx mode==manager.sort_mode then !manager.sort_reverse else false)
            view.last_click_ms=0
        }
        x+=width
    }
    // Dividers are above both neighboring header buttons for hit testing.
    x=body.x-cast(float32)view.details_scroll_x
    for column: cast(s32)0..2 {
        x+=cast(float32)view.column_widths[column]
        node:=TreeSubmitCurrent(session,cast(u64)0xffff000000000000 | cast(u64)column,cast(s32)WidgetKindSlider,.{x-3.0,header.y,6.0,header.height})
        TreeSetInteractive(session,node,!focused,false,column+800)
        TreeSetCursor(session,node,5)
    }
    p.clip=previous_clip
    parent := TreeSubmittedNodeAt(session, TreeCurrentParent(session))
    scroll_key := TreeIdentityHash(parent.identity_generation, cast(u64)40, 2147483646)
    state := Tables.TableViewResult.{.focused_row=manager.cursor,.anchor=manager.anchor}
    navigated := focused && (key==KeyHome || key==KeyEnd || key==KeyUp || key==KeyDown)
    if focused && count > 0 {
        row := manager.cursor
        if row < 0 { row=0 }
        if key==KeyHome { row=0 } else if key==KeyEnd { row=count-1 }
        else if key==KeyUp && row > 0 { row-=1 } else if key==KeyDown && row<count-1 { row+=1 }
        control := (modifiers & KeyModifierControl)!=0
        shift := (modifiers & KeyModifierShift)!=0
        if navigated { state=Tables.TableViewMultiSelect(manager.selected[:],count,state,row,control,shift,control && !shift) }
        else if key==32 { state=Tables.TableViewMultiSelect(manager.selected[:],count,state,row,true,false) }
        manager.cursor=state.focused_row; manager.anchor=state.anchor
    }
    if manager.reveal_focus || navigated || key==32 || key==KeyEnter {
        maximum := count*row_height-cast(s32)body.height
        if maximum<0 { maximum=0 }
        manager.scroll=Tables.TableViewSelectionScrollOffset(manager.cursor,0,row_height,cast(s32)body.height,manager.scroll,maximum)
        manager.reveal_focus=false
        ScrollDevice.ScrollDeviceStopMotion(session,scroll_key)
    }
    if ApplyNativeWheel(host,view,session,scroll_key,body,(modifiers & KeyModifierShift)!=0,focused) {
        manager.scroll=cast(s32)view.native_scroll_metrics.vertical.value
        view.details_scroll_x=cast(s32)view.native_scroll_metrics.horizontal.value
    } else if focused && (modifiers & KeyModifierShift)!=0 && !view.native_scroll_metrics.available {
        view.details_scroll_x-=cast(s32)(Input.PointerWheelTake(session,body)*48.0)
    }
    scroll := ScrollWidget.Draw(session,ScrollWidget.Props.{.key=scroll_key,.bounds=body,.content_height=count*row_height,
        .scroll_offset=manager.scroll,.manual_scroll=true,.external_scrollbar=view.native_scroll_metrics.available,.immediate_wheel=true,
        .input=.{.disabled= !focused || view.native_scroll_metrics.dragging}})
    manager.scroll=scroll.scroll_offset
    FinishNativeScroll(view,session,view.details_scroll_x,manager.scroll,focused)
    if view.native_scroll_metrics.available {
        manager.scroll=cast(s32)view.native_scroll_metrics.vertical.value
        view.details_scroll_x=cast(s32)view.native_scroll_metrics.horizontal.value
    }
    physical:=ifx pane_index<0 then host.active_pane else pane_index
    pointer:=Input.PointerSample(session)
    hit: s32= -1
    if pointer.x>=body.x && pointer.x<body.x+body.width && pointer.y>=body.y && pointer.y<body.y+body.height {
        hit_row:=(cast(s32)(pointer.y-body.y)+manager.scroll)/row_height
        if hit_row>=0 && hit_row<count { hit=hit_row }
    }
    host.list_bounds[physical]=body
    RecordDropRow(host,body,manager.cwd,physical,0,true)
    ViewPointer(host,session,physical,hit,body,focused)
    if scroll.opened {
        if ButtonWidget.Draw(session,ButtonWidget.Props.{.key=cast(u64)649,.bounds=body,.invisible=true,.disabled= !focused})==1 { Model.ClearSelection(manager) }
        first := manager.scroll/row_height
        last := (manager.scroll+cast(s32)body.height+row_height-1)/row_height
        if last>=count { last=count-1 }
        activated: s32 = -1
        for index: first..last {
            yy := body.y+cast(float32)(index*row_height-manager.scroll)
            // GTK clips partially visible rows through the same viewport.
            row_bounds := Rectangle.{body.x,yy,body.width,cast(float32)row_height}
            entry := *manager.entries[index]
            previous:=TreePrevious(session,TreeCurrentParent(session),entry.key,cast(s32)WidgetKindSelectable)
            clicked := focused && Input.TreeTakeActivationAt(session,previous)
            node:=TreeSubmitCurrent(session,entry.key,cast(s32)WidgetKindSelectable,row_bounds)
            TreeSetInteractive(session,node,!focused,false,index+1)
            TreeSetSelected(session,node,manager.selected[index])
            TreeSetLabel(session,node,entry.caption)
            if clicked {
                state=Tables.TableViewMultiSelect(manager.selected[:],count,state,index,(modifiers & KeyModifierControl)!=0,(modifiers & KeyModifierShift)!=0)
                manager.cursor=state.focused_row; manager.anchor=state.anchor
                activated=index
            }
            selected := manager.selected[index]
            gtk_state: u32 = ifx selected then cast(u32)Gtk.GtkStyleSelected else cast(u32)0
            if focused && Input.TreeHoveredAt(session,previous) { gtk_state |= cast(u32)Gtk.GtkStylePrelight }
            RecordDropRow(host,row_bounds,entry.path,physical,entry.key,Model.EntryIsDirectory(manager,index))
            if host.drop_key!=0 && host.drop_key==entry.key { gtk_state |= cast(u32)DROP_ACTIVE }
            // Avoid painting outside the scroll viewport into headers/footer.
            p.clip=RectangleIntersection(previous_clip,body)
            Native.Surface(p,row_bounds,"treeview",gtk_state)
            x=body.x-cast(float32)view.details_scroll_x
            data := *view.details_cells[index]
            DetailsData(manager,index,data)
            revision:=cast(u64)entry.info.modified ^ cast(u64)entry.info.modified_nanoseconds
            icon_bounds:=Rectangle.{x+Native.DetailsIconX(),yy+Native.DetailsIconY(),icon_size,icon_size}
            if entry.icon_serialized!="" { Native.SerializedIcon(p,icon_bounds,entry.icon_serialized,revision) }
            else { Native.FileIcon(p,icon_bounds,entry.path,false,revision) }
            if !Model.IsUri(entry.path) && !Model.EntryIsDirectory(manager,index) && Preview.ImagePath(entry.path) { nodes:=Native.Nodes("image"); GtkPainterPaint(p,nodes[:],icon_bounds,entry.path,4,0,revision) }
            Native.FileEmblems(p,.{icon_bounds.x-1.0,yy+1.0,icon_size+2.0,icon_size+2.0},icon_bounds,data.link,data.broken)
            scoped:=TreePushScope(session,node)
            for column: cast(s32)0..3 {
                width := cast(float32)view.column_widths[column]
                if column==3 { width=body.x-cast(float32)view.details_scroll_x+cast(float32)content_width-x }
                padding:=ifx column==0 then Native.DetailsTextX()+icon_delta else Native.DetailsCellPadding()
                cell_bounds:=Rectangle.{x+padding,yy,width-padding-Native.DetailsCellPadding(),cast(float32)row_height}
                if scoped { cell:=TreeSubmitCurrent(session,cast(u64)(column+1),cast(s32)WidgetKindText,cell_bounds); TreeSetLabel(session,cell,data.cells[column]) }
                Native.Label(p,cell_bounds,data.cells[column],"treeview",gtk_state,ifx column==1 then 2 else 0)
                x+=width
            }
            if scoped { End(session) }
        }
        p.clip=previous_clip
        End(session)
        if activated >= 0 { EntryClick(host,activated,modifiers) }
    }
    Native.DetailsUndershoot(p,body,manager.scroll,count*row_height)
    Native.DetailsUndershoot(p,body,view.details_scroll_x,content_width,true)
    PaintNativeScroll(view,session,p,focused)
    if focused && key==KeyEnter { ActivateEntry(host,manager.cursor) }

}

PreviewStep :: (host: *Host, direction: s32) {
    if host.active_pane == 1 {
        PreviewStepInPane(host, *host.secondary[0].view, direction)
        return
    }
    PreviewStepInPane(host, *host.view, direction)
}

PreviewStepInPane :: (host: *Host, view: *PaneView, direction: s32) {
    manager := ActiveManager(host)

    images_only := host.preview.kind == .Image
    row := manager.cursor + direction
    while row >= 0 && row < manager.entries.count {
        if !Model.EntryIsDirectory(manager, row) &&
            (!images_only || Preview.ImagePath(Model.EntryPath(manager, row))) {
            Model.SelectOne(manager, row)
            manager.reveal_focus = true
            OpenPreview(host, Model.EntryPath(manager, row))
            return
        }
        row += direction
    }
}

DrawPreviewText :: (host: *Host, session: Session, bounds: Rectangle,
    key: s32, modifiers: s32, focused: bool) {
    if host.active_pane == 1 {
        DrawPreviewTextInPane(host, *host.secondary[0].view, session, bounds, key, modifiers, focused)
        return
    }
    DrawPreviewTextInPane(host, *host.view, session, bounds, key, modifiers, focused)
}

DrawPreviewTextInPane :: (host: *Host, view: *PaneView, session: Session, bounds: Rectangle,
    key: s32, modifiers: s32, focused: bool) {

    state := *host.preview
    if key == KeyHome { state.text_scroll = 0; state.pan_x = 0.0 }
    if key == KeyEnd { state.text_scroll = state.lines * 20 }
    if key == KeyDown { state.text_scroll += 20 }
    if key == KeyUp { state.text_scroll -= 20 }
    if key == KeyPageDown { state.text_scroll += cast(s32)bounds.height - 20 }
    if key == KeyPageUp { state.text_scroll -= cast(s32)bounds.height - 20 }
    if key == KeyRight { state.pan_x += 64.0 }
    if key == KeyLeft { state.pan_x -= 64.0 }
    if (modifiers & KeyModifierShift) != 0 {
        state.pan_x -= Input.PointerWheelTake(session, bounds) * 48.0
    }
    if state.pan_x < 0.0 { state.pan_x = 0.0 }
    // Keep even pathological long lines within the widget coordinate budget.
    if state.pan_x > cast(float32)Preview.TEXT_LIMIT * 8.0 { state.pan_x = cast(float32)Preview.TEXT_LIMIT * 8.0 }
    identity := TreeSubmittedNodeAt(session, TreeCurrentParent(session)).identity_generation
    scroll := ScrollWidget.Draw(session, ScrollWidget.Props.{.key = TreeIdentityHash(identity, cast(u64)91, 2147483646),
        .bounds = bounds, .content_height = state.lines * 20,
        .scroll_offset = state.text_scroll, .manual_scroll = true,
        .input = .{.enabled = !focused, .disabled = !focused}})
    if !scroll.opened { return }
    defer { End(session) }
    state.text_scroll = scroll.scroll_offset
    text := TextView(state.body)
    start: s64 = 0
    row: s32 = 0
    at: s64 = 0
    while at <= text.count {
        if at == text.count || text[at] == cast(u8)10 {
            y := scroll.viewport.y + cast(float32)(row * 20 - state.text_scroll)
            if y + 20.0 >= bounds.y && y < bounds.y + bounds.height {
                line := text[start:at]
                if line.count > 0 && line[line.count - 1] == cast(u8)13 { line = line[:line.count - 1] }
                TextWidget.Draw(session, TextWidget.Props.{.key = cast(u64)(row + 1000),
                    .bounds = .{scroll.viewport.x + 4.0 - state.pan_x, y,
                        cast(float32)Preview.TEXT_LIMIT * 8.0, 20.0},
                    .text = line, .size = 14, .wrap = .TextWrapNone})
            }
            row += 1
            start = at + 1
        }
        at += 1
    }
}

DrawPreview :: (host: *Host, session: Session, viewport: Rectangle,
    key: s32, modifiers: s32, focused: bool) {
    if host.active_pane == 1 {
        DrawPreviewInPane(host, *host.secondary[0].view, session, viewport, key, modifiers, focused)
        return
    }
    DrawPreviewInPane(host, *host.view, session, viewport, key, modifiers, focused)
}

DrawPreviewInPane :: (host: *Host, view: *PaneView, session: Session, viewport: Rectangle,
    key: s32, modifiers: s32, focused: bool) {
    manager := ActiveManager(host)

    state := *host.preview
    if key == KeyEscape || (key == 80 && (modifiers & KeyModifierControl) != 0) {
        Preview.Close(state)
        return
    }
    if state.kind == .Image {
        if key == KeyPageUp || (state.zoom == 0 && key == KeyLeft) { PreviewStep(host, -1) }
        if key == KeyPageDown || (state.zoom == 0 && key == KeyRight) { PreviewStep(host, 1) }
        if key == 61 || key == 43 { Preview.Zoom(state, 1) }
        if key == 45 { Preview.Zoom(state, -1) }
        if key == KeyHome || key == 48 { state.zoom = 0; state.pan_x = 0.0; state.pan_y = 0.0 }
    }
    BoxWidget.Draw(session, BoxWidget.Props.{.key = cast(u64)80, .bounds = viewport,
        .fill = ColorFromPacked(host.palette.background)})
    preview_caption: Text = FileDisplay.Caption(TextView(state.path))
    TextWidget.Draw(session, TextWidget.Props.{.key = cast(u64)81,
        .bounds = .{viewport.x + 8.0, viewport.y + 8.0, viewport.width - 16.0, 24.0},
        .text = TextView(preview_caption), .size = 16, .wrap = .TextWrapEllipsis})
    x := viewport.x + 8.0
    y := viewport.y + 40.0
    if Button(host, session, 82, "Previous", .{x, y, 76.0, 32.0}) { PreviewStep(host, -1) }
    if Button(host, session, 83, "Next", .{x + 82.0, y, 62.0, 32.0}) { PreviewStep(host, 1) }
    if Button(host, session, 84, "Open", .{x + 150.0, y, 78.0, 32.0}) || key == KeyEnter {
        if !Opener.OpenUri(TextView(state.path)) {
            Model.SetError(manager, "The default application could not be started.")
        }
    }
    if Button(host, session, 85, "Close", .{viewport.x + viewport.width - 76.0, y, 68.0, 32.0}) {
        Preview.Close(state)
        return
    }
    controls_x := x + 238.0
    content_y := y + 40.0
    if viewport.width < 640.0 { controls_x = x; y += 38.0; content_y += 38.0 }
    if state.kind == .Image {
        if Button(host, session, 86, "Fit", .{controls_x, y, 58.0, 32.0}) {
            state.zoom = 0; state.pan_x = 0.0; state.pan_y = 0.0
        }
        if Button(host, session, 87, "100%", .{controls_x + 64.0, y, 62.0, 32.0}) {
            state.zoom = 100; state.pan_x = 0.0; state.pan_y = 0.0
        }
        if Button(host, session, 88, "−", .{controls_x + 132.0, y, 42.0, 32.0}) { Preview.Zoom(state, -1) }
        if Button(host, session, 89, "+", .{controls_x + 180.0, y, 42.0, 32.0}) { Preview.Zoom(state, 1) }
    }
    body := Rectangle.{viewport.x + 8.0, content_y, viewport.width - 16.0,
        viewport.y + viewport.height - 62.0 - content_y}
    if body.width < 1.0 { body.width = 1.0 }
    if body.height < 1.0 { body.height = 1.0 }
    if state.kind == .Image {
        image := ImageWidget.Props.{.key = cast(u64)90, .asset_path = TextView(state.path),
            .alt_text = "Image preview unavailable", .bounds = body, .fit = .ImageFitContain,
            .tint = cast(u32)0xffffffff, .smooth = true}
        texture := ImageWidget.ImageTextureFor(image)
        if texture.width > 0 && texture.height > 0 {
            fit := body.width / cast(float32)texture.width
            if body.height / cast(float32)texture.height < fit { fit = body.height / cast(float32)texture.height }
            if fit > 1.0 { fit = 1.0 }
            state.fit_zoom = cast(s32)(fit * 100.0)
            if state.fit_zoom < 1 { state.fit_zoom = 1 }
            if state.zoom == 0 {
                image.bounds = .{body.x + (body.width - cast(float32)texture.width * fit) * 0.5,
                    body.y + (body.height - cast(float32)texture.height * fit) * 0.5,
                    cast(float32)texture.width * fit, cast(float32)texture.height * fit}
            }
        }
        if state.zoom > 0 && texture.width > 0 && texture.height > 0 {
            scale := cast(float32)state.zoom / 100.0
            width := body.width / scale
            height := body.height / scale
            if width > cast(float32)texture.width { width = cast(float32)texture.width }
            if height > cast(float32)texture.height { height = cast(float32)texture.height }
            if key == KeyLeft { state.pan_x -= 64.0 / scale }
            if key == KeyRight { state.pan_x += 64.0 / scale }
            if key == KeyUp { state.pan_y -= 64.0 / scale }
            if key == KeyDown { state.pan_y += 64.0 / scale }
            wheel := Input.PointerWheelTake(session, body) * 48.0 / scale
            if (modifiers & KeyModifierShift) != 0 { state.pan_x -= wheel }
            else { state.pan_y -= wheel }
            max_x := (cast(float32)texture.width - width) * 0.5
            max_y := (cast(float32)texture.height - height) * 0.5
            if state.pan_x < -max_x { state.pan_x = -max_x }
            if state.pan_x > max_x { state.pan_x = max_x }
            if state.pan_y < -max_y { state.pan_y = -max_y }
            if state.pan_y > max_y { state.pan_y = max_y }
            image.source = .{max_x + state.pan_x, max_y + state.pan_y, width, height}
            image.bounds = .{body.x + (body.width - width * scale) * 0.5,
                body.y + (body.height - height * scale) * 0.5, width * scale, height * scale}
        }
        node := BoxWidget.Draw(session, BoxWidget.Props.{.key = cast(u64)92, .bounds = body,
            .fill = ColorFromPacked(host.palette.base)})
        if node >= 0 && TreePushScope(session, node) {
            TreeSetChildClip(session, node, body)
            ImageWidget.Draw(session, image)
            End(session)
        }
        dimensions: Vec(u8)
        BuilderPrint(*dimensions, "% × % pixels", texture.width, texture.height)
        description := TextView(dimensions[:])
        if texture.width <= 0 || texture.height <= 0 {
            description = "Image preview unavailable. Choose Open to try its default application."
        }
        TextWidget.Draw(session, TextWidget.Props.{.key = cast(u64)93,
            .bounds = .{body.x, viewport.y + viewport.height - 54.0, body.width, 22.0},
            .text = description, .size = 13})
    } else if state.kind == .Text {
        DrawPreviewText(host, session, body, key, modifiers, focused)
    } else {
        message := "No built-in preview for this file. Choose Open to use its default application."
        if state.kind == .Error { message = TextView(state.body) }
        TextWidget.Draw(session, TextWidget.Props.{.key = cast(u64)94, .bounds = body,
            .text = message, .size = 16})
    }
    if state.kind != .Image && state.info.kind != .Missing {
        modified: [32]u8
        date := Calendar.FormatDateTime(DateTime.LocalAt(state.info.modified), "%Y-%m-%d %H:%M:%S", modified[:])
        metadata: Vec(u8)
        BuilderPrint(*metadata, "% bytes · Modified %", state.info.size, date)
        TextWidget.Draw(session, TextWidget.Props.{.key = cast(u64)96,
            .bounds = .{body.x, viewport.y + viewport.height - 54.0, body.width, 22.0},
            .text = TextView(metadata[:]), .size = 13, .wrap = .TextWrapEllipsis})
    }
    help := "Open uses the default application · Esc closes preview"
    if state.kind == .Image { help = "Fit / 100% / + − · arrows and wheel pan when zoomed · PgUp/PgDn browse · Esc closes" }
    if state.kind == .Text && state.truncated { help = "Preview limited to 64 KiB · Open to read the complete file · Esc closes" }
    if manager.error != "" { help = manager.error }
    help_caption: Text = FileDisplay.Caption(help)
    TextWidget.Draw(session, TextWidget.Props.{.key = cast(u64)95,
        .bounds = .{viewport.x + 8.0, viewport.y + viewport.height - 28.0, viewport.width - 16.0, 22.0},
        .text = TextView(help_caption), .size = 13, .wrap = .TextWrapEllipsis})
}

#scope_export
DrawPaneBody :: (host: *Host, session: Session, bounds: Rectangle, pane_index: s32,
    key: s32, modifiers: s32, enabled: bool) {
    manager := PaneManager(host, pane_index)
    node := BoxWidget.Draw(session, BoxWidget.Props.{.key = cast(u64)(550 + pane_index), .bounds = bounds})
    if node < 0 || !TreePushScope(session, node) { return }
    defer { End(session) }
    TreeSetChildClip(session, node, bounds)
    list := bounds
    if host.split {
        active := pane_index == host.active_pane
        BoxWidget.Draw(session, BoxWidget.Props.{.key = cast(u64)549,
            .bounds = .{bounds.x, bounds.y, bounds.width, 3.0},
            .fill = ColorFromPacked(ifx active then host.palette.text else host.palette.base)})
        // Each pane owns its strip; global actions and location stay shared.
        if DrawTabs(host, session, .{bounds.x, bounds.y + 5.0, bounds.width - 36.0, 32.0},
            enabled, ifx active then key else 0, ifx active then modifiers else 0, pane_index) { key = 0 }
        if Button(host, session, 15, "+", .{bounds.x + bounds.width - 32.0, bounds.y + 5.0, 32.0, 32.0}, enabled) {
            unused ActivatePane(host, pane_index)
            unused Model.NewTab(manager)
        }
        list.y += 42.0; list.height -= 42.0
    }
    if list.width < 1.0 || list.height < 1.0 { return }
    if manager.view_mode == .ViewList { DrawDetails(host, session, list, key, modifiers, enabled, pane_index) }
    else { DrawFileGrid(host, session, list, key, modifiers, enabled, pane_index) }
}

RefreshTheme :: (host: *Host) {
    now := DateTime.UnixMilliseconds()
    if host.palette_loaded && now >= host.palette_ms && now - host.palette_ms < 1000 { return }
    colors := SystemTheme.SystemPaletteRead()
    host.palette = Palettes.WidgetPalette.{.background = colors.background,
        .base = colors.base, .text = colors.text, .selected = colors.selected,
        .selected_text = colors.selected_text, .border = colors.border,
        .danger = colors.danger, .warning = colors.warning, .success = colors.success}
    host.palette_ms = now
    host.palette_loaded = true
}

DrawNativeChrome :: (host: *Host, session: Session, viewport: Rectangle, path: Rectangle, focused: bool, key: s32) {
    p := *host.paint
    manager := ActiveManager(host)
    menu_height:=Native.MenuHeight()
    if !host.menubar_hidden {
    Native.Surface(p,.{viewport.x,viewport.y,viewport.width,menu_height},"menubar")
    labels: [6]string = .["File","Edit","View","Go","Bookmarks","Help"]
    x := viewport.x
    for i: 0..5 {
        width:=Native.MenuWidth(cast(s32)i)
        pointer:=Input.PointerSample(session)
        if focused && host.actions_open && (pointer.x!=host.menu_pointer.x || pointer.y!=host.menu_pointer.y) && pointer.x>=x && pointer.x<x+width && pointer.y>=viewport.y && pointer.y<viewport.y+menu_height && host.menu_index!=i+1 {
            host.menu_index=cast(s32)i+1; host.menu_cursor=0
            host.menu_pointer=.{pointer.x,pointer.y}
        }
        if Native.Control(p,cast(u64)(600+i),.{x,viewport.y,width,menu_height},labels[i],"",focused,host.actions_open && host.menu_index==i+1,false,true) {
            open := !host.actions_open || host.menu_index != i+1
            host.actions_open=open; host.menu_index=cast(s32)i+1
            if open { host.menu_cursor=0; host.menu_pointer=.{pointer.x,pointer.y}; CapturePopupOwner(host) }
        }
        x += width
    }
    }
    Native.Surface(p,.{viewport.x,viewport.y+menu_height,viewport.width,Native.ToolbarHeight()},"toolbar")
    icons: [4]string = .["go-previous-symbolic","go-next-symbolic","go-up-symbolic","go-home-symbolic"]
    navigation_labels: [4]string=.["Back","Forward","Up","Home"]
    navigation_keys: [4]u64=.[1,616,2,3]
    for i: 0..3 {
        enabled := focused && manager.prompt == .PromptNone
        if i == 0 { enabled = enabled && manager.back.count > 0 }
        if i == 1 { enabled = enabled && manager.forward.count > 0 }
        if Native.Control(p,navigation_keys[i],Native.ToolbarItem(viewport,cast(s32)i),navigation_labels[i],icons[i],enabled,false,false,true) {
            if i == 0 { unused Model.NavigateBack(manager) }
            else if i == 1 { unused Model.NavigateForward(manager) }
            else if i == 2 { unused Model.NavigateUp(manager) }
            else { unused Model.OpenPathTracked(manager,Model.HomePath()) }
        }
    }
    if manager.prompt != .PromptLocation && host.pathbar && !Model.IsUri(manager.cwd) { DrawLocationBreadcrumb(host,session,path,focused,key) }
    if manager.prompt != .PromptLocation && (!host.pathbar || Model.IsUri(manager.cwd)) {
        Native.Surface(p,path,"entry")
        location_text: Vec(u8)
        unused BuilderAppend(location_text,manager.cwd)
        if !host.location_without_slash && manager.cwd!="" && manager.cwd[manager.cwd.count-1]!=#char "/" { unused BuilderAppend(location_text,"/") }
        caption: Text = FileDisplay.Caption(TextView(location_text[:]))
        if ButtonWidget.Draw(session,ButtonWidget.Props.{.key=cast(u64)226,.bounds=path,.label=TextView(caption),.invisible=true,.disabled= !focused}) == 1 { OpenPrompt(host,.PromptLocation) }
        location_icon:=Native.LocationIcon(path)
        if Model.IsUri(manager.cwd) { Native.Icon(p,location_icon,ifx manager.cwd=="computer:///" then "computer" else ifx manager.cwd=="recent:///" then "document-open-recent" else "network-workgroup") }
        else { Native.FileIcon(p,location_icon,manager.cwd) }
        Native.Label(p,Native.LocationText(path),TextView(caption),"entry")
    }
    if Native.Control(p,cast(u64)614,Native.ToolbarItem(viewport,0,true),"Search","system-search-symbolic",focused,false,false,true) { OpenPrompt(host,.PromptSearch) }
    status := NativeStatusBounds(host,viewport)
    Native.Surface(p,status,"statusbar")
    message: Vec(u8)
    if manager.error != "" { caption: Text=FileDisplay.Caption(manager.error); unused BuilderAppend(message,TextView(caption)) }
    else {
        now:=DateTime.UnixMilliseconds()
        path_key:=Model.PathKey(manager.cwd)
        if host.free_path!=path_key || now<host.free_ms || now-host.free_ms>=1000 {
            host.free_bytes=ifx Model.IsUri(manager.cwd) then -1 else Gtk.GtkFileSystemFree(manager.cwd); host.free_path=path_key; host.free_ms=now
        }
        unused Status.Append(manager,host.free_bytes,*message)
    }
    Native.StatusLabel(p,status,TextView(message[:]),manager.error!="")
    node:=TreeSubmitCurrent(session,ifx manager.error!="" then cast(u64)21 else cast(u64)242,cast(s32)WidgetKindText,status)
    TreeSetLabel(session,node,TextView(message[:]))
    VecFree(message)
}

NativeStatusBounds :: (host: *Host, viewport: Rectangle) -> Rectangle {
    manager:=ActiveManager(host)
    height: float32=Native.StatusHeight()
    if manager.prompt==.PromptLocation && viewport.width<520.0 { height=48.0 }
    else if manager.error!="" {
        if viewport.width<520.0 { height=44.0 }
        nodes:=Native.Nodes("label")
        caption: Text=FileDisplay.Caption(manager.error)
        metrics:=Gtk.GtkTextMeasure(nodes[:],TextView(caption),cast(s32)(viewport.width-190.0),1)
        if metrics.available && cast(float32)metrics.height+8.0>height { height=cast(float32)metrics.height+8.0 }
    }
    left: float32=ifx host.sidebar_hidden then 0.0 else 170.0+Native.PaneSeparatorWidth()
    return .{viewport.x+left,viewport.y+viewport.height-height,viewport.width-left,height}
}

DrawNativePlaces :: (host: *Host, session: Session, sidebar: Rectangle, focused: bool) {
    p := *host.paint; manager := ActiveManager(host)
    Native.Surface(p,sidebar,"sidebar")
    now := DateTime.UnixMilliseconds()
    if manager.prompt != .PromptBookmarkRename && (now < host.bookmarks_ms || now-host.bookmarks_ms >= 1000) {
        refreshed := Bookmarks.Refresh(*host.bookmarks)
        if refreshed > 0 { host.bookmark_selected= -1 }
        if refreshed < 0 { BookmarkResult(host,false) }
        host.bookmarks_ms=now
    }
    if now<host.mounts_ms || now-host.mounts_ms>=1000 {
        unused DesktopLocations.OpenMounts(*host.mounts); host.mounts_ms=now
        icon: Text=DesktopLocations.IconForUri("trash:///")
        if icon.bytes.count>0 { VecSwap(host.trash_icon.bytes,icon.bytes) }
        VecFree(icon.bytes)
    }
    desktop:=Gtk.GtkUserDirectory(0)
    has_desktop:=desktop!="" && desktop!=Model.HomePath() && TabPaths.PathQuery(desktop).info.kind==.Directory
    route_key:=Model.PathKey(manager.cwd)
    if host.places_route!=route_key {
        host.places_route=route_key; host.places_key=0; host.location_without_slash=false
        if manager.cwd==Model.HomePath() { host.places_key=31 }
        else if has_desktop && manager.cwd==desktop { host.places_key=37 }
        else if manager.cwd=="/" { host.places_key=32 }
        else if manager.cwd==Model.TrashDirectory(false) { host.places_key=33 }
        else if manager.cwd=="computer:///" { host.places_key=34 }
        else if manager.cwd=="recent:///" { host.places_key=35 }
        else if manager.cwd=="network:///" { host.places_key=36 }
        else {
            for i: cast(s32)0..cast(s32)host.bookmarks.document.rows.count-1 {
                if manager.cwd==host.bookmarks.document.rows[i].path { host.places_key=cast(u64)(700+i); break }
            }
            for mount: host.mounts.entries {
                if manager.cwd==mount.local_path || manager.cwd==mount.uri { host.places_key=mount.key; break }
            }
        }
    }
    heading_height:=Native.PlacesHeadingHeight(); row_height:=Native.PlacesRowHeight()
    total:=cast(s32)(heading_height*3.0+cast(float32)(6+cast(s64)has_desktop+host.bookmarks.document.rows.count+host.mounts.entries.count)*row_height)
    scroll:=ScrollWidget.Draw(session,ScrollWidget.Props.{.key=cast(u64)206,.bounds=sidebar,.content_height=total,
        .scroll_offset=host.bookmark_scroll,.manual_scroll=true})
    host.bookmark_scroll=scroll.scroll_offset
    if !scroll.opened { return }
    saved_clip:=p.clip; p.clip=sidebar
    y:=sidebar.y-cast(float32)host.bookmark_scroll
    Native.Heading(p,.{sidebar.x+10.0,y,sidebar.width-20.0,heading_height},"<b>Places</b>")
    y+=heading_height
    width:=scroll.content.width
    if Native.Control(p,cast(u64)34,.{sidebar.x,y,width,row_height},"Computer","computer",focused,host.places_key==34,true) { OpenPlace(host,"computer:///",34) }
    PlaceRow(host,session,.{sidebar.x,y,width,row_height},"computer:///",.Special,-1,34,focused)
    y+=row_height
    home: Text = FileDisplay.Caption(TabPaths.PathName(Model.HomePath()))
    if Native.Control(p,cast(u64)31,.{sidebar.x,y,width,row_height},TextView(home),"go-home",focused,host.places_key==31,true) { OpenPlace(host,Model.HomePath(),31) }
    PlaceRow(host,session,.{sidebar.x,y,width,row_height},Model.HomePath(),.Folder,-1,31,focused)
    VecFree(home.bytes); y+=row_height
    if has_desktop {
        if Native.Control(p,cast(u64)37,.{sidebar.x,y,width,row_height},"Desktop","user-desktop",focused,host.places_key==37,true) { OpenPlace(host,desktop,37) }
        PlaceRow(host,session,.{sidebar.x,y,width,row_height},desktop,.Folder,-1,37,focused)
        y+=row_height
    }
    if Native.Control(p,cast(u64)35,.{sidebar.x,y,width,row_height},"Recent","document-open-recent",focused,host.places_key==35,true) { OpenPlace(host,"recent:///",35) }
    PlaceRow(host,session,.{sidebar.x,y,width,row_height},"recent:///",.Folder,-1,35,focused)
    y+=row_height
    if Native.Control(p,cast(u64)33,.{sidebar.x,y,width,row_height},"Trash","user-trash",focused,host.places_key==33,true,false,TextView(host.trash_icon)) { OpenPlace(host,Model.TrashDirectory(false),33) }
    trash_route: Text=Model.TrashDirectory(false)
    PlaceRow(host,session,.{sidebar.x,y,width,row_height},TextView(trash_route),.Special,-1,0,focused)
    y+=row_height
    for i: cast(s32)0..cast(s32)host.bookmarks.document.rows.count-1 {
        row:=host.bookmarks.document.rows[i]
        if Native.Control(p,cast(u64)(700+i),.{sidebar.x,y,width,row_height},row.caption,"folder",focused,host.places_key==cast(u64)(700+i),true,false,row.path,true) {
            host.bookmark_selected=i; OpenPlace(host,row.path,cast(u64)(700+i))
        }
        PlaceRow(host,session,.{sidebar.x,y,width,row_height},row.path,.Bookmark,i,cast(u64)(700+i),focused)
        y+=row_height
    }
    Native.Heading(p,.{sidebar.x+10.0,y,sidebar.width-20.0,heading_height},"<b>Devices</b>")
    y+=heading_height
    if Native.Control(p,cast(u64)32,.{sidebar.x,y,width,row_height},"File System","drive-harddisk",focused,host.places_key==32,true) { OpenPlace(host,"/",32) }
    PlaceRow(host,session,.{sidebar.x,y,width,row_height},"/",.Folder,-1,32,focused)
    y+=row_height
    for mount: host.mounts.entries {
        route:=ifx mount.local_path!="" then mount.local_path else mount.uri
        caption: Text=FileDisplay.Caption(mount.caption)
        if Native.Control(p,mount.key,.{sidebar.x,y,width,row_height},TextView(caption),"drive-removable-media",focused,host.places_key==mount.key,true,false,mount.icon_serialized) { OpenPlace(host,route,mount.key) }
        PlaceRow(host,session,.{sidebar.x,y,width,row_height},route,.Device,-1,mount.key,focused)
        y+=row_height
    }
    Native.Heading(p,.{sidebar.x+10.0,y,sidebar.width-20.0,heading_height},"<b>Network</b>")
    y+=heading_height
    if Native.Control(p,cast(u64)36,.{sidebar.x,y,width,row_height},"Browse Network","network-workgroup",focused,host.places_key==36,true) { OpenPlace(host,"network:///",36) }
    PlaceRow(host,session,.{sidebar.x,y,width,row_height},"network:///",.Special,-1,36,focused)
    p.clip=saved_clip
    End(session)
}

OpenPlace :: (host: *Host, route: string, key: u64) {
    manager:=ActiveManager(host)
    if !Model.OpenPathTracked(manager,route) { return }
    Model.ClearSelection(manager)
    host.places_route=Model.PathKey(manager.cwd); host.places_key=key
    host.location_without_slash=true
}

ConfirmDelete :: (host: *Host) {
    manager:=ActiveManager(host)
    count:=Model.SelectedCount(manager)
    if count==0 { return }
    if !VecResize(host.delete_keys,cast(s64)count) || !VecResize(host.delete_identities,cast(s64)count) {
        Model.SetError(manager,"Cannot retain files for deletion"); return
    }
    at: s32
    for i: cast(s32)0..cast(s32)manager.entries.count-1 {
        if !manager.selected[i] { continue }
        host.delete_keys[at]=manager.entries[i].key
        host.delete_identities[at]=manager.entries[i].info
        at+=1
    }
    OpenPrompt(host,.PromptDelete)
    host.field.focused=false
}

FinishDelete :: (host: *Host) {
    manager:=ActiveManager(host)
    valid:=ModalOwnerValid(host) && Model.SelectedCount(manager)==host.delete_keys.count
    at: s32
    for i: cast(s32)0..cast(s32)manager.entries.count-1 {
        if !manager.selected[i] { continue }
        actual:=TabPaths.PathQuery(manager.entries[i].path)
        if at>=host.delete_keys.count { valid=false; break }
        if host.delete_keys[at]!=manager.entries[i].key || !actual.valid || !Model.SamePathIdentity(host.delete_identities[at],actual.info) { valid=false }
        at+=1
    }
    manager.prompt=.PromptNone
    if !valid { Model.SetError(manager,"Selected files changed; deletion canceled"); return }
    unused Model.DeleteSelection(manager,false)
    RefreshOtherPane(host)
}

OpenInfoFor :: (host: *Host, path: string) {
    if path=="" { OpenInfo(host,true); return }
    if !CaptureModalOwner(host) { return }
    host.info_open=true; host.info_title="Properties"
    VecClear(host.info_body)
    host.actions_open=false; host.breadcrumb_open=false
    caption: Text=FileDisplay.Caption(path)
    info:=TabPaths.PathQuery(path)
    content: Text=MenuContentType(path)
    BuilderPrint(*host.info_body,"Location: %\nType: %\nSize: %\nOwner UID: %\n",TextView(caption),TextView(content),info.info.size,info.info.owner_uid)
    VecFree(caption.bytes)
}

OpenInfo :: (host: *Host, properties: bool) {
    if !CaptureModalOwner(host) { return }
    host.info_open=true; host.info_title=ifx properties then "Properties" else "Explorer Help"
    VecClear(host.info_body)
    host.actions_open=false; host.breadcrumb_open=false
    if !properties {
        unused BuilderAppend(host.info_body,"Navigate: Alt+Left/Right, Backspace, Alt+Up/Home\nLocation: Ctrl+L / Alt+D   Search: Ctrl+F\nCreate folder: Ctrl+Shift+N   Rename: F2\nTrash: Delete   Delete permanently: Shift+Delete\nUndo / Redo: Ctrl+Z / Ctrl+Shift+Z   Cut / Copy / Paste: Ctrl+X / C / V\nSelect all / pattern / invert: Ctrl+A / S / Shift+I\nViews: Ctrl+1/2/3   Zoom: Ctrl++ / − / 0\nSplit: F3   Sidebar: F9   Menubar: Ctrl+M\nTabs: Ctrl+T / W / Tab   Window: Ctrl+N / Q\nClose all Explorer windows: Ctrl+Shift+W\nProperties: Alt+Return   Menus: F10 / Alt+letter\nEsc closes an editor, menu, preview or this dialog.")
        return
    }
    manager:=ActiveManager(host)
    row:=Model.FirstSelected(manager)
    path:=ifx row>=0 then Model.EntryPath(manager,row) else manager.cwd
    caption: Text=FileDisplay.Caption(path)
    BuilderPrint(*host.info_body,"Location: %\nSelected: %\n",TextView(caption),Model.SelectedCount(manager))
    if row>=0 && row<manager.entries.count {
        data: DetailsCells
        DetailsData(manager,row,*data)
        BuilderPrint(*host.info_body,"Name: %\nType: %\nSize: %\nModified: %\nOwner UID: %\n",data.cells[0],data.cells[2],data.cells[1],data.cells[3],manager.entries[row].info.owner_uid)
    }
    VecFree(caption.bytes)
}

ChangeZoom :: (host: *Host, direction: s32) {
    manager:=ActiveManager(host); view:=ActiveView(host)
    mode:=cast(s32)manager.view_mode
    level:=ifx direction==0 then 3 else view.zoom[mode]+direction
    if level<0 { level=0 }; if level>11 { level=11 }
    view.zoom[mode]=level; view.columns_signature=0; manager.reveal_focus=true
}

RequestWindow :: (host: *Host, path: string) {
    next: Text=TextCopy(path)
    if next.bytes.count!=path.count { Model.SetError(ActiveManager(host),"Cannot retain new window location"); return }
    if host.window_queue.count==0 { VecClear(host.window_path.bytes); unused BuilderAppend(host.window_path.bytes,path) }
    unused VecPush(host.window_queue,next)
    host.window_requested=true
}

// The next queued window folder; the standalone app opens one per call.
TakeWindowRequest :: (host: *Host, output: *Text) -> bool {
    if host.window_queue.count==0 { host.window_requested=false; return false }
    VecClear(output.bytes)
    unused BuilderAppend(output.bytes,TextView(host.window_queue[0]))
    for i: cast(s64)1..host.window_queue.count-1 { VecSwap(host.window_queue[i-1].bytes,host.window_queue[i].bytes) }
    unused VecResize(host.window_queue,host.window_queue.count-1)
    host.window_requested=host.window_queue.count>0
    return true
}

BookmarkSelection :: (host: *Host) {
    manager:=ActiveManager(host)
    if Model.SelectedCount(manager)==0 {
        BookmarkResult(host,Bookmarks.Add(*host.bookmarks,manager.cwd))
        host.bookmark_selected=Bookmarks.Find(*host.bookmarks,manager.cwd)
        return
    }
    for i: cast(s32)0..cast(s32)manager.entries.count-1 {
        if manager.selected[i] && Model.EntryIsDirectory(manager,i) {
            path:=Model.EntryPath(manager,i)
            if !Bookmarks.Add(*host.bookmarks,path) { BookmarkResult(host,false); return }
            host.bookmark_selected=Bookmarks.Find(*host.bookmarks,path)
        }
    }
}

MenuShortcut :: (menu: s32, item: s32) -> string {
    if menu==1 {
        if item==0 { return "Ctrl+Shift+N" }
        if item==2 { return "Ctrl+T" }; if item==3 { return "Ctrl+W" }
        if item==4 { return "F2" }; if item==5 { return "Delete" }; if item==7 { return "Ctrl+P" }
    } else if menu==2 {
        if item==0 { return "Ctrl+Z" }; if item==1 { return "Ctrl+Shift+Z" }
        if item==2 { return "Ctrl+X" }; if item==3 { return "Ctrl+C" }
        if item==4 { return "Ctrl+V" }; if item==5 { return "Ctrl+A" }
        if item==8 { return "Ctrl+S" }; if item==9 { return "Ctrl+Shift+I" }
    } else if menu==3 {
        if item==0 { return "Ctrl+1" }; if item==1 { return "Ctrl+2" }; if item==2 { return "Ctrl+3" }
        if item==3 { return "Ctrl+H" }; if item==4 { return "Ctrl+B" }; if item==5 { return "Ctrl+E" }
        if item==6 { return "F3" }; if item==7 { return "Tab" }; if item==8 { return "F5" }
    } else if menu==4 {
        if item==0 { return "Alt+Left" }; if item==1 { return "Alt+Right" }; if item==2 { return "Alt+Up" }
        if item==3 { return "Alt+Home" }; if item==5 { return "Ctrl+L" }; if item==6 { return "Ctrl+F" }
    } else if menu==5 && item==0 { return "Ctrl+D" }
    return ""
}

// Global actions yield to text editors, previews and popup navigation.
DispatchShortcut :: (host: *Host, session: Session, key: s32, modifiers: s32) -> bool {
    manager:=ActiveManager(host); view:=ActiveView(host)
    if key==0 || manager.prompt!=.PromptNone || host.preview.opened || host.breadcrumb_open || host.info_open ||
        host.context_view.open || host.chooser_open { return false }
    control: s32=KeyModifierControl; shift: s32=KeyModifierShift; alt: s32=KeyModifierAlt
    if modifiers==alt && (key==70 || key==69 || key==86 || key==71 || key==66 || key==72) {
        host.menu_index=ifx key==70 then 1 else ifx key==69 then 2 else ifx key==86 then 3 else ifx key==71 then 4 else ifx key==66 then 5 else 6
        host.menubar_hidden=false; host.actions_open=true; host.menu_cursor=0; CapturePopupOwner(host); return true
    }
    if host.actions_open { return false }
    if key==299 && modifiers==0 { host.menubar_hidden=false; host.actions_open=true; host.menu_index=1; host.menu_cursor=0; CapturePopupOwner(host); return true }
    if (modifiers==control || modifiers==control+shift) && (key==43 || key==61 || key==334) { ChangeZoom(host,1); return true }
    if modifiers==control && (key==45 || key==333 || key==48 || key==320) { ChangeZoom(host,ifx key==48 || key==320 then 0 else -1); return true }
    if modifiers==alt {
        if key==KeyEnter { OpenInfo(host,true) }
        else if key==KeyLeft { unused Model.NavigateBack(manager) }
        else if key==KeyRight { unused Model.NavigateForward(manager) }
        else if key==KeyUp { unused Model.NavigateUp(manager) }
        else if key==KeyHome { unused Model.OpenPathTracked(manager,Model.HomePath()) }
        else if key==68 { view.tree_focused=false; OpenPrompt(host,.PromptLocation) }
        else { return false }
        return true
    }
    if modifiers==0 {
        if key==290 { OpenInfo(host,false) }
        else if key==KeyDelete { unused Model.DeleteSelection(manager,true); RefreshOtherPane(host) }
        else if key==291 { OpenPrompt(host,.PromptRename) }
        else if key==294 { unused Model.Refresh(manager) }
        else if key==298 { host.sidebar_hidden= !host.sidebar_hidden }
        else if key==KeyBackspace { unused Model.NavigateBack(manager) }
        else if key==KeyEscape { Model.ClearSelection(manager) }
        else if key==KeyTab && host.split { RequestPane(host,1-host.active_pane) }
        else { return false }
        return true
    }
    if modifiers==shift {
        if key==299 { KeyboardContext(host) }
        else if key==KeyDelete { ConfirmDelete(host) }
        else if key==KeyInsert { unused PasteFiles(host) }
        else { return false }; return true
    }
    if modifiers==control+shift {
        if key==90 { unused Model.Redo(manager); RefreshOtherPane(host) }
        else if key==78 { OpenPrompt(host,.PromptFolder) }
        else if key==87 { host.quit_all_requested=true }
        else if key==79 {
            row:=Model.FirstSelected(manager)
            if Model.EntryIsDirectory(manager,row) { RequestWindow(host,Model.EntryPath(manager,row)) }
        }
        else if key==73 {
            for i: cast(s32)0..cast(s32)manager.selected.count-1 { manager.selected[i]= !manager.selected[i] }
        } else if key==80 {
            row:=Model.FirstSelected(manager)
            if Model.EntryIsDirectory(manager,row) { unused Model.NewTab(manager,Model.EntryPath(manager,row)) }
        } else if key==KeyTab { unused Model.SwitchTab(manager,cast(s32)((manager.active_tab+manager.tabs.count-1)%manager.tabs.count)) }
        else if key==KeyPageUp || key==KeyPageDown { unused Model.ReorderTab(manager,manager.active_tab,manager.active_tab+ifx key==KeyPageUp then -1 else 1) }
        else { return false }; return true
    }
    if modifiers!=control { return false }
    if key==90 { unused Model.Undo(manager); RefreshOtherPane(host) }
    else if key==69 { host.sidebar_hidden= !host.sidebar_hidden && view.tree_mode; TreeMode(host,true) }
    else if key==66 { host.sidebar_hidden= !host.sidebar_hidden && !view.tree_mode; TreeMode(host,false) }
    else if key==76 { view.tree_focused=false; OpenPrompt(host,.PromptLocation) }
    else if key==70 { OpenPrompt(host,.PromptSearch) }
    else if key==84 { unused Model.NewTab(manager) }
    else if key==78 { RequestWindow(host,manager.cwd) }
    else if key==81 { host.quit_requested=true }
    else if key==87 { if manager.tabs.count==1 { host.quit_requested=true } else { unused Model.CloseTab(manager,manager.active_tab) } }
    else if key==KeyTab { Model.NextTab(manager) }
    else if key==KeyPageUp || key==KeyPageDown { unused Model.SwitchTab(manager,cast(s32)((manager.active_tab+manager.tabs.count+ifx key==KeyPageUp then -1 else 1)%manager.tabs.count)) }
    else if key==65 { Model.SelectAll(manager) }
    else if key==83 { OpenPrompt(host,.PromptSelectPattern) }
    else if key==67 || key==KeyInsert { unused FileClipboard.Copy(*host.file_clipboard,manager,false) }
    else if key==88 { unused FileClipboard.Copy(*host.file_clipboard,manager,true) }
    else if key==86 { unused PasteFiles(host) }
    else if key==72 { manager.show_hidden= !manager.show_hidden; unused Model.Refresh(manager) }
    else if key==77 { host.menubar_hidden= !host.menubar_hidden }
    else if key==82 { unused Model.Refresh(manager) }
    else if key==79 { ActivateEntry(host,Model.FirstSelected(manager)) }
    else if key==68 { BookmarkSelection(host) }
    else if key>=49 && key<=51 { view.tree_focused=false; Model.SetView(manager,ifx key==49 then .ViewIcon else ifx key==50 then .ViewList else .ViewCompact) }
    else { return false }
    return true
}

// Thunar context menus ------------------------------------------------------

RequestContext :: (host: *Host, kind: MenuKind, side: MenuSide, pane: s32, x: float32, y: float32,
    path: string = "", index: s32 = -1) {
    if PaneLocked(host) || host.chooser_open || host.drag.active { return }
    host.request.pending = true; host.request.kind = kind; host.request.side = side
    host.request.pane = pane; host.request.x = x; host.request.y = y; host.request.index = index
    VecClear(host.request.path.bytes)
    unused BuilderAppend(host.request.path.bytes, path)
}

CloseContextMenu :: (host: *Host) {
    MenuViewClose(*host.context_view)
    FileMenuRelease(*host.context_menu)
    VecFree(host.context_paths)
    VecClear(host.context_current.bytes)
}

ContextViews :: (host: *Host, output: *Vec(string)) {
    VecClear(output.*)
    for * path: host.context_paths { unused VecPush(output.*, TextView(path.*)) }
}

OpenContextMenu :: (host: *Host, session: Session) {
    host.request.pending = false
    CloseContextMenu(host)
    if host.request.pane != host.active_pane { unused ActivatePane(host, host.request.pane) }
    manager := ActiveManager(host); view := ActiveView(host)
    host.context_kind = host.request.kind; host.context_side = host.request.side
    host.context_pane = host.active_pane; host.context_index = host.request.index
    if host.request.kind == .View {
        for index: cast(s32)0..cast(s32)manager.entries.count - 1 {
            if manager.selected[index] { unused VecPush(host.context_paths, TextCopy(manager.entries[index].path)) }
        }
        unused BuilderAppend(host.context_current.bytes, manager.cwd)
    } else {
        unused VecPush(host.context_paths, TextCopy(TextView(host.request.path)))
        // A side-pane row is its own folder; the tree keeps the window's folder.
        unused BuilderAppend(host.context_current.bytes, ifx host.request.kind == .Tree then manager.cwd else TextView(host.request.path))
    }
    views: Vec(string)
    defer VecFree(views)
    ContextViews(host, *views)
    trash: Text = Model.TrashDirectory(false)
    devices: Vec(MenuDevice)
    defer VecFree(devices)
    for mount: host.mounts.entries {
        if mount.local_path != "" { unused VecPush(devices, MenuDevice.{mount.caption, mount.local_path}) }
    }
    context: MenuContext
    context.kind = host.request.kind; context.side = host.request.side
    context.selection = views[:]
    context.current = TextView(host.context_current)
    context.window_folder = manager.cwd
    context.trash_folder = TextView(trash)
    context.view_mode = manager.view_mode; context.sort_mode = manager.sort_mode
    context.sort_reverse = manager.sort_reverse
    context.zoom = ThunarZoomLevel(host, view, manager.view_mode); context.zoom_levels = 12
    context.can_paste = FileClipboard.CanPaste(*host.file_clipboard)
    context.searching = manager.search_active
    context.shortcut_pane = !host.sidebar_hidden && !view.tree_mode
    context.devices = devices[:]
    context.device_mounted = host.request.side == .Device
    if !FileMenuBuild(*host.context_menu, *context) {
        Model.SetError(manager, "The context menu could not be prepared"); FileMenuRelease(*host.context_menu); return
    }
    pointer := Input.PointerSample(session)
    MenuViewOpen(*host.context_view, host.request.x, host.request.y, .{pointer.x, pointer.y})
    CapturePopupOwner(host)
}

// Thunar's zoom level (16 px … 1024 px) for the view's actual icon size, which
// decides when Zoom In and Zoom Out are available.
ThunarZoomLevel :: (host: *Host, view: *PaneView, mode: Model.ViewMode) -> s32 {
    size: s32 = ZoomIcon(view, mode)
    if view.zoom[cast(s32)mode] == 3 {
        if mode == .ViewList { size = cast(s32)Native.DetailsIconSize() }
        else if mode == .ViewCompact { size = 18 } else { size = 48 }
    }
    sizes: [12]s32 = .[16,24,32,48,64,96,128,160,192,256,512,1024]
    level: s32 = 0
    for index: cast(s32)0..11 { if sizes[index] <= size { level = index } }
    return level
}

// Shift+F10 opens the selection's menu, or the folder's when nothing is selected.
KeyboardContext :: (host: *Host) {
    manager := ActiveManager(host)
    x: float32 = 200.0; y: float32 = 120.0
    bounds := host.list_bounds[host.active_pane]
    if bounds.width > 0.0 { x = bounds.x + 24.0; y = bounds.y + 24.0 }
    RequestContext(host, .View, .None, host.active_pane, x, y)
}

ContextFolders :: (host: *Host, paths: []string, directories: *Vec(string), files: *Vec(string)) {
    for path: paths {
        if Model.IsUri(path) || TabPaths.PathQuery(path).info.kind == .Directory { unused VecPush(directories.*, path) }
        else { unused VecPush(files.*, path) }
    }
}

RunContextAction :: (host: *Host, index: s32) {
    manager := ActiveManager(host)
    menu := *host.context_menu
    if index < 0 || index >= menu.items.count { return }
    action := menu.items[index].action
    payload := menu.items[index].payload
    paths: Vec(string)
    defer VecFree(paths)
    ContextViews(host, *paths)
    current := TextView(host.context_current)
    view_menu := host.context_kind == .View
    // Side-pane and tree rows act on their folder; the view's background on its folder.
    targets: Vec(string)
    defer VecFree(targets)
    if paths.count > 0 { for path: paths { unused VecPush(targets, path) } } else { unused VecPush(targets, current) }
    changed := false
    if action == .Open {
        if !view_menu { unused Model.OpenPathTracked(manager, targets[0]); host.places_route = 0 }
        else {
            directories: Vec(string); files: Vec(string)
            ContextFolders(host, targets[:], *directories, *files)
            if directories.count == 1 { unused Model.OpenPathTracked(manager, directories[0]) }
            else { for directory: directories { unused Model.NewTab(manager, directory) } }
            if files.count > 0 && !MenuOpenDefaults(files[:]) { Model.SetError(manager, "The default application could not be started.") }
            VecFree(directories); VecFree(files)
        }
    } else if action == .OpenWithApp {
        if payload < 0 || payload >= menu.apps.count || !MenuLaunchApp(menu.apps[payload].app, targets[:]) {
            Model.SetError(manager, "The application could not be started.")
        }
    } else if action == .OpenWithDefaults || action == .Execute {
        ok := true
        for target: targets {
            single := string.[target]
            if action == .Execute && !Model.IsUri(target) && !(target.count > 8 && target[target.count - 8:] == ".desktop") {
                arguments := string.[target]
                ok = MenuSpawn(TabPaths.PathParent(target), arguments[:]) && ok
            } else { ok = MenuOpenDefaults(single[:]) && ok }
        }
        if !ok { Model.SetError(manager, "The application could not be started.") }
    } else if action == .EditLauncher {
        arguments := string.["exo-desktop-item-edit", targets[0]]
        if !MenuSpawn(TabPaths.PathParent(targets[0]), arguments[:]) { Model.SetError(manager, "The launcher editor could not be started.") }
    } else if action == .OpenInTab {
        for target: targets { unused Model.NewTab(manager, target) }
    } else if action == .OpenInWindow {
        for target: targets { RequestWindow(host, target) }
    } else if action == .OpenLocation {
        unused Model.OpenPathChecked(manager, TabPaths.PathParent(targets[0]), TabPaths.PathName(targets[0]))
    } else if action == .OpenWithOther || action == .SetDefaultApp {
        OpenChooser(host, targets[:], action == .SetDefaultApp)
    } else if action == .SendBookmark {
        for target: targets {
            if !Bookmarks.Add(*host.bookmarks, target) { BookmarkResult(host, false); break }
            host.bookmark_selected = Bookmarks.Find(*host.bookmarks, target)
        }
    } else if action == .SendDesktop {
        desktop := Gtk.GtkUserDirectory(0)
        if desktop == "" || desktop == Model.HomePath() {
            joined: Vec(u8); BuilderPrint(*joined, "%/Desktop", Model.HomePath())
            unused TabPaths.CreateDirectories(TextView(joined[:joined.count]))
            unused Model.TransferInto(manager, targets[:], TextView(joined[:joined.count]), 2, *changed)
            VecFree(joined)
        } else { unused Model.TransferInto(manager, targets[:], desktop, 2, *changed) }
    } else if action == .SendDevice {
        if payload >= 0 && payload < menu.devices.count { unused Model.TransferInto(manager, targets[:], TextView(menu.devices[payload]), 1, *changed) }
    } else if action == .SendApp {
        if payload < 0 || payload >= menu.handlers.count || !MenuLaunchApp(menu.handlers[payload].app, targets[:]) {
            Model.SetError(manager, "The Send To handler could not be started.")
        }
    } else if action == .Cut || action == .Copy {
        if view_menu { unused FileClipboard.Copy(*host.file_clipboard, manager, action == .Cut) }
        else { unused FileClipboard.CopyPaths(*host.file_clipboard, manager, targets[:], action == .Cut) }
    } else if action == .PasteIntoFolder {
        before := host.file_clipboard.changed
        unused FileClipboard.Paste(*host.file_clipboard, manager, targets[0])
        changed = host.file_clipboard.changed != before
    } else if action == .Paste {
        unused PasteFiles(host)
    } else if action == .Trash || action == .Delete {
        if view_menu {
            if action == .Trash { unused Model.DeleteSelection(manager, true); changed = true } else { ConfirmDelete(host) }
        } else if action == .Trash { unused Model.DeletePaths(manager, targets[:], true); changed = true }
        else { Model.SetError(manager, "Permanent deletion from the side pane is not available; use the file view") }
    } else if action == .EmptyTrash {
        if CaptureModalOwner(host) { manager.prompt = .PromptEmptyTrash; host.field.focused = false }
    } else if action == .Rename {
        if view_menu { OpenPrompt(host, .PromptRename) }
        else {
            VecClear(host.rename_path.bytes); unused BuilderAppend(host.rename_path.bytes, targets[0])
            OpenPrompt(host, .PromptRename)
        }
    } else if action == .BulkRename {
        arguments: Vec(string)
        unused VecPush(arguments, "thunar"); unused VecPush(arguments, "--bulk-rename")
        for target: targets { unused VecPush(arguments, target) }
        if !MenuSpawn(current, arguments[:]) { Model.SetError(manager, "The bulk renamer could not be started.") }
        VecFree(arguments)
    } else if action == .Restore || action == .RestoreShow {
        original: Text
        if action == .RestoreShow && targets.count > 0 {
            info: Text = Model.TrashInfoPath(targets[0])
            found: Text = Model.TrashOriginalPath(TextView(info))
            VecSwap(original.bytes, found.bytes)
        }
        if Model.RestoreSelection(manager) { changed = true }
        if action == .RestoreShow && original.bytes.count > 0 { unused Model.NewTab(manager, TabPaths.PathParent(TextView(original))) }
    } else if action == .RemoveRecent {
        for entry, n: manager.entries {
            if manager.selected[n] && !MenuRemoveRecent(ifx entry.uri != "" then entry.uri else entry.path) { Model.SetError(manager, "The item could not be removed from Recent") }
        }
        unused Model.Refresh(manager)
    } else if action == .Custom {
        if !MenuRunCustom(menu, payload) { Model.SetError(manager, "The custom action could not be started.") }
    } else if action == .Wallpaper {
        if !MenuSetWallpaper(targets[0], "", 0) { Model.SetError(manager, "The wallpaper could not be set.") }
    } else if action == .ExtractHere || action == .ExtractTo || action == .CreateArchive {
        name := ifx action == .ExtractHere then "extract-here" else ifx action == .ExtractTo then "extract-to" else "create"
        if !MenuRunArchive(menu, name) { Model.SetError(manager, "No suitable archive manager found") }
    } else if action == .Unmount || action == .Eject || action == .Mount {
        if !MenuUnmount(targets[0], action == .Eject) { Model.SetError(manager, "The device could not be unmounted.") }
    } else if action == .Properties {
        OpenInfoFor(host, ifx view_menu && paths.count > 0 then "" else targets[0])
    } else if action == .CreateFolder || action == .CreateEmpty || action == .CreateDocument {
        VecClear(host.prompt_folder.bytes); VecClear(host.prompt_template.bytes)
        folder := ifx host.context_kind == .Tree then targets[0] else current
        unused BuilderAppend(host.prompt_folder.bytes, folder)
        if action == .CreateDocument && payload >= 0 && payload < menu.templates.count {
            unused BuilderAppend(host.prompt_template.bytes, TextView(menu.templates[payload]))
        }
        OpenPrompt(host, ifx action == .CreateFolder then Model.PromptKind.PromptFolder else Model.PromptKind.PromptFile)
    } else if action == .SortName { Model.SetSort(manager, .SortName, manager.sort_reverse) }
    else if action == .SortSize { Model.SetSort(manager, .SortSize, manager.sort_reverse) }
    else if action == .SortType { Model.SetSort(manager, .SortType, manager.sort_reverse) }
    else if action == .SortModified { Model.SetSort(manager, .SortModified, manager.sort_reverse) }
    else if action == .SortAscending { Model.SetSort(manager, manager.sort_mode, false) }
    else if action == .SortDescending { Model.SetSort(manager, manager.sort_mode, true) }
    else if action == .SortReverse { Model.SetSort(manager, manager.sort_mode, !manager.sort_reverse) }
    else if action == .ZoomIn { ChangeZoom(host, 1) }
    else if action == .ZoomOut { ChangeZoom(host, -1) }
    else if action == .ZoomReset { ChangeZoom(host, 0) }
    else if action == .RemoveShortcut {
        if host.context_index >= 0 { BookmarkResult(host, Bookmarks.Edit(*host.bookmarks, host.context_index, 1)); host.bookmark_selected = -1 }
    } else if action == .RenameShortcut {
        if host.context_index >= 0 { host.bookmark_selected = host.context_index; OpenPrompt(host, .PromptBookmarkRename) }
    }
    if changed { RefreshOtherPane(host); unused Model.ReloadPreserving(manager) }
}

FinishEmptyTrash :: (host: *Host) {
    manager := ActiveManager(host)
    manager.prompt = .PromptNone
    // Thunar empties every filesystem's trash through GIO's trash:/// location.
    if !MenuEmptyTrash() { Model.SetError(manager, "The trash could not be emptied completely") }
    Model.CloseHistory(manager)
    unused Model.ReloadPreserving(manager)
    RefreshOtherPane(host)
}

DrawContextMenu :: (host: *Host, session: Session, viewport: Rectangle, focused: bool, key: s32) -> bool {
    if host.request.pending { OpenContextMenu(host, session) }
    if !host.context_view.open { return false }
    if !PopupOwnerValid(host) { CloseContextMenu(host); return false }
    result := DrawMenuView(*host.context_view, *host.context_menu, session, *host.paint, viewport, key, focused)
    if result.activated >= 0 { RunContextAction(host, result.activated) }
    if !host.context_view.open { CloseContextMenu(host) }
    return true
}

// The application chooser ---------------------------------------------------

OpenChooser :: (host: *Host, paths: []string, set_default: bool) {
    CloseChooser(host)
    for path: paths { unused VecPush(host.chooser_paths, TextCopy(path)) }
    if paths.count > 0 {
        content_type: Text = MenuContentType(paths[0])
        unused BuilderAppend(host.chooser_type.bytes, TextView(content_type))
    }
    host.chooser_recommended = ChooserApps(TextView(host.chooser_type), *host.chooser_apps)
    host.chooser_default = set_default
    host.chooser_remember = set_default
    host.chooser_selected = ifx host.chooser_apps.count > 0 then 0 else -1
    host.chooser_scroll = 0
    host.chooser_open = true
}

CloseChooser :: (host: *Host) {
    ReleaseApps(*host.chooser_apps)
    VecFree(host.chooser_items); VecFree(host.chooser_flags); VecFree(host.chooser_paths)
    VecClear(host.chooser_type.bytes)
    host.chooser_open = false
}

DrawChooser :: (host: *Host, session: Session, viewport: Rectangle, focused: bool, key: s32) {
    if !host.chooser_open { return }
    manager := ActiveManager(host)
    if focused && key == KeyEscape { CloseChooser(host); return }
    bounds := Rectangle.{viewport.x + (viewport.width - 520.0) * 0.5, viewport.y + (viewport.height - 480.0) * 0.5, 520.0, 480.0}
    BoxWidget.Draw(session, BoxWidget.Props.{.key = cast(u64)8300, .bounds = viewport})
    BoxWidget.Draw(session, BoxWidget.Props.{.key = cast(u64)8301, .bounds = bounds, .fill = ColorFromPacked(host.palette.base)})
    TextWidget.Draw(session, TextWidget.Props.{.key = cast(u64)8302, .bounds = .{bounds.x + 16.0, bounds.y + 12.0, bounds.width - 32.0, 24.0},
        .text = ifx host.chooser_default then "Set Default Application" else "Open With", .size = 16})
    if !VecResize(host.chooser_items, host.chooser_apps.count) || !VecResize(host.chooser_flags, host.chooser_apps.count) { return }
    for i: cast(s32)0..cast(s32)host.chooser_apps.count - 1 {
        host.chooser_items[i] = ListBox.ListBoxItem.{cast(u64)i + cast(u64)1, AppLabel(host.chooser_apps[i].app)}
        host.chooser_flags[i] = i == host.chooser_selected
    }
    list := Rectangle.{bounds.x + 16.0, bounds.y + 44.0, bounds.width - 32.0, bounds.height - 140.0}
    props := ListBox.ListBoxMultiProps.{.key = cast(u64)8303, .bounds = list, .row_height = 30,
        .anchor = host.chooser_selected, .scroll_offset = host.chooser_scroll, .focused = focused}
    props.scroll_delta = cast(s32)(-Input.PointerWheelTake(session, list) * 64.0)
    result := ListBox.ListBoxMulti(session, props, host.chooser_items[:], host.chooser_flags[:])
    host.chooser_scroll = result.scroll_offset
    if result.clicked_index >= 0 { host.chooser_selected = result.clicked_index }
    remember := ifx host.chooser_remember then "[x] Use as default for this kind of file" else "[ ] Use as default for this kind of file"
    if Button(host, session, 8304, remember, .{bounds.x + 16.0, bounds.y + bounds.height - 88.0, bounds.width - 32.0, 30.0}, focused && !host.chooser_default) {
        host.chooser_remember = !host.chooser_remember
    }
    if Button(host, session, 8305, "Cancel", .{bounds.x + bounds.width - 236.0, bounds.y + bounds.height - 46.0, 100.0, 32.0}, focused) {
        CloseChooser(host); return
    }
    confirm := ifx host.chooser_default then "Set Default" else "Open"
    if Button(host, session, 8306, confirm, .{bounds.x + bounds.width - 126.0, bounds.y + bounds.height - 46.0, 110.0, 32.0}, focused && host.chooser_selected >= 0) || (focused && key == KeyEnter && host.chooser_selected >= 0) {
        app := host.chooser_apps[host.chooser_selected].app
        if host.chooser_remember && !MenuSetDefault(app, TextView(host.chooser_type)) { Model.SetError(manager, "The default application could not be changed") }
        if !host.chooser_default {
            paths: Vec(string)
            for * path: host.chooser_paths { unused VecPush(paths, TextView(path.*)) }
            if !MenuLaunchApp(app, paths[:]) { Model.SetError(manager, "The application could not be started.") }
            VecFree(paths)
        }
        CloseChooser(host)
    }
}

// Dragging files ---------------------------------------------------------------

DragActive :: (host: *Host) -> bool { return host.drag.active }

// A press on an item can become a drag once it passes GTK's threshold.
TrackDrag :: (host: *Host, session: Session, pane: s32, hit: s32, body: Rectangle, focused: bool) {
    manager := PaneManager(host, pane)
    pointer := Input.PointerSample(session)
    inside := pointer.x >= body.x && pointer.x < body.x + body.width && pointer.y >= body.y && pointer.y < body.y + body.height
    if pointer.pressed && focused && inside && hit >= 0 && hit < manager.entries.count && !host.context_view.open {
        host.drag.candidate = true; host.drag.pane = pane; host.drag.index = hit
        host.drag.key = manager.entries[hit].key; host.drag.x = pointer.x; host.drag.y = pointer.y
    }
    if !pointer.down { host.drag.candidate = false; return }
    if !host.drag.candidate || host.drag.pane != pane || host.drag.active || !FileDrag.Exceeded(*host.drag, pointer.x, pointer.y) { return }
    index := host.drag.index
    if index < 0 || index >= manager.entries.count || manager.entries[index].key != host.drag.key { host.drag.candidate = false; return }
    // GTK selects an unselected item when its drag starts; the drag carries
    // the whole selection.
    if !manager.selected[index] { Model.SelectOne(manager, index) }
    paths := Model.SelectedPaths(manager)
    size := ifx manager.view_mode == .ViewList then cast(s32)Native.DetailsIconSize() else ZoomIcon(PaneViewAt(host, pane), manager.view_mode)
    if FileDrag.Begin(*host.drag, paths[:], size) {
        host.drag.source_pane = pane
        Input.TreePointerCancel(session)
        PaneViewAt(host, pane).last_click_ms = 0
    } else { host.drag.candidate = false }
    VecFree(paths)
}

RecordDropRow :: (host: *Host, bounds: Rectangle, path: string, pane: s32, key: u64, folder: bool) {
    if !host.drag.active { return }
    row: DropRow
    row.bounds = bounds; row.pane = pane; row.key = key; row.folder = folder
    unused BuilderAppend(row.path.bytes, path)
    unused VecPush(host.drop_rows, row)
}

DropTarget :: (host: *Host, session: Session) -> s32 {
    pointer := Input.PointerSample(session)
    index := cast(s32)host.drop_rows.count - 1
    while index >= 0 {
        bounds := host.drop_rows[index].bounds
        if pointer.x >= bounds.x && pointer.x < bounds.x + bounds.width && pointer.y >= bounds.y && pointer.y < bounds.y + bounds.height &&
            host.drop_rows[index].folder { return index }
        index -= 1
    }
    return -1
}

UpdateDrag :: (host: *Host, session: Session, key: s32) {
    if !host.drag.active { host.drop_key = 0; return }
    if key == KeyEscape { FileDrag.Cancel(*host.drag) }
    state := FileDrag.Update(*host.drag)
    target := ifx state.local then DropTarget(host, session) else -1
    host.drop_key = ifx target >= 0 then host.drop_rows[target].key else 0
    if state.status == .Dragging || state.status == .Dropped { return }
    if state.status == .Local && target >= 0 {
        paths: Vec(string)
        FileDrag.Views(*host.drag, *paths)
        directory := TextView(host.drop_rows[target].path)
        onto_self := false
        for path: paths { if path == directory { onto_self = true } }
        if !onto_self && !Model.IsUri(directory) {
            manager := PaneManager(host, host.drop_rows[target].pane)
            action := FileDrag.DropAction(*host.drag, paths[:], directory)
            changed := false
            unused Model.TransferInto(manager, paths[:], directory, action, *changed)
            if changed {
                unused Model.ReloadPreserving(PaneManager(host, 0))
                if host.secondary.count > 0 { unused Model.ReloadPreserving(PaneManager(host, 1)) }
            }
        }
        VecFree(paths)
    } else if state.status == .Finished && state.success {
        // A foreign file manager may have moved the files away.
        unused Model.ReloadPreserving(PaneManager(host, 0))
        if host.secondary.count > 0 { unused Model.ReloadPreserving(PaneManager(host, 1)) }
    }
    host.drop_key = 0
    FileDrag.Finish(*host.drag)
}

// Files dropped on the window by another application (copied or moved into
// the active folder by Thunar's rule).
QueueExternalDrop :: (host: *Host, path: string) {
    if host.started { unused VecPush(host.external_drops, TextCopy(path)) }
}

ApplyExternalDrops :: (host: *Host) {
    if host.external_drops.count == 0 { return }
    manager := ActiveManager(host)
    paths: Vec(string)
    for * path: host.external_drops { unused VecPush(paths, TextView(path.*)) }
    if !Model.IsUri(manager.cwd) {
        action := Model.DropAction(paths[:], manager.cwd, 1)
        changed := false
        unused Model.TransferInto(manager, paths[:], manager.cwd, action, *changed)
        if changed { RefreshOtherPane(host) }
    } else { Model.SetError(manager, "This location has no local destination for file operations") }
    VecFree(paths)
    VecFree(host.external_drops)
}

DrawNativeMenu :: (host: *Host, session: Session, viewport: Rectangle, focused: bool, key: s32) {
    if !host.actions_open { return }
    if !PopupOwnerValid(host) || key == KeyEscape { host.actions_open=false; return }
    if focused && (key==KeyLeft || key==KeyRight) {
        host.menu_index=(host.menu_index+ifx key==KeyLeft then 4 else 6)%6+1
        host.menu_cursor=0
    }
    labels: [16]string
    count: s32
    if host.menu_index == 1 { labels[0]="New folder"; labels[1]="New file"; labels[2]="New tab"; labels[3]="Close tab"; labels[4]="Rename"; labels[5]="Move to Trash"; labels[6]="Restore"; labels[7]="Preview"; count=8 }
    else if host.menu_index == 2 { labels[0]="Undo"; labels[1]="Redo"; labels[2]="Cut"; labels[3]="Copy"; labels[4]="Paste"; labels[5]="Select all"; labels[6]="Duplicate"; labels[7]="Make link"; labels[8]="Select by pattern"; labels[9]="Invert selection"; count=10 }
    else if host.menu_index == 3 { labels[0]="Icons"; labels[1]="Detailed List"; labels[2]="Compact List"; labels[3]="Show hidden files"; labels[4]="Places"; labels[5]="Tree"; labels[6]="Split view"; labels[7]="Other pane"; labels[8]="Reload"; labels[9]="Pathbar"; count=10 }
    else if host.menu_index == 4 { labels[0]="Back"; labels[1]="Forward"; labels[2]="Parent"; labels[3]="Home"; labels[4]="File System"; labels[5]="Location"; labels[6]="Search"; count=7 }
    else if host.menu_index == 5 { labels[0]="Add bookmark"; labels[1]="Rename bookmark"; labels[2]="Remove bookmark"; labels[3]="Move bookmark up"; labels[4]="Move bookmark down"; count=5 }
    else { labels[0]="About Explorer"; count=1 }
    if focused {
        if key == KeyUp { host.menu_cursor=(host.menu_cursor+count-1)%count }
        if key == KeyDown { host.menu_cursor=(host.menu_cursor+1)%count }
        if key == KeyHome { host.menu_cursor=0 }
        if key == KeyEnd { host.menu_cursor=count-1 }
    }
    x := viewport.x+Native.MenuOffset(host.menu_index-1)
    menu_nodes:=Native.Nodes("menu")
    label_width: s32; shortcut_width: s32
    for i: cast(s32)0..count-1 {
        label:=Gtk.GtkTextMeasure(menu_nodes[:],labels[i],0,1)
        accelerator:=Gtk.GtkTextMeasure(menu_nodes[:],MenuShortcut(host.menu_index,i),0,1)
        if label.width>label_width { label_width=label.width }
        if accelerator.width>shortcut_width { shortcut_width=accelerator.width }
    }
    menu_style:=Gtk.GtkStyleQuery(menu_nodes[:],1)
    width:=cast(float32)(label_width+shortcut_width+menu_style.padding.left+menu_style.padding.right+40)
    if x+width > viewport.x+viewport.width { x=viewport.x+viewport.width-width }
    bounds := Rectangle.{x,viewport.y+Native.MenuHeight(),width,cast(float32)(count*28+8)}
    popup := Overlay.Popup(session,Overlay.PopupProps.{.key=cast(u64)650,.bounds=bounds,.keep_bounds=.{viewport.x,viewport.y,viewport.width,Native.MenuHeight()}})
    if popup.closed { host.actions_open=false; return }
    if popup.panel_node < 0 || !TreePushScope(session,popup.panel_node) { return }
    defer End(session)
    Native.Surface(*host.paint,bounds,"menu")
    manager := ActiveManager(host)
    pointer:=Input.PointerSample(session)
    if focused && (pointer.x!=host.menu_pointer.x || pointer.y!=host.menu_pointer.y) {
        if pointer.x>=x && pointer.x<x+width && pointer.y>=bounds.y+4.0 && pointer.y<bounds.y+4.0+cast(float32)(count*28) {
            host.menu_cursor=cast(s32)(pointer.y-bounds.y-4.0)/28
        }
        host.menu_pointer=.{pointer.x,pointer.y}
    }
    for i: cast(s32)0..count-1 {
        clicked := Native.MenuItem(*host.paint,cast(u64)(660+i),.{x+4.0,bounds.y+4.0+cast(float32)i*28.0,width-8.0,28.0},labels[i],focused,i==host.menu_cursor,MenuShortcut(host.menu_index,i))
        if !clicked && !(focused && key==KeyEnter && i==host.menu_cursor) { continue }
        host.actions_open=false
        if host.menu_index == 1 {
            if i == 0 { OpenPrompt(host,.PromptFolder) } else if i == 1 { OpenPrompt(host,.PromptFile) }
            else if i == 2 { unused Model.NewTab(manager) } else if i == 3 { unused Model.CloseTab(manager,manager.active_tab) }
            else if i == 4 { OpenPrompt(host,.PromptRename) } else if i == 5 { unused Model.DeleteSelection(manager,true); RefreshOtherPane(host) }
            else if i == 6 { unused Model.RestoreSelection(manager); RefreshOtherPane(host) } else if manager.cursor >= 0 { OpenPreview(host,Model.EntryPath(manager,manager.cursor)) }
        } else if host.menu_index == 2 {
            if i==0 { unused Model.Undo(manager); RefreshOtherPane(host) }
            else if i==1 { unused Model.Redo(manager); RefreshOtherPane(host) }
            else if i==2 || i==3 { unused FileClipboard.Copy(*host.file_clipboard,manager,i==2) } else if i==4 { unused PasteFiles(host) }
            else if i==5 { Model.SelectAll(manager) } else if i==6 { unused Model.DuplicateSelection(manager); RefreshOtherPane(host) } else if i==7 { unused Model.MakeLinkSelection(manager); RefreshOtherPane(host) } else if i==8 { OpenPrompt(host,.PromptSelectPattern) } else { for n: cast(s32)0..cast(s32)manager.selected.count-1 { manager.selected[n]= !manager.selected[n] } }
        } else if host.menu_index == 3 {
            if i == 0 { Model.SetView(manager,.ViewIcon) } else if i == 1 { Model.SetView(manager,.ViewList) } else if i == 2 { Model.SetView(manager,.ViewCompact) }
            else if i == 3 { manager.show_hidden= !manager.show_hidden; unused Model.Refresh(manager) }
            else if i == 4 || i == 5 { TreeMode(host,i==5) } else if i == 6 { unused ToggleSplit(host) }
            else if i == 7 { RequestPane(host,1-host.active_pane) } else if i==8 { unused Model.Refresh(manager) } else { host.pathbar= !host.pathbar }
        } else if host.menu_index == 4 {
            if i == 0 { unused Model.NavigateBack(manager) } else if i == 1 { unused Model.NavigateForward(manager) }
            else if i == 2 { unused Model.NavigateUp(manager) } else if i == 3 { unused Model.OpenPathTracked(manager,Model.HomePath()) }
            else if i == 4 { unused Model.OpenPathTracked(manager,"/") } else if i == 5 { OpenPrompt(host,.PromptLocation) } else { OpenPrompt(host,.PromptSearch) }
        } else if host.menu_index == 5 {
            if i == 0 { BookmarkSelection(host) }
            else if i == 1 { OpenPrompt(host,.PromptBookmarkRename) }
            else {
                previous:=host.bookmark_selected
                ok:=Bookmarks.Edit(*host.bookmarks,previous,i-1)
                BookmarkResult(host,ok)
                target:=previous+ifx i==3 then -1 else 1
                if ok && i>=3 && target>=0 && target<host.bookmarks.document.rows.count { host.bookmark_selected=target }
            }
        } else { Model.SetError(manager,"Explorer · Ziran file manager · Ctrl+1/2/3 views · F3 split · Ctrl+L location") }
    }
}

Draw :: (host: *Host, host_session: HostSession, host_viewport: HostViewport,
    focused: bool = true) -> s32 {
    if host == null || !host.started { return 1 }
    session := Session.{.slot = host_session.slot, .epoch = host_session.epoch}
    viewport := Rectangle.{host_viewport.x, host_viewport.y, host_viewport.width, host_viewport.height}
    ResolvePaneInput(host, session, viewport, focused)
    if host.active_pane == 1 {
        return DrawInPane(host, *host.secondary[0].view, host_session, host_viewport, focused)
    }
    return DrawInPane(host, *host.view, host_session, host_viewport, focused)
}

DrawInPane :: (host: *Host, view: *PaneView, host_session: HostSession, host_viewport: HostViewport,
    focused: bool = true) -> s32 {

    if host == null || !host.started { return 1 }
    FileClipboard.Poll()
    // Drop destinations are recorded while this frame draws.
    VecFree(host.drop_rows)
    ApplyExternalDrops(host)
    ui_session: Session
    ui_session.slot = host_session.slot
    ui_session.epoch = host_session.epoch
    ui_viewport: Rectangle
    ui_viewport.x = host_viewport.x
    ui_viewport.y = host_viewport.y
    ui_viewport.width = host_viewport.width
    ui_viewport.height = host_viewport.height
    session := ui_session
    viewport := ui_viewport
    snapshot: Input.InputSnapshot
    if !focused { snapshot = Input.TreeInputSuspend(session) }
    defer { if !focused { unused Input.TreeInputResume(session, snapshot) } }
    if !focused || PaneLocked(host) {
        unused NativeScroll.GtkScrollCancel(host.view.native_scroll)
        if host.secondary.count>0 { unused NativeScroll.GtkScrollCancel(host.secondary[0].view.native_scroll) }
    } else if !host.split && host.secondary.count>0 {
        unused NativeScroll.GtkScrollCancel(host.secondary[0].view.native_scroll)
    }
    RefreshTheme(host)
    if !Palettes.WidgetPaletteUse(session, host.palette) { return 1 }
    defer { unused Palettes.WidgetPaletteRestore(session) }
    manager := ActiveManager(host)
    stale_modal := (manager.prompt != .PromptNone || host.preview.opened || host.field.focused || host.info_open) && !ModalOwnerValid(host)
    if stale_modal { CancelStaleModal(host) }
    if stale_modal { host.info_open=false }
    root := BoxWidget.Draw(session, BoxWidget.Props.{.key = cast(u64)500, .bounds = viewport,
        .fill = ColorFromPacked(host.palette.background)})
    if root < 0 || !TreePushScope(session, root) { return 1 }
    defer { Native.ApplyPointerCursors(session,root) }
    TreeSetChildClip(session, root, viewport)
    defer { End(session) }
    defer { ApplyPaneRequest(host) }
    for index: cast(s32)0..host.field.length - 1 {
        host.field_value[index] = host.field.bytes[index]
    }
    key: s32
    modifiers: s32
    if focused {
        key = Input.KeyboardTake(session)
        modifiers = Input.KeyboardModifiers(session)
    }
    if stale_modal { key = 0 }
    if host.info_open && focused && (key==KeyEscape || key==KeyEnter) { host.info_open=false; key=0 }
    if key != 0 { view.last_click_ms = 0 }
    // Dismiss before submitting pane controls so the next native press sees
    // enabled divider/views immediately, without an idle-frame dependency.
    if focused && key == KeyEscape && (manager.prompt != .PromptNone || host.preview.opened) {
        if host.preview.opened { Preview.Close(*host.preview) }
        else if manager.prompt == .PromptLocation { CancelLocation(host) }
        else { manager.prompt = .PromptNone; host.field.length = 0; host.field.focused = false }
        key = 0
    }
    if focused && key == KeyF3 && modifiers == 0 && !PaneLocked(host) { unused ToggleSplit(host); key = 0 }
    typed_text := Keys.TypedTextTake(session, host.typed[:])
    if host.preview.opened {
        DrawPreview(host, session, viewport, key, modifiers, focused)
        return 0
    }
    if manager.prompt == .PromptNone && !host.actions_open && !host.breadcrumb_open && !host.info_open && key == 80 && modifiers == KeyModifierControl &&
        manager.cursor >= 0 {
        OpenPreview(host, Model.EntryPath(manager, manager.cursor))
        DrawPreview(host, session, viewport, 0, 0, focused)
        return 0
    }

    if DispatchShortcut(host,session,key,modifiers) { key=0 }
    // A completed location edit can commit before drawing its destination.
    // Text arriving with Return still goes through the field's edit path.
    if focused && manager.prompt == .PromptLocation && key == KeyEnter && typed_text == "" {
        FinishPrompt(host)
        key = 0
    }
    window_focused:=focused
    if host.info_open { focused=false; key=0 }

    // Keep the native toolbar at the original top edge when its menu is hidden.
    // The root clip remains the real window; the shared geometry retains GTK's
    // measured menu allocation for an ordinary visible menubar.
    if host.menubar_hidden { viewport.y-=Native.MenuHeight(); viewport.height+=Native.MenuHeight() }

    if !GtkPainterBegin(*host.paint,session,viewport) { return 1 }
    host.paint_active=true
    chrome_height:=Native.ChromeHeight()
    path_bounds := Native.LocationBounds(viewport)
    sidebar_width: float32=ifx host.sidebar_hidden then 0.0 else 170.0
    sidebar := Rectangle.{viewport.x,viewport.y+chrome_height,sidebar_width,viewport.height-chrome_height}
    separator_width: float32=ifx host.sidebar_hidden then 0.0 else Native.PaneSeparatorWidth()
    view_x := viewport.x+sidebar_width+separator_width
    view_width:=viewport.width-sidebar_width-separator_width
    breadcrumb_was_open:=host.breadcrumb_open
    DrawNativeChrome(host,session,viewport,path_bounds,focused,key)
    if breadcrumb_was_open || host.breadcrumb_open { key=0 }
    if host.sidebar_hidden { }
    else if view.tree_mode {
        Native.Surface(*host.paint,sidebar,"sidebar")
        if DrawDirectoryTree(host,session,sidebar,focused,key) { key=0 }
    } else { DrawNativePlaces(host,session,sidebar,focused) }
    if separator_width>0.0 { Native.PaneSeparator(*host.paint,.{viewport.x+sidebar_width,sidebar.y,separator_width,sidebar.height}) }
    tab_height: float32 = ifx manager.tabs.count > 1 || host.split then 32.0 else 0.0
    if !host.split && tab_height > 0.0 {
        if DrawTabs(host,session,.{view_x,viewport.y+chrome_height,view_width,32.0},focused,key,modifiers) { key=0 }
    }
    footer:=NativeStatusBounds(host,viewport)
    list_bounds := Rectangle.{view_x,viewport.y+chrome_height+tab_height,view_width,footer.y-(viewport.y+chrome_height+tab_height)}
    if list_bounds.width < 1.0 { list_bounds.width=1.0 }
    if list_bounds.height < 1.0 { list_bounds.height=1.0 }
    content_enabled := focused && manager.prompt == .PromptNone && !host.breadcrumb_open && !host.actions_open &&
        !host.context_view.open && !host.chooser_open
    if host.split {
        pane := PanedViewWidget.Draw(session, PanedViewWidget.Props.{.key = cast(u64)548, .id = 548,
            .bounds = list_bounds, .vertical = true, .has_split = true,
            .split = ifx host.divider_set then host.divider else cast(s32)(list_bounds.width * 0.5),
            .min_first = 100, .min_second = 100, .disabled = !content_enabled})
        host.divider = pane.split; host.divider_set = true
        DrawPaneBody(host, session, pane.first, 0, ifx host.active_pane == 0 then key else 0,
            ifx host.active_pane == 0 then modifiers else 0, content_enabled)
        DrawPaneBody(host, session, pane.second, 1, ifx host.active_pane == 1 then key else 0,
            ifx host.active_pane == 1 then modifiers else 0, content_enabled)
    } else {
        DrawPaneBody(host, session, list_bounds, host.active_pane,
            ifx manager.prompt == .PromptNone then key else 0, modifiers, content_enabled)
    }

    if host.breadcrumb_open { Native.RetainedControls(*host.paint,host.breadcrumb_first,host.breadcrumb_last,host.breadcrumb_bounds,true) }
    menu_was_open:=host.actions_open
    DrawNativeMenu(host,session,viewport,focused,key)
    if menu_was_open { key=0 }
    if DrawContextMenu(host,session,viewport,focused,key) { key=0 }
    if host.info_open {
        bounds:=Rectangle.{viewport.x+(viewport.width-620.0)*0.5,viewport.y+(viewport.height-420.0)*0.5,620.0,420.0}
        Native.Surface(*host.paint,bounds,"window")
        Native.Label(*host.paint,.{bounds.x+20.0,bounds.y+12.0,bounds.width-40.0,28.0},host.info_title,"label")
        Native.Label(*host.paint,.{bounds.x+20.0,bounds.y+48.0,bounds.width-40.0,bounds.height-110.0},TextView(host.info_body[:]),"label")
        if Native.Control(*host.paint,cast(u64)55,.{bounds.x+bounds.width-120.0,bounds.y+bounds.height-46.0,100.0,32.0},"Close","",window_focused) { host.info_open=false }
    }
    painted:=GtkPainterEnd(*host.paint,cast(u64)599)
    host.paint_active=false
    if !painted { return 1 }
    if manager.prompt == .PromptLocation {
        DrawLocationEditor(host, session, path_bounds, viewport, key, modifiers, typed_text, focused)
        if manager.prompt == .PromptLocation { DrawLocationStatus(host, session, viewport) }
    }
    UpdateDrag(host,session,key)
    DrawChooser(host,session,viewport,focused,key)
    if manager.prompt==.PromptEmptyTrash {
        bounds:=Rectangle.{viewport.x+viewport.width*0.5-250.0,viewport.y+viewport.height*0.5-55.0,500.0,110.0}
        BoxWidget.Draw(session,BoxWidget.Props.{.key=cast(u64)50,.bounds=bounds,.fill=ColorFromPacked(host.palette.base)})
        TextWidget.Draw(session,TextWidget.Props.{.key=cast(u64)51,.bounds=.{bounds.x+16.0,bounds.y+12.0,468.0,40.0},.text=PromptTitle(host),.size = 16})
        if Button(host,session,53,"Cancel",.{bounds.x+250.0,bounds.y+62.0,100.0,32.0},focused) || (focused && key==KeyEscape) {
            manager.prompt=.PromptNone
        } else if Button(host,session,54,"Empty Trash",.{bounds.x+364.0,bounds.y+62.0,120.0,32.0},focused) || (focused && key==KeyEnter) {
            FinishEmptyTrash(host)
        }
    }
    if manager.prompt==.PromptDelete {
        bounds:=Rectangle.{viewport.x+viewport.width*0.5-250.0,viewport.y+viewport.height*0.5-55.0,500.0,110.0}
        BoxWidget.Draw(session,BoxWidget.Props.{.key=cast(u64)50,.bounds=bounds,.fill=ColorFromPacked(host.palette.base)})
        TextWidget.Draw(session,TextWidget.Props.{.key=cast(u64)51,.bounds=.{bounds.x+16.0,bounds.y+12.0,468.0,40.0},.text=PromptTitle(host),.size = 16})
        if Button(host,session,53,"Cancel",.{bounds.x+250.0,bounds.y+62.0,100.0,32.0},focused) {
            manager.prompt=.PromptNone
        } else if Button(host,session,54,"Delete",.{bounds.x+364.0,bounds.y+62.0,120.0,32.0},focused) || (focused && key==KeyEnter) {
            FinishDelete(host)
        }
    }
    if manager.prompt != .PromptNone && manager.prompt != .PromptLocation && manager.prompt!=.PromptDelete && manager.prompt!=.PromptEmptyTrash {
        prompt_bounds := Rectangle.{viewport.x + viewport.width * 0.5 - 220.0,
            viewport.y + viewport.height * 0.5 - 46.0, 440.0, 92.0}
        BoxWidget.Draw(session, BoxWidget.Props.{.key = cast(u64)50, .bounds = prompt_bounds,
            .fill = ColorFromPacked(host.palette.base)})
        TextWidget.Draw(session, TextWidget.Props.{.key = cast(u64)51,
            .bounds = .{prompt_bounds.x + 16.0, prompt_bounds.y + 12.0, 408.0, 22.0},
            .text = PromptTitle(host), .size = 16})
        props := TextFieldWidget.Props.{
            .key = cast(u64)52, .bounds = .{prompt_bounds.x + 16.0,
                prompt_bounds.y + 40.0, 408.0, 32.0},
            .value = TextView(host.field_value[:host.field.length]),
            .cursor = host.field.cursor, .anchor = host.field.anchor,
            .scroll_x = host.field.scroll_x, .focused = host.field.focused && focused,
            .max_bytes = 4096}
        props.input = Keys.TextFieldInputFor(key, modifiers, typed_text)
        props.input.focus = host.field.focused && focused
        edited := TextFieldWidget.Draw(session, props)
        if edited.clipboard_write { unused SystemClipboardSet(edited.clipboard_text) }
        if focused && ApplyFieldEdit(*host.field, edited.edit) {
            host.field.cursor = edited.cursor
            host.field.anchor = edited.anchor
            host.field.scroll_x = edited.scroll_x
            if host.field.scroll_x < 0 { host.field.scroll_x = 0 }
            host.field.focused = edited.focused
        }
        if edited.committed { FinishPrompt(host) }
        else if edited.escaped {
            manager.prompt = .PromptNone
            host.field.length = 0
            host.field.focused = false
        }
    }
    return 0
}
