    modal_pane: s32
    modal_tab: u64
    modal_path: Text
    modal_target: Text
    modal_identity: TabPaths.PathInfo
    delete_keys: Vec(u64)
    delete_identities: Vec(TabPaths.PathInfo)
    popup_pane: s32
    popup_tab: u64
    popup_path: Text
    next_pane: s32
    command_pane: s32
    command_tab: u64
    started: bool
    field: FieldState
    typed: [128]u8
    field_value: [4096]u8
    field_next: [4096]u8
