Model :: #import "model";
Files :: #import "file_clipboard";
Desktop :: #import "desktop_file_clipboard";
Native :: #import "kryon/MimeClipboardLinux";
using Bytes :: #import "std/byte_text_linux";
glib :: #system_library "glib-2.0";
libc :: #system_library "c";
Now :: () -> s64 #foreign glib "g_get_monotonic_time";
Pause :: (microseconds: u32) -> s32 #foreign libc "usleep";

// Native adapter test without a renderer: filenames may contain bytes that
// cannot be represented as a UTF-8 URI. A failed publish must retain both lists.
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if !Native.MimeClipboardOpen() { return 1 }
    manager: Model.Manager
    state: Desktop.State
    if argc > 1 && TextFromCString(argv[1]) == "--formats" {
        start := Now()
        available := false
        while Now() - start < 200000 {
            available = Desktop.CanPaste(*state)
            if available { break }
            unused Pause(1000)
        }
        if !available { return 8 }
        print("file targets available without reading payload (% us)\n", Now() - start)
        if argc > 2 {
            // A GTK owner republishes plain text from its existing window.
            owner := Native.MimeClipboardOwner()
            deadline := Now() + 4000000
            while Desktop.CanPaste(*state) && Now() < deadline { unused Pause(1000) }
            if Desktop.CanPaste(*state) || Native.MimeClipboardOwner() != owner { return 9 }
            print("same-window format replacement invalidates Paste\n")
        }
        Desktop.Close(*state)
        Native.MimeClipboardClose()
        return 0
    }
    if !Files.Parse(*state.clipboard, Files.GNOME_FILES, "cut\nfile:///prior\n") { return 2 }
    raw := u8.[47, 255]
    if !Model.AppendEntry(*manager, "unsupported path", TextView(raw[:]), .{.kind = .File}) { return 3 }
    Model.SelectOne(*manager, 0)
    owner := Native.MimeClipboardOwner()
    if argc > 1 {
        // An owner may keep its window and bytes while changing MIME targets.
        // Cached GNOME cut progress must never bypass URI-list validation.
        state.cut_owner = owner
        state.cut_mime = Files.GNOME_FILES
        remembered: Text = TextCopy("cut\nfile:///prior\n")
        VecSwap(state.cut_payload.bytes, remembered.bytes)
        destination: Model.Manager
        if !Model.AppendEntry(*destination, "destination snapshot", "/destination", .{.kind = .File}) { return 7 }
        Model.SelectOne(*destination, 0)
        destination.scroll = 31
        if Desktop.Paste(*state, *destination) ||
            destination.entries.count != 1 || Model.SelectedCount(*destination) != 1 || destination.scroll != 31 ||
            manager.entries.count != 1 || Model.SelectedCount(*manager) != 1 || manager.error != "" ||
            destination.error != "Desktop file clipboard is empty, invalid or contains unsupported URIs" ||
            state.clipboard.paths.count != 1 || state.clipboard.paths[0] != "/prior" ||
            Native.MimeClipboardOwner() != owner { return 6 }
        Desktop.Close(*state)
        Model.Dispose(*destination)
        Model.Dispose(*manager)
        Native.MimeClipboardClose()
        print("native clipboard MIME change validates before using cached cut progress\n")
        return 0
    }
    if owner == 0 || Desktop.Copy(*state, *manager, false) ||
        manager.error == "" || state.clipboard.mode != .ClipboardCut ||
        state.clipboard.paths.count != 1 || state.clipboard.paths[0] != "/prior" ||
        Native.MimeClipboardOwner() != owner { return 4 }
    Desktop.Close(*state)
    if Native.MimeClipboardOwner() != owner { return 5 }
    Model.Dispose(*manager)
    Native.MimeClipboardClose()
    print("native clipboard publication rejection preserves internal selection and foreign owner\n")
    return 0
}
