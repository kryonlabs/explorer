UndershootTest :: (session: Sessions.Session) -> bool {
    unused NativeUI.Nodes("treeview")
    provider:=Gtk.GtkStyleProviderCreate(".standard-view undershoot { background-image:none; border:0; border-radius:0; box-shadow:none; padding:0; } .standard-view undershoot.top, .standard-view undershoot.left { background-color:#a03040; } .standard-view undershoot.bottom, .standard-view undershoot.right { background-color:#306080; }")
    if provider==0 || !Gtk.GtkStyleProviderInstall(provider,1000) { return false }
    defer { unused Gtk.GtkStyleProviderRelease(provider) }
    painter: Paint.GtkPainter
    defer Paint.GtkPainterRelease(*painter)
    offsets: [9]s32=.[0,50,100,0,1,50,0,50,120]
    contents: [9]s32=.[200,200,200,100,100,200,200,200,200]
    index: s32
    while index<9 {
        if !Paint.GtkPainterBegin(*painter,session,.{0.0,0.0,120.0,120.0}) { return false }
        bounds:=Geometry.Rectangle.{10.0,10.0,80.0,ifx index==4 then 20.0 else 100.0}
        if index==5 { painter.clip=.{20.0,20.0,40.0,60.0} }
        previous:=painter.clip
        NativeUI.DetailsUndershoot(*painter,bounds,offsets[index],contents[index],index>=6)
        if painter.clip.x!=previous.x || painter.clip.y!=previous.y || painter.clip.width!=previous.width || painter.clip.height!=previous.height { return false }
        for y: cast(s32)0..119 {
            for x: cast(s32)0..119 {
                red: u8; green: u8; blue: u8; alpha: u8
                inside:=x>=10 && x<90 && y>=10 && y<110
                if index==4 { inside=x>=10 && x<90 && y>=10 && y<30 }
                if index==5 { inside=x>=20 && x<60 && y>=20 && y<80 }
                top: bool; bottom: bool
                if index==0 { bottom=y>=70 }
                if index==1 || index==5 { top=y<50; bottom=y>=70 }
                if index==2 { top=y<50 }
                if index==4 { top=true }
                if index==6 { bottom=x>=50 }
                if index==7 { top=x<50; bottom=x>=50 }
                if index==8 { top=x<50 }
                if inside && top { red=160; green=48; blue=64; alpha=255 }
                else if inside && bottom { red=48; green=96; blue=128; alpha=255 }
                at: s64=cast(s64)(y*120+x)*4
                if painter.pixels[at]!=red || painter.pixels[at+1]!=green || painter.pixels[at+2]!=blue || painter.pixels[at+3]!=alpha {
                    print("Native undershoot case % pixel %, % failed\n",index,x,y)
                    return false
                }
            }
        }
        index+=1
    }
    print("Native undershoot: both axes, start/middle/end/fit/short-body pixels and parent clip passed\n")
    return true
}

NativeScrollPointer :: (host: *App.Host, session: Sessions.Session, point: Geometry.Vector2,
    pressed: bool, down: bool, released: bool, focused: bool=true) -> bool {
    unused Input.TreePointerUpdate(session,Input.PointerFrame.{.x=point.x,.y=point.y,.pressed=pressed,.down=down,.released=released})
    return RenderAt(host,session,focused,.{33.0,55.0,780.0,520.0},true)
}

NativeScrollFailure :: (host: *App.Host, horizontal: bool, stage: s32) -> bool {
    metrics:=host.view.native_scroll_metrics
    bar:=ifx horizontal then metrics.horizontal else metrics.vertical
    print("native scroll stage % horizontal % available % visible % opacity % dragging % value % upper % page % model %\n",
        stage,horizontal,metrics.available,bar.visible,bar.opacity,metrics.dragging,bar.value,bar.upper,bar.page_size,host.manager.scroll)
    return false
}

NativeScrollGesture :: (host: *App.Host, session: Sessions.Session, horizontal: bool) -> bool {
    metrics:=host.view.native_scroll_metrics
    bar:=ifx horizontal then metrics.horizontal else metrics.vertical
    if !metrics.available || !bar.visible || bar.upper<=bar.page_size { return NativeScrollFailure(host,horizontal,1) }
    origin:=host.view.native_scroll_origin
    middle:=cast(float32)(bar.slider_start+bar.slider_end)*0.5
    point:=Geometry.Vector2.{origin.x+cast(float32)bar.bounds.x+cast(float32)bar.bounds.width*0.5,
        origin.y+cast(float32)bar.bounds.y+cast(float32)bar.bounds.height*0.5}
    if horizontal { point.x=origin.x+cast(float32)bar.bounds.x+middle }
    else { point.y=origin.y+cast(float32)bar.bounds.y+middle }
    // GTK reveals an idle overlay on its frame clock. Allow the native hover
    // transition to finish before pressing its current slider allocation.
    for pulse: 0..5 {
        if !NativeScrollPointer(host,session,point,false,false,false) { return false }
        unused Sleep(20000)
    }
    bar=ifx horizontal then host.view.native_scroll_metrics.horizontal else host.view.native_scroll_metrics.vertical
    middle=cast(float32)(bar.slider_start+bar.slider_end)*0.5
    if horizontal { point.x=origin.x+cast(float32)bar.bounds.x+middle }
    else { point.y=origin.y+cast(float32)bar.bounds.y+middle }
    if !NativeScrollPointer(host,session,point,true,true,false) || !host.view.native_scroll_metrics.dragging { print("native press failed axis %\n",horizontal); return NativeScrollFailure(host,horizontal,2) }
    // Leave the bar perpendicularly while moving along its axis. The native
    // owned target must retain the sequence, including the final fast motion.
    if horizontal { point.x+=100.0; point.y-=75.0 } else { point.y+=100.0; point.x-=75.0 }
    if !NativeScrollPointer(host,session,point,false,true,false) || !host.view.native_scroll_metrics.dragging { return NativeScrollFailure(host,horizontal,3) }
    moved:=ifx horizontal then host.view.native_scroll_metrics.horizontal.value else host.view.native_scroll_metrics.vertical.value
    if moved<=bar.value { print("native outside motion failed axis % value % -> %\n",horizontal,bar.value,moved); return NativeScrollFailure(host,horizontal,4) }
    if horizontal { point.x+=45.0 } else { point.y+=45.0 }
    if !NativeScrollPointer(host,session,point,false,false,true) || host.view.native_scroll_metrics.dragging { return NativeScrollFailure(host,horizontal,5) }
    released:=ifx horizontal then host.view.native_scroll_metrics.horizontal.value else host.view.native_scroll_metrics.vertical.value
    if released<moved || !NativeScrollPointer(host,session,point,false,false,false) { return NativeScrollFailure(host,horizontal,6) }
    stable:=ifx horizontal then host.view.native_scroll_metrics.horizontal.value else host.view.native_scroll_metrics.vertical.value
    if stable!=released { print("native release snapback % -> %\n",released,stable); return NativeScrollFailure(host,horizontal,7) }
    // A held sequence is canceled when the pane loses input, then content
    // selection must work on the same retained Host after focus returns.
    bar=ifx horizontal then host.view.native_scroll_metrics.horizontal else host.view.native_scroll_metrics.vertical
    middle=cast(float32)(bar.slider_start+bar.slider_end)*0.5
    point=.{origin.x+cast(float32)bar.bounds.x+cast(float32)bar.bounds.width*0.5,
        origin.y+cast(float32)bar.bounds.y+cast(float32)bar.bounds.height*0.5}
    if horizontal { point.x=origin.x+cast(float32)bar.bounds.x+middle } else { point.y=origin.y+cast(float32)bar.bounds.y+middle }
    for pulse: 0..5 {
        if !NativeScrollPointer(host,session,point,false,false,false) { return false }
        unused Sleep(20000)
    }
    if !NativeScrollPointer(host,session,point,true,true,false) || !host.view.native_scroll_metrics.dragging ||
        !NativeScrollPointer(host,session,point,false,true,false,false) || host.view.native_scroll_metrics.dragging ||
        !NativeScrollPointer(host,session,point,false,false,true) || host.view.native_scroll_metrics.dragging { return NativeScrollFailure(host,horizontal,8) }
    resumed:=ifx horizontal then host.view.native_scroll_metrics.horizontal.value else host.view.native_scroll_metrics.vertical.value
    if resumed!=released { return NativeScrollFailure(host,horizontal,9) }
    return true
}

NativeScrollViewsTest :: (host: *App.Host, session: Sessions.Session) -> bool {
    for mode: cast(s32)0..2 {
        Model.SetView(*host.manager,cast(Model.ViewMode)mode)
        host.manager.scroll=0
        if !RenderAt(host,session,true,.{33.0,55.0,780.0,520.0}) ||
            !NativeScrollGesture(host,session,host.manager.view_mode==.ViewCompact) { print("native scrollbar view % failed\n",mode); return false }
    }
    Model.SetView(*host.manager,.ViewList)
    host.view.columns_resized=true; host.view.column_widths[0]=2000
    if !RenderAt(host,session,true,.{33.0,55.0,780.0,520.0}) || !NativeScrollGesture(host,session,true) { return false }
    host.view.columns_resized=false; host.view.columns_signature=0; host.view.details_scroll_x=0
    host.manager.scroll=0
    if !NativeScrollPointer(host,session,.{400.0,300.0},false,false,false) { return false }
    metrics:=host.view.native_scroll_metrics
    right:=host.view.native_scroll_origin.x+cast(float32)(metrics.viewport.x+metrics.viewport.width)
    for index: cast(s32)0..Tree.TreeCount(session)-1 {
        row:=Tree.TreeNodeAt(session,index)
        if row.kind==cast(s32)Kinds.WidgetKind.WidgetKindSelectable && row.bounds.x>200.0 && row.bounds.y>150.0 {
            if row.bounds.x+row.bounds.width!=right { print("native full-row width % expected %\n",row.bounds.x+row.bounds.width,right); return false }
        }
    }
    print("Explorer native scrollbars: all views/both axes, outside fast release, focus cancellation and full-row hit width passed\n")
    return true
}

LabelsValid :: (session: Sessions.Session) -> bool {
    for index: cast(s32)0..Tree.TreeCount(session) - 1 {
        if !Utf8.Valid(Tree.TreeNodeAt(session, index).semantic_label) { return false }
    }
    return true
}

DirectoryTreeBounds :: (session: Sessions.Session, label: string) -> Geometry.Rectangle {
    for index: cast(s32)0..Tree.TreeCount(session) - 1 {
        row := Tree.TreeNodeAt(session, index)
        if row.semantic_kind == .SemanticTreeItem && row.semantic_label == label { return row.bounds }
    }
    return .{}
}

LocationField :: (host: *App.Host, input: string) {
    host.field.length = App.CopyInto(host.field.bytes, input)
    host.field.cursor = host.field.length; host.field.anchor = host.field.length
}
LocationHostFailure :: (host: *App.Host, stage: s32) -> bool {
    print("location host stage %: cwd % input % prompt % error %\n", stage, host.manager.cwd,
        TextView(host.field.bytes[:host.field.length]), cast(s32)host.manager.prompt, host.manager.error)
    return false
}
BreadcrumbBounds :: (session: Sessions.Session, label: string) -> Geometry.Rectangle {
    for index: cast(s32)0..Tree.TreeCount(session) - 1 {
        node := Tree.TreeNodeAt(session, index)
        if node.kind == cast(s32)Kinds.WidgetKind.WidgetKindButton && node.semantic_label == label { return node.bounds }
    }
    return .{}
}
BreadcrumbHostTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    host.pathbar=true
    defer { host.pathbar=false }
    folder: Text = Files.JoinPath(root, "breadcrumb-pane")
    deep: Text = Files.JoinPath(TextView(folder), "a/b/c d é")
    if !Files.CreateDirectories(TextView(deep)) || !Model.OpenPathTracked(*host.manager, TextView(deep)) ||
        !Render(host, session, true) { return LocationHostFailure(host, 101) }
    bounds := BreadcrumbBounds(session, "c d é")
    if bounds.width <= 0.0 || bounds.x < 390.0 || bounds.x + bounds.width > 1154.0 {
        return LocationHostFailure(host, 102)
    }
    before := host.manager.back.count
    if !Files.ReplaceFile(Files.JoinPath(TextView(deep), "fresh.txt"), "fresh") ||
        !Click(host, session, bounds.x + bounds.width * 0.5, bounds.y + 10.0) ||
        host.manager.cwd != TextView(deep) || host.manager.entries.count != 1 || host.manager.back.count != before ||
        !Render(host, session, true) { return LocationHostFailure(host, 103) }
    overflow := BreadcrumbBounds(session, "Ancestors")
    if overflow.width <= 0.0 || !Click(host, session, overflow.x + 10.0, overflow.y + 10.0) ||
        !host.breadcrumb_open || !Press(host, session, Keys.KeyHome) || !Press(host, session, Keys.KeyEnter) ||
        host.manager.cwd != "/" || host.breadcrumb_open { return LocationHostFailure(host, 104) }
    raw_name := u8.[114, 97, 119, 45, 255]
    raw: Text = Files.JoinPath(TextView(folder), TextView(raw_name[:]))
    if !Files.CreateDirectory(TextView(raw)) || !Model.OpenPathTracked(*host.manager, TextView(raw)) ||
        !Render(host, session, true) || !LabelsValid(session) || BreadcrumbBounds(session, "raw-\\xFF").width <= 0.0 { return LocationHostFailure(host, 105) }
    return Model.OpenPathTracked(*host.manager, root)
}

LocationErrorVisible :: (session: Sessions.Session) -> bool {
    found := false
    for index: cast(s32)0..Tree.TreeCount(session) - 1 {
        node := Tree.TreeNodeAt(session, index)
        if node.key == cast(u64)65 || node.key == cast(u64)66 { return false }
        if node.key == cast(u64)228 {
            // Editing replaces the ordinary status: no duplicate selection text
            // and no diagnostic panel over toolbar or view controls.
            found = node.bounds.width > 0.0 && node.bounds.height > 0.0 &&
                node.bounds.x >= 406.0 && node.bounds.x + node.bounds.width <= 1200.0 &&
                node.bounds.y >= 690.0 && node.bounds.y + node.bounds.height <= 720.0
        }
    }
    return found
}
LocationHostTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    folder: Text = Files.JoinPath(root, "location-pane")
    first: Text = Files.JoinPath(TextView(folder), "alpha space")
    second: Text = Files.JoinPath(TextView(folder), "alpine")
    file: Text = Files.JoinPath(TextView(folder), "alps.txt")
    if !Files.CreateDirectories(TextView(first)) || !Files.CreateDirectory(TextView(second)) ||
        !Files.ReplaceFile(TextView(file), "local") || !Model.OpenPathTracked(*host.manager, TextView(folder)) ||
        !Render(host, session, true) { return LocationHostFailure(host, 1) }
    key := host.manager.entries[host.manager.cursor].key
    history := host.manager.back.count
    if !Press(host, session, 76, Keys.KeyModifierControl) || host.manager.prompt != .PromptLocation ||
        host.field.cursor != host.field.length || host.field.anchor != 0 ||
        TextView(host.field.bytes[:host.field.length]) != TextView(folder) { return LocationHostFailure(host, 2) }
    LocationField(host, "al")
    if !Press(host, session, Keys.KeyTab) || TextView(host.field.bytes[:host.field.length]) != "alp" ||
        !Press(host, session, Keys.KeyDown) || TextView(host.field.bytes[:host.field.length]) != "alpha space/" ||
        !Press(host, session, Keys.KeyDown) || TextView(host.field.bytes[:host.field.length]) != "alpine/" ||
        !Press(host, session, Keys.KeyUp) || TextView(host.field.bytes[:host.field.length]) != "alpha space/" ||
        !Press(host, session, Keys.KeyEscape) || host.manager.prompt != .PromptNone ||
        host.manager.cwd != TextView(folder) || host.manager.back.count != history ||
        host.manager.entries[host.manager.cursor].key != key { return LocationHostFailure(host, 3) }
    if !Press(host, session, 76, Keys.KeyModifierControl) { return LocationHostFailure(host, 4) }
    LocationField(host, "alps.txt")
    if !Press(host, session, Keys.KeyEnter) || host.manager.prompt != .PromptNone ||
        host.manager.cwd != TextView(folder) || Model.EntryName(*host.manager, host.manager.cursor) != "alps.txt" ||
        host.preview.opened { return LocationHostFailure(host, 5) }
    if !Press(host, session, 76, Keys.KeyModifierControl) { return LocationHostFailure(host, 6) }
    LocationField(host, "missing")
    if !Press(host, session, Keys.KeyEnter) || host.manager.prompt != .PromptLocation ||
        TextView(host.field.bytes[:host.field.length]) != "missing" || host.manager.cwd != TextView(folder) ||
        host.manager.error == "" || !LocationErrorVisible(session) || !Press(host, session, Keys.KeyEscape) { return LocationHostFailure(host, 7) }
    if !Press(host, session, 76, Keys.KeyModifierControl) { return LocationHostFailure(host, 8) }
    LocationField(host, "al")
    if !Press(host, session, Keys.KeyTab) || !Press(host, session, Keys.KeyDown) ||
        !Files.CreateDirectory(Files.JoinPath(TextView(folder), "changed")) ||
        !Press(host, session, Keys.KeyEnter) || host.manager.prompt != .PromptLocation ||
        !Press(host, session, Keys.KeyEnter) || host.manager.prompt != .PromptLocation ||
        host.manager.cwd != TextView(folder) || TextView(host.field.bytes[:host.field.length]) != "alpha space/" {
        return LocationHostFailure(host, 9)
    }
    if !Press(host, session, Keys.KeyEscape) || !Press(host, session, 76, Keys.KeyModifierControl) { return LocationHostFailure(host, 10) }
    LocationField(host, "alpha space")
    unused Input.KeyboardModifiersSend(session, 0)
    unused Input.KeyboardSend(session, Keys.KeyEnter)
    if !Render(host, session, false) || host.manager.cwd != TextView(folder) || host.manager.prompt != .PromptLocation ||
        !Render(host, session, true) || host.manager.cwd != TextView(first) || host.manager.prompt != .PromptNone {
        return LocationHostFailure(host, 11)
    }
    // Narrow embedding keeps an inline editor inside the caller viewport.
    App.OpenPrompt(host, .PromptLocation)
    narrow := Geometry.Rectangle.{240.0, 120.0, 560.0, 600.0}
    if !RenderAt(host, session, true, narrow) || !LabelsValid(session) { return LocationHostFailure(host, 12) }
    for index: cast(s32)0..Tree.TreeCount(session) - 1 {
        node := Tree.TreeNodeAt(session, index)
        if node.key == cast(u64)222 && (node.bounds.x < narrow.x || node.bounds.x + node.bounds.width > narrow.x + narrow.width ||
            node.bounds.y < narrow.y || node.bounds.y + node.bounds.height > narrow.y + narrow.height) { return LocationHostFailure(host, 13) }
    }
    if !Press(host, session, Keys.KeyEscape) || !Model.OpenPathTracked(*host.manager, root) { return LocationHostFailure(host, 14) }
    return true
}

DirectoryTreeHostTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    host.manager.prompt = .PromptNone
    host.field.focused = false
    folder: Text = Files.JoinPath(root, "tree-pane")
    alpha: Text = Files.JoinPath(TextView(folder), "alpha\né")
    nested: Text = Files.JoinPath(TextView(alpha), "nested")
    hidden: Text = Files.JoinPath(TextView(alpha), ".hidden")
    loop: Text = Files.JoinPath(TextView(alpha), "loop")
    if host.view.tree_mode || !Files.CreateDirectories(TextView(nested)) || !Files.CreateDirectory(TextView(hidden)) ||
        !Model.CreateSymbolicLink(TextView(folder), TextView(loop)) ||
        !Model.OpenPathTracked(*host.manager, TextView(nested)) { return false }
    if !Press(host, session, 69, Keys.KeyModifierControl) || !host.view.tree_mode ||
        !Render(host, session, true) || !LabelsValid(session) { return false }
    selected := host.view.directory_tree.selected
    a := LocalTree.Find(*host.view.directory_tree, TextView(alpha))
    if selected == 0 || a == 0 || TextView(host.view.directory_tree.nodes[LocalTree.Index(*host.view.directory_tree, selected)].path) != TextView(nested) { return false }
    bounds := DirectoryTreeBounds(session, "alpha\\x0Aé")
    depth := host.view.directory_tree.nodes[LocalTree.Index(*host.view.directory_tree, a)].depth
    marker_x := bounds.x + 8.0 + cast(float32)depth * 18.0 + 6.0 - cast(float32)host.view.tree_horizontal
    if bounds.width <= 0.0 || bounds.x != 240.0 || bounds.x + bounds.width > 410.0 ||
        !Click(host, session, marker_x, bounds.y + 10.0) ||
        host.view.directory_tree.nodes[LocalTree.Index(*host.view.directory_tree, a)].expanded ||
        host.manager.cwd != TextView(nested) || !Render(host, session, true) { return false }
    bounds = DirectoryTreeBounds(session, "alpha\\x0Aé")
    if !Click(host, session, marker_x, bounds.y + 10.0) ||
        !host.view.directory_tree.nodes[LocalTree.Index(*host.view.directory_tree, a)].expanded ||
        host.view.directory_tree.selected != selected || !Render(host, session, true) { return false }
    bounds = DirectoryTreeBounds(session, "alpha\\x0Aé")
    if !Click(host, session, bounds.x + 120.0, bounds.y + 10.0) || host.manager.cwd != TextView(alpha) ||
        !Render(host, session, true) { return false }
    count := host.manager.entries.count
    added: Text = Files.JoinPath(TextView(alpha), "refresh-proof.txt")
    if !Files.ReplaceFile(TextView(added), "fresh") ||
        !Click(host, session, bounds.x + 120.0, bounds.y + 10.0) || host.manager.entries.count != count + 1 { return false }
    loop_id := LocalTree.Find(*host.view.directory_tree, TextView(loop), a)
    host.view.directory_tree.selected = loop_id
    host.view.tree_focused = true
    if !Press(host, session, Keys.KeyRight) || host.view.directory_tree.error.bytes.count == 0 ||
        host.manager.cwd != TextView(alpha) || host.view.directory_tree.nodes[LocalTree.Index(*host.view.directory_tree, loop_id)].expanded { return false }
    host.view.directory_tree.selected = a
    if !Press(host, session, Keys.KeyLeft) || host.view.directory_tree.nodes[LocalTree.Index(*host.view.directory_tree, a)].expanded ||
        !Press(host, session, Keys.KeyRight) || !host.view.directory_tree.nodes[LocalTree.Index(*host.view.directory_tree, a)].expanded { return false }
    host.manager.show_hidden = false
    if !Render(host, session, true) || DirectoryTreeBounds(session, ".hidden").width > 0.0 { return false }
    host.manager.show_hidden = true
    if !Render(host, session, true) || DirectoryTreeBounds(session, ".hidden").width <= 0.0 { return false }
    host.manager.show_hidden = false
    unused Input.KeyboardModifiersSend(session, Keys.KeyModifierControl)
    unused Input.KeyboardSend(session, 66)
    if !Render(host, session, false) || !host.view.tree_mode || !Render(host, session, true) || host.view.tree_mode { return false }
    if !Press(host, session, 69, Keys.KeyModifierControl) || !host.view.tree_mode ||
        !Press(host, session, 69, Keys.KeyModifierControl) || !host.view.tree_mode || !host.sidebar_hidden ||
        !Press(host,session,66,Keys.KeyModifierControl) || host.view.tree_mode || host.sidebar_hidden { return false }
    return true
}

DirectoryTreeDeepFailure :: (host: *App.Host, stage: s32) -> bool {
    print("tree deep stage %: horizontal %/% vertical % selected % error %\n", stage, host.view.tree_horizontal, host.view.tree_horizontal_max, host.view.tree_scroll, host.view.directory_tree.selected, TextView(host.view.directory_tree.error))
    return false
}

DirectoryTreeDeepHostTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    deep: Text = Files.JoinPath(root, "tree-deep")
    if !Files.CreateDirectory(TextView(deep)) { return DirectoryTreeDeepFailure(host, 1) }
    for depth: cast(s32)0..11 {
        next: Text = Files.JoinPath(TextView(deep), "d")
        VecSwap(deep.bytes, next.bytes)
        if !Files.CreateDirectory(TextView(deep)) { return DirectoryTreeDeepFailure(host, 2) }
    }
    target: Text = Files.JoinPath(TextView(deep), "long Unicode folder é with a long label")
    if !Files.CreateDirectory(TextView(target)) || !Model.OpenPathTracked(*host.manager, TextView(target)) { return DirectoryTreeDeepFailure(host, 3) }
    if !Press(host, session, 69, Keys.KeyModifierControl) { return DirectoryTreeDeepFailure(host, 4) }
    if !Render(host, session, true) || !Render(host, session, true) || host.view.tree_horizontal <= 0 ||
        host.view.tree_horizontal_max < host.view.tree_horizontal || !LabelsValid(session) { return DirectoryTreeDeepFailure(host, 5) }
    selected := host.view.directory_tree.selected
    row := DirectoryTreeBounds(session, "long Unicode folder é with a long label")
    if row.width <= 0.0 || row.x < 240.0 || row.x + row.width > 410.0 { return DirectoryTreeDeepFailure(host, 6) }
    original := host.view.tree_horizontal
    // Real app controls change the offset; idle rendering must preserve it.
    if !Click(host, session, 280.0, 695.0) || host.view.tree_horizontal >= original { return DirectoryTreeDeepFailure(host, 7) }
    manual := host.view.tree_horizontal
    if !Render(host, session, true) || host.view.tree_horizontal != manual ||
        !Click(host, session, 360.0, 695.0) || host.view.tree_horizontal <= manual { return DirectoryTreeDeepFailure(host, 8) }
    wheel_before := host.view.tree_horizontal
    vertical_before := host.view.tree_scroll
    unused Input.KeyboardModifiersSend(session, Keys.KeyModifierShift)
    unused Input.PointerWheelSend(session, 280.0, 400.0, 1.0)
    if !Render(host, session, true) || host.view.tree_horizontal >= wheel_before || host.view.tree_scroll != vertical_before { return DirectoryTreeDeepFailure(host, 9) }
    unused Input.KeyboardModifiersSend(session, 0)
    manual = host.view.tree_horizontal
    if !Render(host, session, true) || host.view.tree_horizontal != manual { return DirectoryTreeDeepFailure(host, 10) }
    host.view.tree_focused = true
    if !Press(host, session, Keys.KeyRight) || !host.view.directory_tree.nodes[LocalTree.Index(*host.view.directory_tree, selected)].loaded ||
        host.view.directory_tree.nodes[LocalTree.Index(*host.view.directory_tree, selected)].child_count != 0 ||
        !Press(host, session, Keys.KeyLeft) || host.view.directory_tree.selected == selected ||
        !Press(host, session, Keys.KeyRight) || host.view.directory_tree.selected != selected || host.view.tree_horizontal <= 0 { return DirectoryTreeDeepFailure(host, 11) }
    if !Model.OpenPathTracked(*host.manager, root) || !Render(host, session, true) || host.view.tree_horizontal > 32 { return DirectoryTreeDeepFailure(host, 12) }
    if !Model.OpenPathTracked(*host.manager, TextView(target)) || !Render(host, session, false) ||
        !host.view.tree_reveal || !Render(host, session, true) || host.view.tree_reveal || host.view.tree_horizontal <= 0 {
        return DirectoryTreeDeepFailure(host, 13)
    }
    return Press(host, session, 66, Keys.KeyModifierControl)
}

BookmarkHostTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    host.manager.prompt = .PromptNone
    host.field.focused = false
    first: Text = Files.JoinPath(root, "bookmark-first")
    second: Text = Files.JoinPath(root, "bookmark-second")
    if !Files.CreateDirectories(first) || !Files.CreateDirectories(second) ||
        !Files.CreateDirectories(Files.PathParent(TextView(host.bookmarks.path)), 448) { return false }
    uri: Text = Bookmarks.Encode(TextView(first))
    bytes: Vec(u8)
    if !Bookmarks.Append(*bytes, TextView(uri)) || !Bookmarks.Append(*bytes, " Bookmark α\n") ||
        !Files.ReplaceFile(TextView(host.bookmarks.path), TextView(bytes[:])) ||
        Bookmarks.Refresh(*host.bookmarks) != 1 || !Model.OpenPath(*host.manager, root) { return false }
    host.bookmark_selected = -1
    if !Render(host, session, true) || !LabelsValid(session) { return false }
    bounds := EntryBounds(session, "Bookmark α")
    if bounds.width <= 0.0 || bounds.x < 240.0 ||
        !Click(host, session, bounds.x + 10.0, bounds.y + 10.0) || host.manager.cwd != TextView(first) { return false }
    // Clicking an already-selected shortcut still navigates after moving away.
    if !Model.OpenPath(*host.manager, root) || !Render(host, session, true) ||
        !Click(host, session, bounds.x + 10.0, bounds.y + 10.0) || host.manager.cwd != TextView(first) { return false }
    App.OpenPrompt(host, .PromptBookmarkRename)
    if App.PromptTitle(host) != "Bookmark label" || host.escaped_editor { return false }
    external_uri: Text = Bookmarks.Encode(TextView(second))
    external: Vec(u8)
    if !Bookmarks.Append(*external, TextView(external_uri)) || !Bookmarks.Append(*external, " Changed elsewhere\n") ||
        !Files.ReplaceFile(TextView(host.bookmarks.path), TextView(external[:])) { return false }
    host.field.length = App.CopyInto(host.field.bytes, "Stale label")
    App.FinishPrompt(host)
    if host.manager.prompt != .PromptBookmarkRename || host.bookmarks.document.rows[0].path != TextView(first) ||
        !Render(host, session, true) || !LabelsValid(session) { return false }
    disk: Vec(u8)
    missing: bool
    if !Bookmarks.Read(TextView(host.bookmarks.path), *disk, *missing) || missing ||
        TextView(disk[:]) != TextView(external[:]) { return false }
    host.manager.prompt = .PromptNone
    host.field.focused = false
    host.bookmarks_ms = 0
    if !Render(host, session, true) || host.bookmarks.document.rows[0].path != TextView(second) ||
        !Render(host, session, false) || !LabelsValid(session) { return false }
    return true
}

RawFilenameFailure :: (stage: s32) -> bool { print("raw filename stage % failed
",stage); return false }

RawFilenameHostTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    Preview.Close(*host.preview)
    host.manager.prompt = .PromptNone
    // Ordinary editors retain literal backslashes, including escape lookalikes.
    ordinary: Text = Files.JoinPath(root, "ordinary.txt")
    literal_name := "literal-\\x41-\\\\.txt"
    literal_dir: Text = Files.JoinPath(root, "directory-\\x41-\\\\")
    if !Files.ReplaceFile(ordinary, "ordinary") || !Files.CreateDirectories(literal_dir) ||
        !Model.OpenPath(*host.manager, root) { return RawFilenameFailure(1) }
    for index: cast(s32)0..cast(s32)host.manager.entries.count - 1 {
        if Model.EntryPath(*host.manager, index) == TextView(ordinary) { Model.SelectOne(*host.manager, index) }
    }
    App.OpenPrompt(host, .PromptRename)
    if host.escaped_editor || App.PromptTitle(host) != "New name" { return RawFilenameFailure(2) }
    host.field.length = App.CopyInto(host.field.bytes, literal_name)
    App.FinishPrompt(host)
    if !Files.PathExists(Files.JoinPath(root, literal_name)) { return RawFilenameFailure(3) }
    App.OpenPrompt(host, .PromptLocation)
    if host.escaped_editor || App.PromptTitle(host) != "Location" { return RawFilenameFailure(4) }
    host.field.length = App.CopyInto(host.field.bytes, TextView(literal_dir))
    App.FinishPrompt(host)
    if host.manager.cwd != TextView(literal_dir) { return RawFilenameFailure(5) }
    App.OpenPrompt(host, .PromptLocation)
    if host.escaped_editor || TextView(host.field.bytes[:host.field.length]) != TextView(literal_dir) { return RawFilenameFailure(6) }
    App.FinishPrompt(host)
    if host.manager.cwd != TextView(literal_dir) { return RawFilenameFailure(7) }
    directory_bytes := u8.[68, 45, 128]
    name_bytes := u8.[78, 45, 255, 46, 116, 120, 116]
    image_bytes := u8.[90, 45, 255, 46, 112, 110, 103]
    directory: Text = Files.JoinPath(root, TextView(directory_bytes[:]))
    path: Text = Files.JoinPath(directory, TextView(name_bytes[:]))
    if !Files.CreateDirectories(directory) || !Files.ReplaceFile(path, "preview body") ||
        !Files.ReplaceFile(Files.JoinPath(directory, "N-\\xFF.txt"), "literal") ||
        !Files.ReplaceFile(Files.JoinPath(directory, TextView(image_bytes[:])), "unavailable thumbnail") ||
        !Model.OpenPath(*host.manager, directory) { return RawFilenameFailure(8) }
    raw_index: s32 = -1
    for index: cast(s32)0..cast(s32)host.manager.entries.count - 1 {
        if Model.EntryPath(*host.manager, index) == TextView(path) { raw_index = index }
    }
    if raw_index < 0 { return RawFilenameFailure(9) }
    raw_key := host.manager.entries[raw_index].key
    for mode: cast(s32)0..2 {
        Model.SetView(*host.manager, cast(Model.ViewMode)mode)
        Model.SelectOne(*host.manager, raw_index)
        if !Render(host, session, true) || !LabelsValid(session) ||
            Model.EntryPath(*host.manager, host.manager.cursor) != TextView(path) ||
            host.manager.entries[host.manager.cursor].key != raw_key { return RawFilenameFailure(10) }
        found := false
        for index: cast(s32)0..Tree.TreeCount(session) - 1 {
            if Tree.TreeNodeAt(session, index).semantic_label == "N-\\xFF.txt" { found = true }
        }
        if !found { return RawFilenameFailure(11) }
    }
    App.OpenPrompt(host, .PromptLocation)
    caption: Text = FileDisplay.Caption(TextView(directory))
    if !host.escaped_editor || TextView(host.field.bytes[:host.field.length]) != TextView(caption) ||
        !Render(host, session, true) || !LabelsValid(session) { return RawFilenameFailure(12) }
    App.FinishPrompt(host)
    if host.manager.cwd != TextView(directory) { return RawFilenameFailure(13) }
    App.OpenPrompt(host, .PromptLocation)
    host.field.length = App.CopyInto(host.field.bytes, "\\x00")
    App.FinishPrompt(host)
    if host.manager.prompt != .PromptLocation || host.manager.cwd != TextView(directory) { return RawFilenameFailure(14) }
    host.manager.prompt = .PromptNone
    host.field.focused = false
    Model.SelectOne(*host.manager, raw_index)
    App.OpenPrompt(host, .PromptRename)
    if TextView(host.field.bytes[:host.field.length]) != "N-\\xFF.txt" ||
        !Render(host, session, true) || !LabelsValid(session) { return RawFilenameFailure(15) }
    App.FinishPrompt(host)
    if !Files.PathExists(path) { return RawFilenameFailure(16) }
    App.OpenPrompt(host, .PromptRename)
    host.field.length = App.CopyInto(host.field.bytes, "\\xGG")
    App.FinishPrompt(host)
    if host.manager.prompt != .PromptRename { print("rename prompt after rejected escape % error %\n",cast(s32)host.manager.prompt,host.manager.error); return RawFilenameFailure(17) }
    if !Files.PathExists(path) { return RawFilenameFailure(21) }
    if !Render(host,session,true) { return RawFilenameFailure(22) }
    if !LabelsValid(session) { return RawFilenameFailure(23) }
    host.manager.prompt = .PromptNone
    host.field.focused = false
    for index: cast(s32)0..cast(s32)host.manager.entries.count - 1 {
        if Model.EntryPath(*host.manager, index) == TextView(path) { Model.SelectOne(*host.manager, index) }
    }
    Model.SetError(*host.manager, TextView(path))
    if !Render(host, session, true) || !LabelsValid(session) ||
        !Press(host, session, 80, Keys.KeyModifierControl) || !host.preview.opened ||
        TextView(host.preview.path) != TextView(path) ||
        !Render(host, session, true) || !LabelsValid(session) { return RawFilenameFailure(18) }
    Preview.Close(*host.preview)
    // A legal raw path can exceed the editor capacity after byte escaping.
    component: [200]u8
    for index: cast(s32)0..199 { component[index] = cast(u8)255 }
    long_path: Text = TextCopy(root)
    for depth: cast(s32)0..5 {
        next: Text = Files.JoinPath(long_path, TextView(component[:]))
        VecSwap(long_path.bytes, next.bytes)
    }
    if !Files.CreateDirectories(long_path) || !Model.OpenPath(*host.manager, long_path) { return RawFilenameFailure(19) }
    App.OpenPrompt(host, .PromptLocation)
    if host.manager.prompt != .PromptNone || host.field.focused || host.field.length != 0 ||
        host.manager.cwd != TextView(long_path) || host.manager.error != "Escaped name or path is too long to edit safely" ||
        !Render(host, session, true) || !LabelsValid(session) { return RawFilenameFailure(20) }
    return true
}

ClipboardHostTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    Preview.Close(*host.preview)
    host.manager.prompt = .PromptNone
    source := Files.JoinPath(root, "clipboard-host-source")
    target := Files.JoinPath(root, "clipboard-host-target")
    path := Files.JoinPath(source, "clipboard.txt")
    if !Files.CreateDirectories(source) || !Files.CreateDirectories(target) ||
        !Files.ReplaceFile(path, "host clipboard") || !Model.OpenPath(*host.manager, source) { return false }
    Model.SelectOne(*host.manager, 0)
    if !Press(host, session, 67, Keys.KeyModifierControl) ||
        host.file_clipboard.clipboard.mode != .ClipboardCopy ||
        !Model.OpenPath(*host.manager, target) ||
        !Press(host, session, 86, Keys.KeyModifierControl) ||
        !Files.PathExists(Files.JoinPath(target, "clipboard.txt")) || !Files.PathExists(path) { return false }
    if !Model.OpenPath(*host.manager, source) { return false }
    Model.SelectOne(*host.manager, 0)
    if !Press(host, session, 88, Keys.KeyModifierControl) ||
        host.file_clipboard.clipboard.mode != .ClipboardCut ||
        !Model.OpenPath(*host.manager, target) ||
        !Press(host, session, 86, Keys.KeyModifierControl) || Files.PathExists(path) ||
        host.file_clipboard.clipboard.paths.count != 0 { return false }
    return true
}

Render :: (host: *App.Host, session: Sessions.Session, focused: bool) -> bool {
    viewport := Geometry.Rectangle.{240.0, 120.0, 960.0, 600.0}
    return RenderAt(host, session, focused, viewport)
}

RenderAt :: (host: *App.Host, session: Sessions.Session, focused: bool,
    viewport: Geometry.Rectangle, native_pointer: bool=false) -> bool {
    frame_seconds += 0.017
    pointer:=Input.PointerSample(session)
    if native_pointer {
        Scrolls.BeginScrollFrame(session,.{pointer.x,pointer.y},pointer.pressed,pointer.down,pointer.released,frame_wheel,frame_seconds)
    } else {
        Scrolls.BeginScrollFrame(session, .{480.0, 400.0}, false, false, false, frame_wheel, frame_seconds)
    }
    frame_wheel = 0.0
    Pixmap.PixmapBegin(cast(u32)0xffffffff)
    if cast(s32)Frames.BeginFrame(session, cast(u64)1, viewport) != 0 { return false }
    handle := App.HostSession.{session.slot, session.epoch}
    bounds := App.HostViewport.{viewport.x, viewport.y, viewport.width, viewport.height}
    if App.Draw(host, handle, bounds, focused) != 0 { return false }
    return cast(s32)Frames.EndFrame(session) == 0
}

Press :: (host: *App.Host, session: Sessions.Session, key: s32,
    modifiers: s32 = 0) -> bool {
    unused Input.KeyboardModifiersSend(session, modifiers)
    unused Input.KeyboardSend(session, key)
    return Render(host, session, true)
}

Click :: (host: *App.Host, session: Sessions.Session, x: float32, y: float32,
    modifiers: s32 = 0) -> bool {
    unused Input.KeyboardModifiersSend(session, modifiers)
    unused Input.TreePointerUpdate(session, Input.PointerFrame.{x, y, true, true, false})
    unused Input.TreePointerUpdate(session, Input.PointerFrame.{x, y, false, false, true})
    return Render(host, session, true)
}

DetailsTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    folder := Files.JoinPath(root, "00-folder")
    if !Files.CreateDirectories(folder) { print("details checkpoint 1 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    for index: cast(s32)10..69 {
        name: [16]u8
        if !Files.ReplaceFile(Files.JoinPath(root, Number.FormatInteger(index, name[:])), "data") { print("details checkpoint 2 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    }
    if !Model.OpenPathTracked(*host.manager, root) || !Render(host, session, true) { print("details checkpoint 3 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    Model.SetView(*host.manager, .ViewList)
    if !Render(host, session, true) { print("details checkpoint 4 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    size_seen := false
    type_seen := false
    for index: cast(s32)0..Tree.TreeCount(session) - 1 {
        entry := Tree.TreeNodeAt(session, index)
        if entry.semantic_label == "4 bytes" { size_seen = true }
        if entry.semantic_label == "Plain text document" { type_seen = true }
    }
    if !size_seen || !type_seen { print("details checkpoint 5 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    if !Click(host, session, 470.0, 235.0) || host.manager.cursor != 0 ||
        Model.SelectedCount(*host.manager) != 1 || host.manager.cwd != root { print("details checkpoint 6 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    if !Click(host, session, 470.0, 339.0, Keys.KeyModifierControl) ||
        host.manager.cursor != 2 || Model.SelectedCount(*host.manager) != 2 { print("details checkpoint 7 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    if !Click(host, session, 470.0, 391.0, Keys.KeyModifierShift) ||
        host.manager.cursor != 3 || host.manager.anchor != 2 ||
        Model.SelectedCount(*host.manager) != 2 || !host.manager.selected[2] ||
        !host.manager.selected[3] { print("details checkpoint 8 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    if !Click(host, session, 470.0, 235.0, Keys.KeyModifierControl | Keys.KeyModifierShift) ||
        Model.SelectedCount(*host.manager) != 4 || host.manager.anchor != 2 { print("details checkpoint 9 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    if !Press(host, session, Keys.KeyEnd, Keys.KeyModifierControl) ||
        host.manager.cursor != 60 || Model.SelectedCount(*host.manager) != 4 ||
        host.manager.scroll <= 0 { print("details checkpoint 10 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    if !Press(host, session, 32) || Model.SelectedCount(*host.manager) != 5 ||
        !host.manager.selected[60] { print("details checkpoint 11 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    frame_wheel=2.0
    previous_scroll := host.manager.scroll
    if !Render(host, session, true) || host.manager.scroll >= previous_scroll ||
        host.manager.cursor != 60 { print("details checkpoint 12 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    if !Press(host, session, Keys.KeyHome) || host.manager.cursor != 0 ||
        host.manager.scroll != 0 || Model.SelectedCount(*host.manager) != 1 { print("details checkpoint 13 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    if !Press(host, session, Keys.KeyDown, Keys.KeyModifierShift) ||
        host.manager.anchor != 0 || Model.SelectedCount(*host.manager) != 2 { print("details checkpoint 14 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    selected_path := Model.EntryPath(*host.manager, host.manager.cursor)
    // The Name header changes direction without changing selected identities.
    if !Click(host, session, 470.0, 197.0) || !host.manager.sort_reverse ||
        Model.SelectedCount(*host.manager) != 2 ||
        Model.EntryPath(*host.manager, host.manager.cursor) != selected_path { print("details checkpoint 15 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    // Header dividers resize the same caller-owned widths used next frame.
    before_width:=host.view.column_widths[0]
    edge:=410.0+cast(float32)before_width
    unused Input.TreePointerUpdate(session, Input.PointerFrame.{edge, 197.0, true, true, false})
    unused Input.TreePointerUpdate(session, Input.PointerFrame.{edge+40.0, 197.0, true, false, false})
    if !Render(host, session, true) || host.view.column_widths[0] != before_width+40 { print("details checkpoint 16 cursor % selected % scroll % width %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll,host.view.column_widths[0]); return false }
    unused Input.TreePointerUpdate(session, Input.PointerFrame.{edge+40.0, 197.0, false, false, true})
    if !Render(host, session, true) || !Press(host, session, Keys.KeyHome) ||
        !Press(host, session, Keys.KeyEnter) || host.manager.cwd != folder { print("details checkpoint 17 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    if !Model.NavigateBack(*host.manager) || !Render(host, session, true) { print("details checkpoint 18 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    // First click selects; only a second plain click within the bounded window opens.
    host.view.last_click_ms = 0
    if !Click(host, session, 470.0, 235.0) || host.manager.cwd != root ||
        !Click(host, session, 470.0, 235.0) || host.manager.cwd != folder { print("details checkpoint 19 cursor % selected % scroll %\n",host.manager.cursor,Model.SelectedCount(*host.manager),host.manager.scroll); return false }
    return true
}

EntryBounds :: (session: Sessions.Session, label: string, min_x: float32 = 0.0) -> Geometry.Rectangle {
    for index: cast(s32)0..Tree.TreeCount(session) - 1 {
        node := Tree.TreeNodeAt(session, index)
        if node.semantic_label == label && node.kind == cast(s32)Kinds.WidgetKind.WidgetKindSelectable &&
            node.bounds.x >= min_x {
            return node.bounds
        }
    }
    return .{}
}

ClickEntry :: (host: *App.Host, session: Sessions.Session, row: s32,
    modifiers: s32 = 0) -> bool {
    bounds := EntryBounds(session, Model.EntryName(*host.manager, row))
    if bounds.width <= 0.0 { return false }
    return Click(host, session, bounds.x + bounds.width * 0.5,
        bounds.y + bounds.height * 0.5, modifiers)
}

GridFailure :: (host: *App.Host, checkpoint: s32) -> bool {
    print("grid checkpoint %, mode %, cursor %, anchor %, scroll %, selected %\n",
        checkpoint, cast(s32)host.manager.view_mode, host.manager.cursor,
        host.manager.anchor, host.manager.scroll, Model.SelectedCount(*host.manager))
    return false
}

GridWheel :: (host: *App.Host, session: Sessions.Session, delta: float32) -> bool {
    frame_wheel = delta
    return Render(host, session, true)
}

GridTest :: (host: *App.Host, session: Sessions.Session, root: string,
    mode: Model.ViewMode) -> bool {
    if !Model.OpenPath(*host.manager, root) { return GridFailure(host, 1) }
    Model.SetSort(*host.manager, .SortName, false)
    Model.SetView(*host.manager, mode)
    if !Render(host, session, true) { return GridFailure(host, 2) }
    first := EntryBounds(session, Model.EntryName(*host.manager, 0))
    second := EntryBounds(session, Model.EntryName(*host.manager, 1))
    if first.width <= 0.0 || second.width <= 0.0 { return GridFailure(host, 3) }
    if mode == .ViewIcon && (second.x <= first.x || second.y != first.y) { return GridFailure(host, 4) }
    if mode == .ViewCompact && (second.y <= first.y || second.x != first.x) { return GridFailure(host, 5) }
    // Both layouts render through the canonical Image widget.
    images: s32
    for index: cast(s32)0..Tree.TreeCount(session) - 1 {
        if Tree.TreeNodeAt(session, index).kind == cast(s32)Kinds.WidgetKind.WidgetKindImage { images += 1 }
    }
    if images <= 0 || images >= host.manager.entries.count { return GridFailure(host, 6) }
    host.view.last_click_ms = 0
    if !ClickEntry(host, session, 0) || host.manager.cwd != root ||
        !ClickEntry(host, session, 2, Keys.KeyModifierControl) || Model.SelectedCount(*host.manager) != 2 ||
        !ClickEntry(host, session, 3, Keys.KeyModifierShift) || Model.SelectedCount(*host.manager) != 2 ||
        host.manager.anchor != 2 || !host.manager.selected[2] || !host.manager.selected[3] ||
        !ClickEntry(host, session, 0, Keys.KeyModifierControl | Keys.KeyModifierShift) ||
        Model.SelectedCount(*host.manager) != 4 { return GridFailure(host, 7) }
    if !Press(host, session, Keys.KeyEnd, Keys.KeyModifierControl) ||
        host.manager.cursor != 60 || Model.SelectedCount(*host.manager) != 4 ||
        host.manager.scroll <= 0 || !Press(host, session, 32) ||
        Model.SelectedCount(*host.manager) != 5 { return GridFailure(host, 8) }
    focus_bounds := EntryBounds(session, Model.EntryName(*host.manager, 60))
    if focus_bounds.width <= 0.0 || focus_bounds.x >= 1192.0 || focus_bounds.y >= 688.0 { return GridFailure(host, 9) }
    scroll := host.manager.scroll
    if !GridWheel(host, session, 2.0) || host.manager.scroll >= scroll ||
        host.manager.cursor != 60 { return GridFailure(host, 10) }
    if !Press(host, session, Keys.KeyHome) || host.manager.cursor != 0 ||
        Model.SelectedCount(*host.manager) != 1 || !Press(host, session, Keys.KeyLeft) ||
        !Press(host, session, Keys.KeyUp) || host.manager.cursor != 0 { return GridFailure(host, 11) }
    first = EntryBounds(session, Model.EntryName(*host.manager, 0))
    if !Press(host, session, Keys.KeyRight) { return GridFailure(host, 12) }
    right := EntryBounds(session, Model.EntryName(*host.manager, host.manager.cursor))
    if right.x <= first.x || right.y != first.y {
        print("grid right geometry: first %,%; next %,%\n", first.x, first.y, right.x, right.y)
        return GridFailure(host, 13)
    }
    if !Press(host, session, Keys.KeyHome) || !Press(host, session, Keys.KeyDown) { return GridFailure(host, 14) }
    down := EntryBounds(session, Model.EntryName(*host.manager, host.manager.cursor))
    if down.y <= first.y || down.x != first.x { return GridFailure(host, 15) }
    if !Press(host, session, Keys.KeyEnd) || !Press(host, session, Keys.KeyRight) ||
        !Press(host, session, Keys.KeyDown) || host.manager.cursor != 60 { return GridFailure(host, 16) }
    // Selection and focus survive both directions of each view transition.
    selected_path := Model.EntryPath(*host.manager, host.manager.cursor)
    Model.SetView(*host.manager, .ViewList)
    if !Render(host, session, true) || host.manager.scroll <= 0 { return GridFailure(host, 17) }
    Model.SetView(*host.manager, mode)
    if !Render(host, session, true) || host.manager.scroll <= 0 ||
        Model.EntryPath(*host.manager, host.manager.cursor) != selected_path ||
        Model.SelectedCount(*host.manager) != 1 { return GridFailure(host, 18) }
    Model.SetSort(*host.manager, .SortName, true)
    if !Render(host, session, true) || Model.EntryPath(*host.manager, host.manager.cursor) != selected_path ||
        Model.SelectedCount(*host.manager) != 1 || !host.manager.selected[host.manager.cursor] { return GridFailure(host, 19) }
    // A clipped-out row cannot steal input outside the content viewport.
    count := Model.SelectedCount(*host.manager)
    if !Click(host, session, 1150.0, 130.0) || Model.SelectedCount(*host.manager) != count { return GridFailure(host, 20) }
    if !Press(host, session, Keys.KeyHome) || !Press(host, session, Keys.KeyEnter) ||
        host.manager.cwd != Files.JoinPath(root, "00-folder") { return GridFailure(host, 21) }
    if !Model.NavigateBack(*host.manager) || !Press(host, session, Keys.KeyHome) { return GridFailure(host, 22) }
    host.view.last_click_ms = 0
    if !ClickEntry(host, session, 0) || host.manager.cwd != root ||
        !ClickEntry(host, session, 0) || host.manager.cwd != Files.JoinPath(root, "00-folder") { return GridFailure(host, 23) }
    if !Press(host, session, Keys.KeyHome) || !Press(host, session, Keys.KeyEnd) ||
        !Press(host, session, 32) || !Press(host, session, Keys.KeyEnter) ||
        host.manager.cursor != -1 || host.manager.anchor != -1 ||
        Model.SelectedCount(*host.manager) != 0 { return GridFailure(host, 24) }
    // Passive grid input must not mutate the model or consume the owner's key.
    unused Input.KeyboardSend(session, Keys.KeyEnd)
    if !Render(host, session, false) || Input.KeyboardTake(session) != Keys.KeyEnd { return GridFailure(host, 25) }
    return true
}

ViewportTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    other: App.Host
    if !App.Prepare(*other, root) { return false }
    defer { App.Close(*other) }
    other_session := Sessions.SessionOpen()
    defer { unused Frames.CloseSession(other_session) }
    viewport := Geometry.Rectangle.{1280.0, 720.0, 780.0, 520.0}
    if !RenderAt(*other, other_session, true, viewport) { return false }
    found := false
    index: s32 = 0
    while index < Tree.TreeCount(other_session) {
        node := Tree.TreeNodeAt(other_session, index)
        if node.kind == cast(s32)Kinds.WidgetKind.WidgetKindScroll && node.bounds.x == 1450.0 &&
            node.bounds.y == 809.0 && node.bounds.width == 610.0 { found = true }
        index += 1
    }
    if !found { return false }
    // Input addressed to one session and a passive Host stays with that owner.
    unused Input.KeyboardSend(other_session, 51)
    unused Input.KeyboardModifiersSend(other_session, Keys.KeyModifierControl)
    unused Input.TreePointerUpdate(other_session, Input.PointerFrame.{1480.0, 905.0, true, true, false})
    unused Input.TreePointerUpdate(other_session, Input.PointerFrame.{1480.0, 905.0, false, false, true})
    cursor := other.manager.cursor
    if !RenderAt(*other, other_session, false, viewport) ||
        other.manager.cursor != cursor || Input.KeyboardTake(other_session) != 51 ||
        !Render(host, session, true) { return false }
    unused Input.KeyboardModifiersSend(other_session, 0)
    // Narrow viewports clip content and still produce a valid retained frame.
    if !RenderAt(*other, other_session, true, .{33.0, 55.0, 360.0, 320.0}) { return false }
    if !RenderAt(*other,other_session,true,.{0.0,0.0,3840.0,2160.0}) ||
        other.paint.region_count<1 || other.paint.atlas.count>16777216 { return false }
    App.Close(*other)
    return App.Prepare(*other, root) && RenderAt(*other, other_session, true, viewport)
}

LargeViewTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    Model.ClearEntries(*host.manager)
    for index: cast(s32)0..Model.MAX_ENTRIES + 4 {
        name: [32]u8
        label := Number.FormatInteger(index, name[:])
        if !Model.AppendEntry(*host.manager, label, Files.JoinPath(root, label),
            Files.PathInfo.{.kind = .File, .size = cast(s64)index}) { return false }
    }
    last := cast(s32)host.manager.entries.count - 1
    Model.SelectOne(*host.manager, last)
    for mode: cast(s32)0..2 {
        Model.SetView(*host.manager, cast(Model.ViewMode)mode)
        if !RenderAt(host, session, true, .{33.0, 55.0, 640.0, 480.0}) ||
            host.manager.scroll <= 0 || host.manager.cursor != last ||
            Model.SelectedCount(*host.manager) != 1 || !host.manager.selected[last] ||
            Tree.TreeCount(session) >= 300 { return false }
    }
    return true
}

DrawScoped :: (host: *App.Host, session: Sessions.Session, bounds: Geometry.Rectangle,
    key: u64, focused: bool) -> bool {
    node := BoxWidget.Draw(session, BoxWidget.Props.{.key = key, .bounds = bounds})
    if node < 0 || !Tree.TreePushScope(session, node) { return false }
    defer { Tree.End(session) }
    return App.Draw(host, App.HostSession.{session.slot, session.epoch},
        App.HostViewport.{bounds.x, bounds.y, bounds.width, bounds.height}, focused) == 0
}

Packed :: (color: Color) -> u32 {
    return (cast(u32)color.r << cast(u32)24) | (cast(u32)color.g << cast(u32)16) |
        (cast(u32)color.b << cast(u32)8) | cast(u32)color.a
}

ThemeScopeTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    other: App.Host
    if !App.Prepare(*other, root) { return false }
    defer { App.Close(*other); host.palette_loaded = false }
    light := Palettes.WidgetPalette.{.background = cast(u32)0xf6faf8ff,
        .base = cast(u32)0xe4e9e7ff, .text = cast(u32)0x191c1bff,
        .selected = cast(u32)0x386bafff, .selected_text = cast(u32)0xffffffff,
        .border = cast(u32)0x737d79ff}
    dark := Palettes.WidgetPalette.{.background = cast(u32)0x20242cff,
        .base = cast(u32)0x151922ff, .text = cast(u32)0xeef1f5ff,
        .selected = cast(u32)0x376aafff, .selected_text = cast(u32)0xffffffff,
        .border = cast(u32)0x586274ff}
    fallback := ColorFromPacked(cast(u32)0x765432ff)
    original := Packed(StyleTokenColorOr("canvas", fallback))
    for mode: cast(s32)0..2 {
        Model.SetView(*host.manager, cast(Model.ViewMode)mode)
        Model.SetView(*other.manager, cast(Model.ViewMode)mode)
        host.palette = light
        other.palette = dark
        host.palette_loaded = true
        other.palette_loaded = true
        host.palette_ms = DateTime.UnixMilliseconds()
        other.palette_ms = host.palette_ms
        if !Pixmap.PixmapBeginInto(cast(u32)0xffffffff, 960, 600, theme_pixels[:]) ||
            cast(s32)Frames.BeginFrame(session, cast(u64)1, .{0.0, 0.0, 960.0, 600.0}) != 0 ||
            !Palettes.WidgetPaletteUse(session, dark) { return false }
        if !DrawScoped(host, session, .{8.0, 8.0, 440.0, 400.0}, cast(u64)720, false) ||
            Packed(StyleTokenColorOr("canvas", fallback)) != dark.background ||
            Packed(StyleTokenColorOr("text", fallback)) != dark.text ||
            !DrawScoped(*other, session, .{480.0, 100.0, 440.0, 400.0}, cast(u64)721, true) ||
            Packed(StyleTokenColorOr("canvas", fallback)) != dark.background {
            unused Palettes.WidgetPaletteRestore(session)
            return false
        }
        if !Palettes.WidgetPaletteRestore(session) ||
            Packed(StyleTokenColorOr("canvas", fallback)) != original ||
            cast(s32)Frames.EndFrame(session) != 0 { return false }
        if (theme_pixels[9 * 960 + 9] & cast(u32)0xffffff) != (light.background >> cast(u32)8) ||
            (theme_pixels[101 * 960 + 481] & cast(u32)0xffffff) != (dark.background >> cast(u32)8) ||
            (theme_pixels[0] & cast(u32)0xffffff) != cast(u32)0xffffff { return false }
    }
    return true
}

SharedFrameTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    other: App.Host
    if !App.Prepare(*other, root) { return false }
    defer { App.Close(*other) }
    Model.SetView(*host.manager, .ViewList)
    Model.SetView(*other.manager, .ViewIcon)
    unused Input.KeyboardModifiersSend(session, Keys.KeyModifierControl)
    unused Input.KeyboardSend(session, 51)
    Pixmap.PixmapBegin(cast(u32)0xffffffff)
    if cast(s32)Frames.BeginFrame(session, cast(u64)1, .{0.0, 0.0, 2400.0, 1200.0}) != 0 ||
        !DrawScoped(host, session, .{40.0, 60.0, 960.0, 600.0}, cast(u64)700, false) ||
        !DrawScoped(*other, session, .{1100.0, 500.0, 960.0, 600.0}, cast(u64)701, true) ||
        cast(s32)Frames.EndFrame(session) != 0 { return false }
    unused Input.KeyboardModifiersSend(session, 0)
    return host.manager.view_mode == .ViewList && other.manager.view_mode == .ViewCompact &&
        other.manager.tabs.count == 1 && host.manager.tabs.count == 2
}

SharedGridFrame :: (left: *App.Host, right: *App.Host, session: Sessions.Session,
    wheel: float32, right_key: s32) -> bool {
    frame_seconds += 0.017
    Scrolls.BeginScrollFrame(session, .{480.0, 300.0}, false, false, false, wheel, frame_seconds)
    Pixmap.PixmapBegin(cast(u32)0xffffffff)
    if cast(s32)Frames.BeginFrame(session, cast(u64)1, .{0.0, 0.0, 1800.0, 600.0}) != 0 ||
        !DrawScoped(left, session, .{40.0, 60.0, 700.0, 440.0}, cast(u64)710, true) { return false }
    // Deliver navigation to the second Host after the first draws; both grids
    // remain active; navigation must leave the first's immediate wheel offset alone.
    if right_key != 0 { unused Input.KeyboardSend(session, right_key) }
    if !DrawScoped(right, session, .{900.0, 60.0, 700.0, 440.0}, cast(u64)711, true) ||
        cast(s32)Frames.EndFrame(session) != 0 { return false }
    return true
}

SharedGridMotionTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    other: App.Host
    if !App.Prepare(*other, root) || !Model.OpenPath(*host.manager, root) { return false }
    defer { App.Close(*other) }
    Model.SetView(*host.manager, .ViewIcon)
    Model.SetView(*other.manager, .ViewCompact)
    unused Input.KeyboardModifiersSend(session, 0)
    if !SharedGridFrame(host, *other, session, 0.0, 0) ||
        !SharedGridFrame(host, *other, session, -1.0, Keys.KeyEnd) ||
        host.manager.scroll <= 0 || other.manager.cursor != 60 ||
        other.manager.scroll <= 0 || Scrolls.ScrollDeviceMoving(session) {
        print("shared grid wheel left %, right cursor % scroll %, moving %\n",
            host.manager.scroll, other.manager.cursor, other.manager.scroll, Scrolls.ScrollDeviceMoving(session))
        return false
    }
    left_offset := host.manager.scroll
    if !SharedGridFrame(host, *other, session, 0.0, Keys.KeyHome) ||
        host.manager.scroll != left_offset || other.manager.cursor != 0 ||
        other.manager.scroll < 0 || other.manager.scroll > 6 || Scrolls.ScrollDeviceMoving(session) {
        print("shared grid Home left % -> %, right cursor % scroll %, moving %\n",
            left_offset, host.manager.scroll, other.manager.cursor, other.manager.scroll, Scrolls.ScrollDeviceMoving(session))
        return false
    }
    left_offset = host.manager.scroll
    right_offset := other.manager.scroll
    first := EntryBounds(session, Model.EntryName(*other.manager, 0), 1070.0)
    if first.width <= 0.0 || first.x < 1070.0 || first.x + first.width > 1600.0 ||
        first.y < 125.0 || first.y + first.height > 472.0 { return false }
    if !SharedGridFrame(host, *other, session, 0.0, 0) ||
        host.manager.scroll != left_offset || other.manager.scroll != right_offset {
        print("shared grid coast left % -> %, right %\n", left_offset, host.manager.scroll, other.manager.scroll)
        return false
    }
    return true
}

PreviewHostTest :: (host: *App.Host, session: Sessions.Session, root: string) -> bool {
    folder := Files.JoinPath(root, "preview-host")
    first_path := Files.JoinPath(folder, "01-image.png")
    second_path := Files.JoinPath(folder, "02-image.JPG")
    text_path := Files.JoinPath(folder, "03-notes.txt")
    if !Files.CreateDirectories(folder) || !Files.ReplaceFile(first_path, "fixture") ||
        !Files.ReplaceFile(second_path, "fixture") { return false }
    notes: Vec(u8)
    for row: cast(s32)0..199 { BuilderPrint(*notes, "preview line %\n", row) }
    if !Files.ReplaceFile(text_path, TextView(notes[:])) { return false }
    pixels: [12288]u32
    for * pixel: pixels { pixel.* = cast(u32)0xff2255aa }
    if !Pixmap.PixmapSetImage(0, first_path, 128, 96, pixels[:]) ||
        !Pixmap.PixmapSetImage(1, second_path, 128, 96, pixels[:]) { return false }
    if !Model.OpenPath(*host.manager, folder) { return false }
    Model.SetSort(*host.manager, .SortName, false)
    Model.SetView(*host.manager, .ViewIcon)
    if !Press(host, session, Keys.KeyHome) || !Press(host, session, Keys.KeyEnter) ||
        !host.preview.opened || host.preview.kind != .Image ||
        TextView(host.preview.path) != first_path || !Render(host, session, true) { return false }
    // Zoomed source cropping stays inside the image and inside this nonzero viewport.
    host.preview.zoom = 800
    if !Press(host, session, Keys.KeyRight) || host.preview.pan_x <= 0.0 ||
        !Press(host, session, Keys.KeyDown) || host.preview.pan_y <= 0.0 { return false }
    found := false
    for row: cast(s32)0..Tree.TreeCount(session) - 1 {
        node := Tree.TreeNodeAt(session, row)
        if node.kind == cast(s32)Kinds.WidgetKind.WidgetKindImage {
            found = true
            if node.bounds.x < 248.0 || node.bounds.y < 200.0 ||
                node.bounds.x + node.bounds.width > 1192.0 ||
                node.bounds.y + node.bounds.height > 658.0 { return false }
        }
    }
    if !found || !Press(host, session, Keys.KeyHome) || host.preview.zoom != 0 ||
        !Press(host, session, Keys.KeyPageDown) || TextView(host.preview.path) != second_path ||
        host.manager.cursor != 1 || Model.SelectedCount(*host.manager) != 1 { return false }
    // Unfocused preview leaves queued navigation for the actual input owner.
    unused Input.KeyboardSend(session, Keys.KeyEscape)
    if !Render(host, session, false) || !host.preview.opened ||
        Input.KeyboardTake(session) != Keys.KeyEscape { return false }
    if !Press(host, session, Keys.KeyEscape) || host.preview.opened ||
        !Render(host, session, true) { return false }
    Model.SelectOne(*host.manager, 2)
    if !Press(host, session, 80, Keys.KeyModifierControl) || host.preview.kind != .Text ||
        !Press(host, session, Keys.KeyEnd) || host.preview.text_scroll <= 0 { return false }
    if !Press(host, session, Keys.KeyHome) || host.preview.text_scroll != 0 ||
        !Press(host, session, Keys.KeyEscape) || host.preview.opened { return false }
    // Close must also clean up a preview left open by the embedding host.
    Preview.Open(*host.preview, text_path)
    return host.preview.path.bytes.count > 0 && host.preview.body.bytes.count > 0
}

#program_export
TabHostFailure :: (stage: s32) -> bool { print("tab host stage % failed\n", stage); return false }
TabNode :: (session: Sessions.Session, key: u64) -> s32 {
    for index: cast(s32)0..Tree.TreeCount(session) - 1 {
        node := Tree.TreeNodeAt(session, index)
        if node.key == key && node.semantic_kind == .SemanticTab { return index }
    }
    return -1
}
TabsHostTest :: (root: string) -> bool {
    folder: Text = Files.JoinPath(root, "tab-host")
    if !Files.CreateDirectories(folder) || !Files.ReplaceFile(Files.JoinPath(folder, "proof"), "owned") { return TabHostFailure(1) }
    host: App.Host
    if !App.Prepare(*host, folder) { return TabHostFailure(2) }
    defer { App.Close(*host) }
    session := Sessions.SessionOpen()
    if !Sessions.SessionValid(session) { return TabHostFailure(3) }
    defer { unused Frames.CloseSession(session) }
    for index: cast(s32)0..15 { if !Model.NewTab(*host.manager) { return TabHostFailure(4) } }
    if !Render(*host, session, true) || host.view.tab_scroll <= 0 { return TabHostFailure(5) }
    last := Model.TabKey(*host.manager, host.manager.active_tab)
    node := TabNode(session, last)
    if node < 0 { return TabHostFailure(601) }
    if !Input.TreeFocusAt(session, node) { return TabHostFailure(602) }
    if !Press(*host, session, Keys.KeyHome) || host.manager.active_tab != 0 { return TabHostFailure(603) }
    if !Press(*host, session, Keys.KeyEnd) ||
        Model.TabKey(*host.manager, host.manager.active_tab) != last { return TabHostFailure(604) }
    before := host.manager.active_tab
    if !Press(*host, session, Keys.KeyPageUp, Keys.KeyModifierControl | Keys.KeyModifierShift) ||
        host.manager.active_tab != before - 1 || Model.TabKey(*host.manager, host.manager.active_tab) != last { return TabHostFailure(7) }
    if !Press(*host, session, Keys.KeyTab, Keys.KeyModifierControl) ||
        !Press(*host, session, Keys.KeyTab, Keys.KeyModifierControl | Keys.KeyModifierShift) ||
        Model.TabKey(*host.manager, host.manager.active_tab) != last { return TabHostFailure(8) }
    if !Model.SwitchTab(*host.manager, 0) || !Render(*host, session, true) || !Render(*host, session, true) { return TabHostFailure(9) }
    first := Model.TabKey(*host.manager, 0)
    node = TabNode(session, first)
    if node < 0 { return TabHostFailure(10) }
    bounds := Tree.TreeNodeAt(session, node).bounds
    x := bounds.x + 20.0; y := bounds.y + 16.0
    unused Input.KeyboardModifiersSend(session, 0)
    unused Input.TreePointerUpdate(session, Input.PointerFrame.{x, y, true, true, false})
    if !Render(*host, session, true) { return TabHostFailure(11) }
    unused Input.TreePointerUpdate(session, Input.PointerFrame.{x + 220.0, y, true, false, false})
    if !Render(*host, session, true) { return TabHostFailure(12) }
    unused Input.TreePointerUpdate(session, Input.PointerFrame.{x + 220.0, y, false, false, true})
    if !Render(*host, session, true) || Model.TabIndex(*host.manager, first) <= 0 ||
        Model.TabKey(*host.manager, host.manager.active_tab) != first { return TabHostFailure(13) }
    before = host.manager.active_tab
    if !Press(*host, session, 76, Keys.KeyModifierControl) ||
        !Press(*host, session, Keys.KeyTab, Keys.KeyModifierControl) ||
        host.manager.active_tab != before || host.manager.prompt != .PromptLocation ||
        !Press(*host, session, Keys.KeyEscape) { return TabHostFailure(14) }
    unused Input.KeyboardModifiersSend(session, Keys.KeyModifierControl)
    unused Input.KeyboardSend(session, Keys.KeyTab)
    if !Render(*host, session, false) || host.manager.active_tab != before ||
        Input.KeyboardTake(session) != Keys.KeyTab { return TabHostFailure(15) }
    unused Input.KeyboardModifiersSend(session, 0)
    if !RenderAt(*host, session, true, .{40.0, 60.0, 560.0, 440.0}) || !LabelsValid(session) { return TabHostFailure(16) }
    count := host.manager.tabs.count
    if !Press(*host, session, 87, Keys.KeyModifierControl) || host.manager.tabs.count != count - 1 { return TabHostFailure(17) }
    return true
}

InteractionFailure :: (stage: s32) -> bool { print("interaction stage % failed\n",stage); return false }

InteractionHostTest :: (session: Sessions.Session, root: string) -> bool {
    folder:=Files.JoinPath(root,"interactions")
    child:=Files.JoinPath(folder,"child")
    file:=Files.JoinPath(folder,"delete.txt")
    if !Files.CreateDirectories(child) || !Files.ReplaceFile(file,"retain on cancel") { return InteractionFailure(1) }
    host: App.Host
    if !App.Prepare(*host,folder) { return InteractionFailure(2) }
    defer App.Close(*host)
    if !Render(*host,session,true) || !Press(*host,session,299) || !host.actions_open || host.menu_index!=1 { return InteractionFailure(3) }
    point:=Geometry.Vector2.{245.0+NativeUI.MenuOffset(1),125.0}
    unused Input.TreePointerUpdate(session,Input.PointerFrame.{point.x,point.y,false,false,false})
    if !Render(*host,session,true) || host.menu_index!=2 || !host.actions_open { return InteractionFailure(4) }
    if !Press(*host,session,Keys.KeyRight) || host.menu_index!=3 || !Press(*host,session,Keys.KeyLeft) || host.menu_index!=2 { return InteractionFailure(5) }
    if !Press(*host,session,Keys.KeyEnd) || host.menu_cursor!=9 || !Press(*host,session,Keys.KeyHome) || host.menu_cursor!=0 { return InteractionFailure(6) }
    if !Press(*host,session,Keys.KeyEscape) || host.actions_open { return InteractionFailure(7) }
    if !Press(*host,session,70,Keys.KeyModifierAlt) || host.menu_index!=1 || !Press(*host,session,Keys.KeyEscape) { return InteractionFailure(8) }
    if !Press(*host,session,72,Keys.KeyModifierControl) || !host.manager.show_hidden || !Press(*host,session,72,Keys.KeyModifierControl) || host.manager.show_hidden { return InteractionFailure(9) }
    if !Press(*host,session,66,Keys.KeyModifierControl) || !host.sidebar_hidden || !Press(*host,session,298) || host.sidebar_hidden { return InteractionFailure(10) }
    if !Press(*host,session,69,Keys.KeyModifierControl) || host.sidebar_hidden || !host.view.tree_mode ||
        !Press(*host,session,69,Keys.KeyModifierControl) || !host.sidebar_hidden || !host.view.tree_mode ||
        !Press(*host,session,69,Keys.KeyModifierControl) || host.sidebar_hidden ||
        !Press(*host,session,66,Keys.KeyModifierControl) || host.sidebar_hidden || host.view.tree_mode { return InteractionFailure(35) }
    Model.SelectOne(*host.manager,0)
    if !Press(*host,session,68,Keys.KeyModifierControl) { return InteractionFailure(36) }
    child_bookmarked: bool; folder_bookmarked: bool
    bookmark_index: s64
    while bookmark_index<host.bookmarks.document.rows.count {
        if host.bookmarks.document.rows[bookmark_index].path==child { child_bookmarked=true }
        if host.bookmarks.document.rows[bookmark_index].path==folder { folder_bookmarked=true }
        bookmark_index+=1
    }
    if !child_bookmarked || folder_bookmarked { return InteractionFailure(37) }
    Model.ClearSelection(*host.manager)
    if !Press(*host,session,68,Keys.KeyModifierControl) { return InteractionFailure(38) }
    bookmark_index=0
    while bookmark_index<host.bookmarks.document.rows.count {
        if host.bookmarks.document.rows[bookmark_index].path==folder { folder_bookmarked=true }
        bookmark_index+=1
    }
    if !folder_bookmarked { return InteractionFailure(39) }
    if !Press(*host,session,77,Keys.KeyModifierControl) || !host.menubar_hidden || !Press(*host,session,299) || host.menubar_hidden || !Press(*host,session,Keys.KeyEscape) { return InteractionFailure(11) }
    if !Press(*host,session,61,Keys.KeyModifierControl+Keys.KeyModifierShift) || host.view.zoom[cast(s32)host.manager.view_mode]!=4 ||
        !Press(*host,session,333,Keys.KeyModifierControl) || host.view.zoom[cast(s32)host.manager.view_mode]!=3 ||
        !Press(*host,session,334,Keys.KeyModifierControl) || !Press(*host,session,320,Keys.KeyModifierControl) || host.view.zoom[cast(s32)host.manager.view_mode]!=3 { return InteractionFailure(12) }
    Model.SelectOne(*host.manager,0)
    if !Press(*host,session,80,Keys.KeyModifierControl+Keys.KeyModifierShift) || host.manager.tabs.count!=2 || host.preview.opened || host.manager.cwd!=child { return InteractionFailure(13) }
    if !Press(*host,session,87,Keys.KeyModifierControl) || host.manager.cwd!=folder { return InteractionFailure(14) }
    if !Press(*host,session,290) || !host.info_open || !Press(*host,session,Keys.KeyDelete) || !Files.PathExists(file) || !Press(*host,session,Keys.KeyEscape) || host.info_open { return InteractionFailure(15) }
    if !Press(*host,session,Keys.KeyEnter,Keys.KeyModifierAlt) || !host.info_open || !Press(*host,session,Keys.KeyEnter) || host.info_open { return InteractionFailure(16) }
    if !Model.OpenPathTracked(*host.manager,child) || !Press(*host,session,Keys.KeyBackspace) || host.manager.cwd!=folder { return InteractionFailure(17) }
    if !Press(*host,session,Keys.KeyRight,Keys.KeyModifierAlt) || host.manager.cwd!=child || !Press(*host,session,Keys.KeyUp,Keys.KeyModifierAlt) || host.manager.cwd!=folder { return InteractionFailure(18) }
    Model.SelectOne(*host.manager,1)
    if !Press(*host,session,297) || !Files.PathExists(file) || Model.SelectedCount(*host.manager)!=1 { return InteractionFailure(40) }
    if !Press(*host,session,Keys.KeyDelete,Keys.KeyModifierShift) || host.manager.prompt!=.PromptDelete || !Files.PathExists(file) { return InteractionFailure(19) }
    if !Press(*host,session,Keys.KeyEscape) || !Files.PathExists(file) || Model.SelectedCount(*host.manager)!=1 { return InteractionFailure(20) }
    if !Press(*host,session,291) || host.manager.prompt!=.PromptRename || !Press(*host,session,Keys.KeyDelete) || !Files.PathExists(file) || TextView(host.field.bytes[:host.field.length])!=".txt" { return InteractionFailure(21) }
    if !Press(*host,session,Keys.KeyEscape) || !Press(*host,session,Keys.KeyDelete,Keys.KeyModifierShift) || !Press(*host,session,Keys.KeyEnter) || Files.PathExists(file) { return InteractionFailure(22) }
    if !Files.ReplaceFile(file,"trash fixture") || !Model.Refresh(*host.manager) { return InteractionFailure(23) }
    Model.SelectOne(*host.manager,1)
    if !Press(*host,session,Keys.KeyDelete) || Files.PathExists(file) { return InteractionFailure(24) }
    if !Files.ReplaceFile(file,"first inode") || !Model.Refresh(*host.manager) { return InteractionFailure(25) }
    Model.SelectOne(*host.manager,1)
    if !Press(*host,session,Keys.KeyDelete,Keys.KeyModifierShift) { return InteractionFailure(26) }
    // Keep the old inode alive so the replacement cannot reuse it.
    if !Model.RenamePath(file,Files.JoinPath(folder,"old.txt")) || !Files.ReplaceFile(file,"replacement") { return InteractionFailure(27) }
    if !Press(*host,session,Keys.KeyEnter) || !Files.PathExists(file) || host.manager.error=="" { return InteractionFailure(28) }
    history:=Files.JoinPath(folder,"history-folder")
    retained:=Files.JoinPath(history,"retained.txt")
    if !Model.CreateFolder(*host.manager,"history-folder") || !Files.ReplaceFile(retained,"retained bytes") ||
        !Press(*host,session,90,Keys.KeyModifierControl) || Files.PathExists(history) ||
        !Press(*host,session,90,Keys.KeyModifierControl+Keys.KeyModifierShift) || !Files.PathExists(retained) { return InteractionFailure(29) }
    if !Press(*host,session,65,Keys.KeyModifierControl) || Model.SelectedCount(*host.manager)!=host.manager.entries.count ||
        !Press(*host,session,73,Keys.KeyModifierControl+Keys.KeyModifierShift) || Model.SelectedCount(*host.manager)!=0 { return InteractionFailure(30) }
    if !Press(*host,session,84,Keys.KeyModifierControl) || !Press(*host,session,Keys.KeyPageUp,Keys.KeyModifierControl) || host.manager.active_tab!=0 ||
        !Press(*host,session,Keys.KeyPageUp,Keys.KeyModifierControl) || host.manager.active_tab!=1 ||
        !Press(*host,session,Keys.KeyTab,Keys.KeyModifierControl+Keys.KeyModifierShift) || host.manager.active_tab!=0 { return InteractionFailure(31) }
    if !Model.OpenPathTracked(*host.manager,Model.HomePath()) || !Render(*host,session,true) { return InteractionFailure(32) }
    Model.SelectOne(*host.manager,0)
    if !Render(*host,session,true) { return InteractionFailure(33) }
    home_bounds: Geometry.Rectangle
    for n: cast(s32)0..Tree.TreeCount(session)-1 {
        node:=Tree.TreeNodeAt(session,n)
        if node.focus_id==31 { home_bounds=node.bounds }
    }
    if home_bounds.width<=0 || !Click(*host,session,home_bounds.x+20.0,home_bounds.y+home_bounds.height*0.5) ||
        !host.location_without_slash || Model.SelectedCount(*host.manager)!=0 { return InteractionFailure(34) }
    print("Explorer interaction local tests: menu hover/arrows/mnemonics, hidden/sidebar/history keys, Delete, editor focus, permanent confirmation/cancel/replacement protection passed\n")
    return true
}

DeferredColumnsTest :: (host: *App.Host, session: Sessions.Session) -> bool {
    Model.SetView(*host.manager,.ViewList)
    host.view.columns_signature=0; host.view.columns_resized=false
    bounds:=Geometry.Rectangle.{0.0,0.0,780.0,400.0}
    if !RenderAt(host,session,true,bounds) || !host.view.columns_pending { return false }
    if !RenderAt(host,session,true,bounds) || host.view.columns_pending { return false }
    // A full native batch remains the reference, including offscreen names.
    values: Vec(string)
    for entry: host.manager.entries { if !VecPush(values,entry.caption) { return false } }
    nodes:=NativeUI.Nodes("treeview")
    expected:=Gtk.GtkCellTextMeasureMany(nodes[:],values[:],60,true)
    expected_width:=expected.minimum_width+cast(s32)NativeUI.DetailsIconSize()+Gtk.GtkStyleQuery(nodes[:],1).horizontal_separator+2
    return expected.available && host.view.name_minimum>=expected_width
}

main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 2 && argc != 3 { return 64 }
    root := Bytes.TextFromCString(argv[1])
    unused Files.RemoveTree(root)
    if !Files.CreateDirectories(root, 448) ||
        !Files.CreateDirectories(Files.JoinPath(root, "config"), 448) ||
        !Files.CreateDirectories(Files.JoinPath(root, "data-home"), 448) { return 65 }
    if !Files.ReplaceFile(Files.JoinPath(root, "fixture.txt"), "fixture") { return 66 }
    if argc==3 {
        if Bytes.TextFromCString(argv[2])!="--native-large" { return 64 }
        for row: cast(s32)0..39 {
            text: Vec(u8); BuilderPrint(*text,"File % — Café.txt",row)
            if !Files.ReplaceFile(Files.JoinPath(root,TextView(text[:])),"native") { return 67 }
        }
    }
    host: App.Host
    if !App.Prepare(*host, root) { return 1 }
    defer { App.Close(*host) }
    session := Sessions.SessionOpen()
    if !Sessions.SessionValid(session) { return 2 }
    defer { unused Frames.CloseSession(session) }
    if argc==3 {
        if !DeferredColumnsTest(*host,session) { return 74 }
        if !UndershootTest(session) { return 72 }
        if !NativeScrollViewsTest(*host,session) { return 73 }
        nodes: [1]Gtk.GtkStyleNode=.[.{.widget_type="GtkWindow",.element="window"}]
        if !Gtk.GtkStyleQuery(nodes[:],1).available { return 68 }
        for mode: cast(s32)0..2 {
            Model.SetView(*host.manager,cast(Model.ViewMode)mode)
            if !RenderAt(*host,session,true,.{0.0,0.0,3840.0,2160.0}) || host.paint.region_count<2 ||
                host.paint.atlas.count>16777216 || host.paint.texture.id==0 || !LabelsValid(session) { return 69 }
            if !RenderAt(*host,session,true,.{33.0,55.0,780.0,520.0}) || host.paint.region_count!=0 { return 70 }
        }
        if !App.ToggleSplit(*host) || !RenderAt(*host,session,true,.{0.0,0.0,3840.0,2160.0}) ||
            host.paint.region_count<2 { return 71 }
        print("Explorer native GTK: all three views, split panes, full 4K composition and resize passed\n")
        return 0
    }
    if !Render(*host, session, true) { return 3 }
    found := false
    index: s32 = 0
    while index < Tree.TreeCount(session) {
        entry := Tree.TreeNodeAt(session, index)
        if entry.key == cast(u64)1 && entry.bounds.x == 243.0 && entry.bounds.y == 150.0 && entry.bounds.width == 35.0 {
            found = true
        }
        index += 1
    }
    if !found { print("host viewport origin failed\n"); return 4 }
    if !ThemeScopeTest(*host, session, root) { print("system palette viewport/scope isolation failed\n"); return 31 }

    if !TabsHostTest(root) { print("native TabBar focus/overflow/drag/close/modal/embedded regression failed\n"); return 42 }
    if !DetailsTest(*host, session, Files.JoinPath(root, "views")) {
        print("details selection/navigation/metadata sort/activation failed\n"); return 20
    }
    if !GridTest(*host, session, Files.JoinPath(root, "views"), .ViewIcon) {
        print("Icon grid behavior failed\n"); return 23
    }
    if !GridTest(*host, session, Files.JoinPath(root, "views"), .ViewCompact) {
        print("Compact grid behavior failed\n"); return 24
    }
    if !Model.OpenPath(*host.manager, root) || !Render(*host, session, true) { return 21 }
    if !ViewportTest(*host, session, root) { print("multiple viewport isolation failed\n"); return 22 }

    // Passive embedded windows must leave all queued input for their owner.
    unused Input.KeyboardSend(session, 84)
    unused Input.KeyboardModifiersSend(session, Keys.KeyModifierControl)
    unused Input.TypedCodepointSend(session, #char "x")
    unused Input.PointerWheelSend(session, 450.0, 320.0, -2.0)
    if !Render(*host, session, false) || host.manager.tabs.count != 1 ||
        Input.KeyboardTake(session) != 84 || Input.TypedCodepointTake(session) != #char "x" ||
        Input.PointerWheelTake(session, Geometry.Rectangle.{240.0, 120.0, 960.0, 600.0}) != -2.0 {
        print("passive host consumed input\n"); return 5
    }
    unused Input.KeyboardSend(session, 84)
    if !Render(*host, session, true) || host.manager.tabs.count != 2 ||
        !Render(*host, session, true) {
        print("host tab frame failed\n"); return 6
    }

    App.OpenPrompt(*host, .PromptFile)
    unused Input.KeyboardModifiersSend(session, 0)
    if !Render(*host, session, false) || !host.field.focused { return 7 }
    if !Render(*host, session, true) || !Render(*host, session, true) { return 9 }
    unused Input.TypedCodepointSend(session, #char "x")
    if !Render(*host, session, true) || host.field.length != 1 { return 10 }
    unused Input.KeyboardSend(session, Keys.KeyEnter)
    if !Render(*host, session, true) || !Files.PathExists(Files.JoinPath(root, "x")) { return 11 }
    if !SharedFrameTest(*host, session, root) { print("shared frame viewport/focus isolation failed\n"); return 28 }
    if !SharedGridMotionTest(*host, session, Files.JoinPath(root, "views")) {
        print("shared Host grid momentum isolation failed\n"); return 29
    }
    if !LargeViewTest(*host, session, root) { print("large view storage/reveal failed\n"); return 25 }
    if !PreviewHostTest(*host, session, root) { print("preview image/text/input/viewport behavior failed\n"); return 30 }
    if !ClipboardHostTest(*host, session, root) { print("headless file clipboard shortcuts failed\n"); return 32 }
    if !RawFilenameHostTest(*host, session, root) { print("raw filename host labels/prompts/identity failed\n"); return 33 }
    if !BookmarkHostTest(*host, session, root) { print("bookmark host activation/snapshot/refresh failed\n"); return 34 }
    if !DirectoryTreeHostTest(*host, session, root) { print("tree host toggle/reveal/disclosure/repeat/hidden/cycle/focus failed\n"); return 35 }
    if !DirectoryTreeDeepHostTest(*host, session, root) { print("tree deep programmatic/keyboard reveal/manual horizontal control failed\n"); return 36 }
    if !BreadcrumbHostTest(*host, session, root) { print("breadcrumb host repeat/overflow/raw activation failed\n"); return 38 }
    if !LocationHostTest(*host, session, root) { return 37 }
    if !InteractionHostTest(session,root) { print("interaction shortcut/menu/confirmation regression failed\n"); return 74 }
    App.Close(*host)
    if host.manager.entry_text.count != 0 || host.manager.cwd_text.bytes.count != 0 ||
        host.file_clipboard.clipboard.text.count != 0 || host.view.details_cells.count != 0 ||
        host.view.details_rows.count != 0 || host.view.grid_items.count != 0 ||
        host.view.last_click_path.bytes.count != 0 || host.preview.opened ||
        host.preview.path.bytes.count != 0 || host.preview.body.bytes.count != 0 ||
        host.bookmarks.document.storage.count != 0 || host.bookmarks.document.rows.count != 0 ||
        host.bookmarks.document.text.bytes.count != 0 || host.bookmark_items.count != 0 || host.bookmark_flags.count != 0 ||
        host.view.directory_tree.nodes.count != 0 || host.view.directory_tree.order.count != 0 ||
        host.view.tree_items.count != 0 || host.view.tree_rows.count != 0 || host.view.tree_attempt.bytes.count != 0 || host.view.tree_mode ||
        host.view.tree_horizontal != 0 || host.view.tree_horizontal_max != 0 ||
        host.location.candidates.count != 0 || host.location.order.count != 0 || host.location.base.bytes.count != 0 ||
        host.ancestors.rows.count != 0 || host.ancestors.path.bytes.count != 0 || host.breadcrumb_items.count != 0 ||
        host.completion_items.count != 0 || host.completion_flags.count != 0 || host.palette_loaded { return 12 }
    if host.started || !App.Prepare(*host, root) || host.manager.tabs.count != 1 ||
        host.manager.prompt != .PromptNone || host.field.length != 0 { return 8 }
    for mode: cast(s32)0..2 {
        Model.SetView(*host.manager, cast(Model.ViewMode)mode)
        if !Render(*host, session, true) { return 26 }
        App.Close(*host)
        if !App.Prepare(*host, root) { return 27 }
    }
    print("Explorer three-view host selection, sorting, layout, clipping, viewport, input, storage and reopen local tests passed\n")
    return 0
}
